# Copy this file to .env.dev (docker-compose.dev-local.yml) or .env.prod
# (docker-compose.prod-local.yml) and fill in real values. .env.* is git-ignored.

# --- Database --------------------------------------------------------------
# The compose files start no database container: point this at a SQL Server
# reachable from inside the containers. On Docker Desktop the host machine is
# "host.docker.internal". MultipleActiveResultSets=True is required by the app.
ConnectionStrings__DefaultConnection=Server=host.docker.internal,1433;Database=Mikpunt;User Id=dockeruser;Password=Password123;TrustServerCertificate=True;MultipleActiveResultSets=True;

# --- ASP.NET ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# --- JWT signing keys (each 32+ random characters) --------------------------
# WebAPI refuses to start without Jwt__Key; MobileAPI reads Jwt__SecretKey.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
Jwt__Key=
Jwt__SecretKey=

# --- Email (Gmail SMTP, needs an App Password) ------------------------------
EmailSettings__SenderEmail=
EmailSettings__SenderPassword=

# --- YouTube publishing (MobileAPI, server-side Google OAuth 2.0) -----------
# Keep uploaded booking media, generated recaps and publication archives on a
# durable private volume. The Docker compose files mount this path.
SharedBooking__StoragePath=/data/shared-booking
# FFmpeg is installed in the MobileAPI image and available on PATH.
SharedBooking__FfmpegExecutable=ffmpeg
SharedBooking__FfprobeExecutable=ffprobe
# Short VG video clips spliced into the recap (audio is always dropped).
SharedBooking__MaxVideoClipSeconds=30
SharedBooking__MaxVideoClipBytes=104857600
SharedBooking__MaxVideosPerUploader=20

# --- Internal service channel (WebAPI <-> MobileAPI) -------------------------
# One shared secret (32+ random characters) used by both APIs: the website's VG
# media uploads go WebAPI -> MobileAPI, and the app's team ratings go
# MobileAPI -> WebAPI. Leave empty to disable both. Never expose it to clients.
InternalApi__Key=
InternalApi__MobileApiBaseUrl=http://mobileapi:80
InternalApi__WebApiBaseUrl=http://webapi:80
# Create a Web application OAuth client in Google Cloud and register the exact
# HTTPS callback below. Never place a Gmail/YouTube password here.
Youtube__ClientId=
Youtube__ClientSecret=
Youtube__RedirectUri=https://your-api.example/api/admin/youtube/oauth/callback
Youtube__ExpectedPrivacyStatus=private
# Mount this directory as a durable, access-restricted server volume so
# encrypted refresh tokens remain decryptable after backend restarts.
Youtube__DataProtectionKeysPath=/data/youtube-keys

# --- URLs -------------------------------------------------------------------
# Public URL of the WebApp, used for links in password-reset / verification mails.
WebAppBaseUrl=http://localhost:9080
# Container-to-container: the WebApp reaches the WebAPI on its internal port 80.
ApiBaseUrl=http://webapi:80

# --- AI Helper (WebAPI) ------------------------------------------------------
# The advice text is written by a hosted LLM API reached with a key (nothing is self-hosted). Provider presets:
#   Gemini (free tier, https://aistudio.google.com/apikey)   Groq (free tier, https://console.groq.com/keys)
#   OpenRouter (":free" models)   Mistral (free Experiment plan)   GitHub (GitHub Models, a PAT)   Anthropic (paid)
#   Custom (any OpenAI-compatible API: also set AiHelper__Llm__BaseUrl and AiHelper__Llm__Model)   None (numbers only)
# Keep keys out of git. Without a key the AI Helper still returns the price model's numbers.
AiHelper__Llm__Provider=Gemini
AiHelper__Llm__ApiKey=
# Anthropic user-scoped keys (sk-ant-usr-*) also need the workspace ID.
AiHelper__Llm__AnthropicWorkspaceId=
# Optional: override the preset's model (e.g. gemini-flash-lite-latest, openai/gpt-oss-20b, claude-haiku-5-5).
AiHelper__Llm__Model=
# Optional second provider, used when the first hits a rate limit or is down (free tiers do).
AiHelper__Llm__Fallback__Provider=Groq
AiHelper__Llm__Fallback__ApiKey=
# A retrained price model (retrain.py --upload) lives in the persistent volume mounted at /data/ai-models; the Dockerfile
# sets AiHelper__ModelOverrideDirectory for you. Nothing to configure here.
# ZAR per 1 USD - the price models work in USD.
AiHelper__UsdToZarRate=18.0
