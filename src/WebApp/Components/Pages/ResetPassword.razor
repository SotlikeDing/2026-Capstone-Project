@* Password-reset completion page (route: /reset-password?Email=...&Token=...), reached
   via the link ForgotPassword.razor's flow emails out. Validates the token against the
   API before showing the form at all, so an expired/tampered link fails fast with a
   clear message instead of letting the user fill in a form that will error at submit. *@
@page "/herstel-wagwoord"
@page "/reset-password"
@inject NavigationManager Nav
@inject MikpuntApiService Api

<PageTitle>Herstel Wagwoord | MikPunt</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="mp-card p-4 p-md-5 rounded-4 shadow-lg border-0">
                <div class="text-center mb-4">
                    <h2 class="brand-font text-gold display-6 fw-bold mb-2">Stel Nuwe Wagwoord In</h2>
                    <p class="text-muted small">Voer jou nuwe wagwoord in om jou MikPunt-rekening te herstel.</p>
                </div>

                @if (_isCheckingToken)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-gold me-2" role="status"></div>
                        <span class="text-muted">Besig om herstelskakel te verifieer...</span>
                    </div>
                }
                else if (!_isValidLink)
                {
                    <div class="alert alert-warning border-warning p-4 mb-4">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-3 me-3 mt-1"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Ongeldige of Verval Skakel</h6>
                                <p class="small text-dark mb-3">@_errorMessage</p>
                                <a href="/wagwoord-vergeet" class="btn btn-dark btn-sm w-100 fw-bold">
                                    Versoek Nuwe Herstelskakel <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(_successMsg))
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                <div>@_successMsg</div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                <div>@_errorMessage</div>
                            </div>
                        </div>
                    }

                    <EditForm Model="_model" OnValidSubmit="HandleReset">
                        <DataAnnotationsValidator />

                        <!-- Nuwe Wagwoord -->
                        <div class="mb-3">
                            <label class="form-label text-light small fw-bold">Nuwe Wagwoord</label>
                            <div class="input-group">
                                <InputText @bind-Value="_model.Password" type="@(_showPassword ? "text" : "password")" class="form-control bg-dark text-light border-secondary" placeholder="••••••••" />
                                <button type="button" class="btn border-secondary text-muted bg-dark mp-eye-toggle-btn" @onclick="() => _showPassword = !_showPassword" tabindex="-1">
                                    @if (_showPassword)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                                            <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                                            <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12-.708.708 12 12z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </div>

                        <!-- Bevestig Wagwoord -->
                        <div class="mb-4">
                            <label class="form-label text-light small fw-bold">Bevestig Nuwe Wagwoord</label>
                            <div class="input-group">
                                <InputText @bind-Value="_model.ConfirmPassword" type="@(_showConfirmPassword ? "text" : "password")" class="form-control bg-dark text-light border-secondary" placeholder="••••••••" />
                                <button type="button" class="btn border-secondary text-muted bg-dark mp-eye-toggle-btn" @onclick="() => _showConfirmPassword = !_showConfirmPassword" tabindex="-1">
                                    @if (_showConfirmPassword)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                                            <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                                            <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12-.708.708 12 12z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="mp-btn mp-btn-primary w-100 py-2 fs-5 fw-bold mb-3" disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Besig om op te dateer...</span>
                            }
                            else
                            {
                                <span>Opdateer Wagwoord</span>
                            }
                        </button>
                    </EditForm>
                }

                <div class="text-center mt-3 pt-3 border-top border-secondary">
                    <a href="/teken-in" class="text-gold text-decoration-none small">&larr; Terug na In Teken</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Recipient email from the reset-link query string.</summary>
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    /// <summary>Single-use reset token from the reset-link query string.</summary>
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private ResetModel _model = new();
    private bool _isCheckingToken = true;
    private bool _isValidLink = false;
    private bool _isSubmitting = false;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;
    private string _successMsg = string.Empty;
    private string _errorMessage = string.Empty;

    /// <summary>Gates the whole form behind an upfront token-validity check against the API - missing Email/Token short-circuits locally, otherwise the token is verified server-side before the reset form is shown.</summary>
    protected override async Task OnInitializedAsync()
    {
        _isCheckingToken = true;
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _isValidLink = false;
            _errorMessage = "Hierdie wagwoord herstelskakel is ongeldig of ontbreek. Versoek asseblief weer 'n herstelskakel.";
            _isCheckingToken = false;
            return;
        }

        var (valid, msg) = await Api.ValidateResetTokenAsync(Email, Token);
        _isValidLink = valid;
        if (!valid)
        {
            _errorMessage = msg;
        }
        _isCheckingToken = false;
    }

    /// <summary>Client-side validates length/match before calling the API, matching the server's own validation so a client-passable form can't still fail server-side for a reason the user wasn't shown.</summary>
    private async Task HandleReset()
    {
        _errorMessage = string.Empty;
        _successMsg = string.Empty;

        if (string.IsNullOrWhiteSpace(_model.Password) || string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _errorMessage = "Voer asseblief beide wagwoord velde in.";
            return;
        }

        if (_model.Password.Length < 6)
        {
            _errorMessage = "Wagwoord moet ten minste 6 karakters lank wees.";
            return;
        }

        if (_model.Password != _model.ConfirmPassword)
        {
            _errorMessage = "Die wagwoorde stem nie ooreen nie.";
            return;
        }

        _isSubmitting = true;
        var (success, msg) = await Api.ResetPasswordAsync(Email!, Token!, _model.Password);
        _isSubmitting = false;

        if (success)
        {
            _successMsg = "Wagwoord is suksesvol opgedateer! Jy word nou aangestuur na die inlogbladsy...";
            await Task.Delay(2000);
            Nav.NavigateTo("/teken-in");
        }
        else
        {
            _errorMessage = msg;
            // If token expired or used mid-flow, invalidate link
            if (msg.Contains("ongeldig") || msg.Contains("gebruik") || msg.Contains("verval"))
            {
                _isValidLink = false;
            }
        }
    }

    /// <summary>Form-binding model; server-side validation is the real source of truth (see UserController.ResetPassword) - this has no DataAnnotations of its own.</summary>
    public class ResetModel
    {
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
