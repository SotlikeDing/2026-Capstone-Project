@* /ai-helper - the AI Helper for PJ, PH, VG, Boer (FARMER) and AP users, in two tabs:
   1. Packet maker: price-and-package optimisation. The PRICE band comes from a trained model (WebAPI, ONNX); the WRITTEN advice
      comes from a hosted language-model API grounded in those numbers. An existing package / farm / ad can be loaded in, and the
      improved offer is handed to the role's normal editor (AiDraftHandoff) to review and save - PH day rates are saved directly.
   2. Smart Teaming: ranked partner suggestions (PJ -> PH/VG/Boer, PH/VG/Boer -> PJ) with an invite button for PJs. Not for AP.
   The page shows where the numbers come from (evidence/confidence) - it never presents an assumption as a fact. Role-gated: a
   user only sees the roles they hold (Admin sees all). Deep links: ?role=PJ&packageId=5, ?role=VG&vgPackageId=2,
   ?role=Boer&farmId=3, ?role=AP&adId=4, ?role=PH, and &tab=team. *@
@page "/ki-helper"
@page "/ai-helper"
@using System.Globalization
@inject AiHelperClient Ai
@inject AuthService Auth
@inject IJSRuntime JS
@inject MikpuntApiService Api
@inject AiDraftHandoff Handoff
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>AI-Helper | MikPunt</PageTitle>

<style>
    .ai-band { position: relative; height: 14px; border-radius: 8px; background: var(--border-color); margin: 22px 0 6px; }
    .ai-band-range { position: absolute; top: 0; height: 100%; border-radius: 8px; background: rgba(34, 197, 94, 0.45); border: 1px solid rgba(34, 197, 94, 0.9); }
    .ai-band-p50 { position: absolute; top: -4px; width: 2px; height: 22px; background: var(--accent-gold); }
    .ai-band-current { position: absolute; top: -8px; width: 4px; height: 30px; border-radius: 2px; background: #ef4444; }
    .ai-band-current::after { content: attr(data-label); position: absolute; top: -18px; left: -30px; width: 64px; text-align: center; font-size: 11px; font-weight: 700; color: #ef4444; }
    .ai-band-labels { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted, #9ca3af); }
    .ai-tip { border-left: 3px solid var(--accent-gold); padding: 6px 12px; margin-bottom: 10px; }
    .ai-tip-1 { border-left-color: #ef4444; }
    .ai-chip { display: inline-block; padding: 3px 10px; border-radius: 14px; font-size: 12px; font-weight: 700; border: 1px solid var(--border-color); }
    .ai-role-btn.active { outline: 2px solid var(--accent-gold); }
    .ai-muted { color: var(--text-muted, #9ca3af); font-size: 12px; }
    .ai-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px; flex-wrap: wrap; }
    .ai-tab { background: none; border: none; border-bottom: 3px solid transparent; padding: 8px 14px; font-weight: 700; color: inherit; opacity: .7; }
    .ai-tab.active { border-bottom-color: var(--accent-gold); opacity: 1; }
    .ai-meter { height: 6px; border-radius: 4px; background: var(--border-color); overflow: hidden; }
    .ai-meter > div { height: 100%; background: var(--accent-gold); }
    .ai-score { font-size: 28px; font-weight: 800; line-height: 1; }
    .ai-apply { border: 1px solid var(--accent-gold); }
</style>

@if (!Auth.IsInitialized)
{
    <div class="mp-card text-center p-5">
        <div class="spinner-border text-gold mb-3" role="status"></div>
        <div class="fs-4 text-gold">Verifieer tans toegang...</div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Teken asseblief eers in</h3>
        <p class="text-muted mb-4">Die AI-Helper is slegs beskikbaar vir aangemelde lede met 'n Uitruster-, PH-, Videograaf-, Boer- of Adverteerder-rol.</p>
        <a href="/teken-in?returnUrl=/ki-helper" class="mp-btn mp-btn-primary">Teken In &rarr;</a>
    </div>
}
else if (Roles().Count == 0)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Toegang Beperk</h3>
        <p class="text-muted mb-4" style="max-width: 620px; margin: 0 auto;">
            Die AI-Helper help Uitrusters (PJ), Professionele Jagters (PH), Videograwe (VG), Boere en Adverteerders om hul pryse en aanbiedinge te verbeter.
            U rekening het tans nie een van hierdie rolle nie.
        </p>
        <a href="/profiel" class="mp-btn mp-btn-primary">Aktiveer 'n rol op u profiel &rarr;</a>
    </div>
}
else
{
    EnsureRole();
    <div class="mb-4">
        <h1 class="brand-font text-gold mb-1">AI-Helper</h1>
        <p class="text-muted mb-0">
            Bou en verbeter u aanbod met 'n opgeleide prysmodel en 'n taalmodel, of vind die regte spanmaats.
            Dit is 'n aanduiding, nie 'n waarborg nie.
        </p>
    </div>

    <div class="ai-tabs">
        <button class="ai-tab @(_tab == "price" ? "active" : "")" @onclick="ShowPriceTab">✨ Pakketmaker &amp; Prysoptimering</button>
        <button class="ai-tab @(_tab == "team" ? "active" : "")" @onclick="ShowTeamTab">🤝 Slim Spanbou</button>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        @foreach (var r in Roles())
        {
            <button class="mp-btn @(r.Code == _role ? "mp-btn-primary active" : "mp-btn-secondary") mp-btn-sm ai-role-btn" @onclick="() => SelectRole(r.Code)">@r.Label</button>
        }
    </div>

    @if (_tab == "team")
    {
        @TeamTab()
    }
    else
    {
    <div class="row g-4">
        @* ============================== FORM ============================== *@
        <div class="col-lg-5">
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-3">U aanbod</h4>

                @if (_role == "PH")
                {
                    <button class="mp-btn mp-btn-secondary mp-btn-sm mb-3" disabled="@_loadingOffers" @onclick="LoadPhRatesIntoDraft">↺ Laai my huidige tariewe &amp; graderings</button>
                }
                else
                {
                    <div class="mp-form-group mb-3">
                        <label class="mp-form-label">Begin by 'n bestaande @OfferNoun() <span class="ai-muted">(opsioneel)</span></label>
                        <select class="mp-form-control" value="@_loadedId" @onchange="OnOfferChosen" disabled="@_loadingOffers">
                            <option value="0">@(_loadingOffers ? "Laai tans..." : "- Nuwe aanbod -")</option>
                            @foreach (var o in _offers) { <option value="@o.Id">@o.Label</option> }
                        </select>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2 small">⚠️ @_error</div>
                }

                @if (_role != "AP")
                {
                    <div class="row g-3 mb-2">
                        <div class="col-6 mp-form-group">
                            <label class="mp-form-label">Provinsie</label>
                            <select class="mp-form-control" @bind="_province">
                                @foreach (var p in Provinces) { <option value="@p">@p</option> }
                            </select>
                        </div>
                        <div class="col-6 mp-form-group">
                            <label class="mp-form-label">Begin-maand</label>
                            <select class="mp-form-control" @bind="_month">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m">@CultureInfo.GetCultureInfo("af-ZA").DateTimeFormat.GetMonthName(m)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 mp-form-group">
                            <label class="mp-form-label">Geldeenheid</label>
                            <select class="mp-form-control" @bind="_currency">
                                <option value="USD">USD ($)</option>
                                <option value="ZAR">ZAR (R)</option>
                            </select>
                        </div>
                        <div class="col-6 mp-form-group">
                            <label class="mp-form-label">Mark</label>
                            <select class="mp-form-control" @bind="_market">
                                <option value="">Outomaties</option>
                                <option value="international">Internasionaal (USD)</option>
                                <option value="domestic">Plaaslik (ZAR)</option>
                            </select>
                        </div>
                    </div>
                }

                <div class="mp-form-group mb-3">
                    <label class="mp-form-label">Doel</label>
                    <select class="mp-form-control" @bind="_goal">
                        <option value="balanced">Gebalanseerd</option>
                        <option value="profit">Maksimum wins</option>
                        <option value="sales">Meer besprekings</option>
                    </select>
                </div>

                @switch (_role)
                {
                    case "PJ":
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Pakkettitel</label><input class="mp-form-control" @bind="_draft.Title" maxlength="200" placeholder="bv. Waterberg Trofee Koedoe &amp; Rooibok Safari" /></div>
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Beskrywing</label><textarea class="mp-form-control" rows="3" @bind="_draft.Description" maxlength="1500"></textarea></div>
                        <div class="row g-3 mb-2">
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Prys per jagter (@_currency)</label><input type="number" class="mp-form-control" @bind="_draft.Price" min="0" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Waarnemerprys (@_currency)</label><input type="number" class="mp-form-control" @bind="_draft.ObserverPrice" min="0" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Aantal dae</label><input type="number" class="mp-form-control" @bind="_draft.DurationDays" min="1" max="60" /></div>
                            <div class="col-6 mp-form-group">
                                <label class="mp-form-label">Jagters per PH</label>
                                <select class="mp-form-control" @bind="_draft.HuntersPerPh"><option value="1">1 (een-tot-een)</option><option value="2">2 (twee-tot-een)</option></select>
                            </div>
                        </div>
                        <label class="mp-form-label">Ingesluit in die prys</label>
                        <div class="row g-1 mb-2">
                            @foreach (var s in PjServices)
                            {
                                <div class="col-12">
                                    <label class="small"><input type="checkbox" checked="@_services.Contains(s.Key)" @onchange="e => ToggleService(s.Key, (bool)(e.Value ?? false))" /> @s.Label</label>
                                </div>
                            }
                        </div>
                        <div class="mp-form-group mb-2">
                            <label class="mp-form-label">Spesies wat in die prys ingesluit is <span class="ai-muted">(kommagesky, opsioneel)</span></label>
                            <input class="mp-form-control" @bind="_speciesText" list="ai-species" placeholder="bv. Rooibok, Vlakvark" />
                        </div>
                        break;

                    case "PH":
                        <div class="row g-3 mb-2">
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Dagtarief (@_currency)</label><input type="number" class="mp-form-control" @bind="_draft.Price" min="0" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Jare ervaring</label><input type="number" class="mp-form-control" @bind="_draft.YearsExperience" min="0" max="70" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Gemiddelde gradering (0-5)</label><input type="number" step="0.1" class="mp-form-control" @bind="_draft.RatingAverage" min="0" max="5" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Aantal graderings</label><input type="number" class="mp-form-control" @bind="_draft.RatingCount" min="0" /></div>
                            <div class="col-12 mp-form-group"><label class="mp-form-label">Jagte voltooi</label><input type="number" class="mp-form-control" @bind="_draft.HuntsCompleted" min="0" /></div>
                        </div>
                        <label class="small d-block mb-1"><input type="checkbox" @bind="_draft.DangerousGameAccredited" /> Ek het gevaarlike-wild akkreditasie</label>
                        <label class="small d-block mb-2"><input type="checkbox" @bind="_draft.DangerousGameRate" /> Hierdie tarief is vir gevaarlike wild</label>
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Kort beskrywing van u diens <span class="ai-muted">(opsioneel)</span></label><textarea class="mp-form-control" rows="3" @bind="_draft.Description" maxlength="1500"></textarea></div>
                        break;

                    case "VG":
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Pakkettitel</label><input class="mp-form-control" @bind="_draft.Title" maxlength="200" placeholder="bv. 4K Filmiese Safari &amp; Hommeltuigfilm" /></div>
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Beskrywing</label><textarea class="mp-form-control" rows="3" @bind="_draft.Description" maxlength="1500"></textarea></div>
                        <div class="row g-3 mb-2">
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Totale pakketprys (@_currency)</label><input type="number" class="mp-form-control" @bind="_draft.Price" min="0" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Dae gedek</label><input type="number" class="mp-form-control" @bind="_draft.DurationDays" min="1" max="60" /></div>
                            <div class="col-6 mp-form-group">
                                <label class="mp-form-label">Produksievlak</label>
                                <select class="mp-form-control" @bind="_draft.VgTier"><option value="basic">Basies (rou beeldmateriaal + teaser)</option><option value="standard">Standaard (gesnyde hoogtepunte)</option><option value="documentary">Dokumentêr (volledig)</option></select>
                            </div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Bemanning</label><input type="number" class="mp-form-control" @bind="_draft.CrewSize" min="1" max="10" /></div>
                            <div class="col-12 mp-form-group"><label class="mp-form-label">Jare ervaring</label><input type="number" class="mp-form-control" @bind="_draft.YearsExperience" min="0" max="70" /></div>
                        </div>
                        <label class="small d-block mb-1"><input type="checkbox" @bind="_draft.Drone" /> Hommeltuig-beelde ingesluit</label>
                        <label class="small d-block mb-2"><input type="checkbox" @bind="_draft.Uhd4k" /> 4K-kwaliteit</label>
                        break;

                    case "FARMER":
                        <div class="row g-3 mb-2">
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Dagtarief per jagter (@_currency)</label><input type="number" class="mp-form-control" @bind="_draft.Price" min="0" /></div>
                            <div class="col-6 mp-form-group">
                                <label class="mp-form-label">Jagters per PH</label>
                                <select class="mp-form-control" @bind="_draft.HuntersPerPh"><option value="1">1</option><option value="2">2</option></select>
                            </div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Plaasgrootte (ha)</label><input type="number" class="mp-form-control" @bind="_draft.FarmSizeHa" min="0" /></div>
                            <div class="col-6 mp-form-group"><label class="mp-form-label">Lodge-kamers</label><input type="number" class="mp-form-control" @bind="_draft.LodgeRooms" min="0" /></div>
                        </div>
                        <div class="row g-1 mb-3">
                            <div class="col-6"><label class="small"><input type="checkbox" @bind="_draft.Catering" /> Etes ingesluit</label></div>
                            <div class="col-6"><label class="small"><input type="checkbox" @bind="_draft.GuideIncluded" /> Gids/PH ingesluit</label></div>
                            <div class="col-6"><label class="small"><input type="checkbox" @bind="_draft.ColdRoom" /> Koelkamer</label></div>
                            <div class="col-6"><label class="small"><input type="checkbox" @bind="_draft.Pool" /> Swembad</label></div>
                            <div class="col-6"><label class="small"><input type="checkbox" @bind="_draft.Wifi" /> WiFi</label></div>
                            <div class="col-6"><label class="small"><input type="checkbox" @bind="_draft.GameFenced" /> Wildsgehek</label></div>
                        </div>
                        <label class="mp-form-label">Spesie-pryse <span class="ai-muted">(opsioneel - word teen die mark gemeet)</span></label>
                        @foreach (var row in _draft.SpeciesPricing.ToList())
                        {
                            <div class="row g-1 mb-1 align-items-center">
                                <div class="col-5"><input class="mp-form-control" list="ai-species" @bind="row.Species" placeholder="Spesie" /></div>
                                <div class="col-3">
                                    <select class="mp-form-control" @bind="row.Tier"><option value="trophy">Trofee</option><option value="male">Manlik</option><option value="female">Wyfie</option></select>
                                </div>
                                <div class="col-3"><input type="number" class="mp-form-control" @bind="row.Price" min="0" placeholder="@_currency" /></div>
                                <div class="col-1"><button class="btn btn-sm text-danger" title="Verwyder" @onclick="() => _draft.SpeciesPricing.Remove(row)">✕</button></div>
                            </div>
                        }
                        <button class="mp-btn mp-btn-secondary mp-btn-sm mt-1" @onclick="AddSpeciesRow">+ Spesie</button>
                        break;

                    case "AP":
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Advertensie-opskrif</label><input class="mp-form-control" @bind="_draft.Title" maxlength="200" placeholder="bv. Handgemaakte biltongmesse" /></div>
                        <div class="mp-form-group mb-2"><label class="mp-form-label">Advertensieteks</label><textarea class="mp-form-control" rows="4" @bind="_draft.Description" maxlength="1500"></textarea></div>
                        <div class="row g-3 mb-2">
                            <div class="col-6 mp-form-group">
                                <label class="mp-form-label">Kategorie</label>
                                <select class="mp-form-control" @bind="_draft.AdCategory">
                                    <option value="Toerusting">Toerusting &amp; Optika</option><option value="Taksidermie">Taksidermie &amp; Montage</option>
                                    <option value="Vervoer">Vervoer &amp; Logistiek</option><option value="Akkommodasie">Akkommodasie &amp; Jagkampe</option>
                                    <option value="Vuurwapens">Vuurwapens &amp; Ammunisie</option>
                                </select>
                            </div>
                            <div class="col-6 mp-form-group">
                                <label class="mp-form-label">Plasing</label>
                                <select class="mp-form-control" @bind="_draft.AdPlacement"><option value="Banner">Banier</option><option value="Spotlight">Kollig</option><option value="Featured">Uitgelig</option></select>
                            </div>
                        </div>
                        <p class="ai-muted">Die advertensie-ontleding gebruik u werklike kyk- en klikgetalle. Geen klik-koerse word geskat nie.</p>
                        break;
                }

                <datalist id="ai-species">
                    @foreach (var s in SpeciesNames) { <option value="@s"></option> }
                </datalist>

                <button class="mp-btn mp-btn-primary w-100 mt-3" disabled="@_busy" @onclick="Analyse">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span><span>AI ontleed tans... (kan tot 'n minuut neem)</span> }
                    else { <span>✨ Ontleed met AI</span> }
                </button>
                <p class="ai-muted mt-2 mb-0">Die AI-teks word deur 'n eksterne taalmodel-diens geskryf. Tik geen persoonlike of vertroulike inligting in die beskrywing nie.</p>
            </div>
        </div>

        @* ============================== RESULTS ============================== *@
        <div class="col-lg-7">
            @if (_result == null && !_busy)
            {
                <div class="mp-card p-4 text-center text-muted">
                    <div style="font-size: 40px;">📊</div>
                    <p class="mb-0">Vul u aanbod in en klik <strong>Ontleed met AI</strong> om 'n prysverdikt en konkrete voorstelle te kry.</p>
                </div>
            }
            @if (_result != null)
            {
                @ApplyPanel(_result)
                @Results(_result)
            }
        </div>
    </div>
    }
}

@code {
    private static readonly string[] Provinces = { "Limpopo", "Gauteng", "Mpumalanga", "Noordwes", "Vrystaat", "Noord-Kaap", "Oos-Kaap", "Wes-Kaap", "KwaZulu-Natal" };

    private static readonly (string Key, string Label)[] PjServices =
    {
        ("ph_included", "Professionele jagter (PH) & spoorsnyers"), ("accommodation", "Akkommodasie"), ("meals", "Alle etes"),
        ("field_prep", "Veldvoorbereiding van trofeë"), ("airport_transfer", "Lughawe-vervoer"),
        ("videography", "Videografie"), ("drone", "Hommeltuig-video")
    };

    private static readonly string[] SpeciesNames =
    {
        "Koedoe", "Eland", "Njala", "Swartwitpens", "Bastergemsbok", "Waterbok", "Gemsbok", "Tsessebe", "Blouwildebees", "Swartwildebees",
        "Rooihartbees", "Sebra", "Rooibok", "Blesbok", "Springbok", "Vlakvark", "Bosbok", "Bosvark", "Klipspringer", "Rooiribbok",
        "Rietbok", "Gewone Duiker", "Steenbok", "Lechwe", "Vaalribbok", "Kameelperd", "Buffel"
    };

    private string _role = "";
    private string _province = "Limpopo";
    private int _month = DateTime.UtcNow.Month;
    private string _currency = WebApp.Services.Money.PackageCurrency;
    private string _market = "";
    private string _goal = "balanced";
    private string _speciesText = "";
    private readonly HashSet<string> _services = new() { "ph_included", "accommodation", "meals", "field_prep" };
    private AiDraftModel _draft = NewDraft();

    private bool _busy;
    private string? _error;
    private AiOptimizeResponseModel? _result;
    private bool _feedbackSent;

    [SupplyParameterFromQuery(Name = "role")] public string? QueryRole { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? QueryTab { get; set; }
    [SupplyParameterFromQuery(Name = "packageId")] public int? QueryPackageId { get; set; }
    [SupplyParameterFromQuery(Name = "vgPackageId")] public int? QueryVgPackageId { get; set; }
    [SupplyParameterFromQuery(Name = "farmId")] public int? QueryFarmId { get; set; }
    [SupplyParameterFromQuery(Name = "adId")] public int? QueryAdId { get; set; }

    private string _tab = "price";
    private bool _queryApplied;
    private int MyUserId => Auth.CurrentUser?.UserId ?? 0;

    // ---- existing offers that can be loaded into the form (and updated by "apply")
    private bool _loadingOffers;
    private int _loadedId;
    private List<(int Id, string Label)> _offers = new();
    private List<HuntingPackageModel> _myPackages = new();
    private List<ServicePackageModel> _myVgPackages = new();
    private List<FarmModel> _myFarms = new();
    private List<AdvertisementModel> _myAds = new();
    private PhDailyRatesModel? _phRates;

    // ---- packet maker: the offer assembled from the advice
    private string _applyTitle = "";
    private string _applyDescription = "";
    private string _applyPriceMode = "current";
    private decimal? _applyCustomPrice;
    private bool _applyAsNew;
    private bool _applySpecies = true;
    private int _applyFarmId;
    private string? _applyMessage;
    private bool _applyBusy;

    private static AiDraftModel NewDraft() => new() { DurationDays = 5, HuntersPerPh = 1, VgTier = "standard", CrewSize = 1, AdCategory = "Toerusting", AdPlacement = "Banner" };

    protected override void OnInitialized() => Auth.OnAuthStateChanged += OnAuthChanged;

    protected override Task OnParametersSetAsync() => ApplyQueryOnceAsync();

    private void OnAuthChanged() => _ = InvokeAsync(async () => { await ApplyQueryOnceAsync(); StateHasChanged(); });

    private void ShowPriceTab() => _tab = "price";

    private void ShowTeamTab() => _tab = "team";

    /// <summary>Honours deep links (?role=..&amp;tab=team&amp;packageId=..) once, as soon as the user and their roles are known.</summary>
    private async Task ApplyQueryOnceAsync()
    {
        if (_queryApplied || !Auth.IsInitialized || !Auth.IsAuthenticated) return;
        _queryApplied = true;
        if (QueryTab == "team") _tab = "team";
        var wanted = (QueryRole ?? "").Trim().ToUpperInvariant() switch { "BOER" or "FARMER" => "FARMER", var r => r };
        if (Roles().Any(r => r.Code == wanted)) SelectRole(wanted); else EnsureRole();

        int? id = _role switch { "PJ" => QueryPackageId, "VG" => QueryVgPackageId, "FARMER" => QueryFarmId, "AP" => QueryAdId, _ => null };
        if (_role == "PH" && !string.IsNullOrEmpty(QueryRole)) await LoadPhRatesIntoDraft();
        else if (id is > 0)
        {
            await LoadOffersAsync();
            if (_offers.Any(o => o.Id == id)) SelectOffer(id.Value);
        }
    }

    public void Dispose() => Auth.OnAuthStateChanged -= OnAuthChanged;

    /// <summary>The AI-Helper roles this user actually holds (Admin sees all).</summary>
    private List<(string Code, string Label)> Roles()
    {
        var all = new[] { ("PJ", "Uitruster (PJ)"), ("PH", "Professionele Jagter (PH)"), ("VG", "Videograaf (VG)"), ("FARMER", "Grondeienaar (Boer)"), ("AP", "Adverteerder (AP)") };
        bool admin = Auth.HasRole("Admin");
        return all.Where(r => admin || Auth.HasRole(r.Item1 == "FARMER" ? "Boer" : r.Item1)).ToList();
    }

    private void EnsureRole()
    {
        var roles = Roles();
        if (roles.Count > 0 && roles.All(r => r.Code != _role)) SelectRole(roles[0].Code);
    }

    private void SelectRole(string code)
    {
        bool changed = _role != code;
        _role = code;
        _result = null;
        _error = null;
        _draft = NewDraft();
        _speciesText = "";
        _market = "";
        _currency = code == "PJ" ? WebApp.Services.Money.PackageCurrency : "ZAR";
        if (code == "PH") { _draft.DangerousGameAccredited = false; }
        _loadedId = 0;
        _applyMessage = null;
        if (changed)
        {
            _offers = new();
            _team = null;
            _teamError = null;
            if (code != "PH") _ = InvokeAsync(async () => { await LoadOffersAsync(); StateHasChanged(); });
        }
    }

    private void ToggleService(string key, bool on)
    {
        if (on) _services.Add(key); else _services.Remove(key);
    }

    private void AddSpeciesRow() => _draft.SpeciesPricing.Add(new AiSpeciesPriceDraftModel());

    private static List<string> SplitList(string text) =>
        text.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).Take(30).ToList();

    private AiOptimizeRequestModel BuildRequest()
    {
        var d = _draft;
        var draft = new AiDraftModel { Title = d.Title, Description = d.Description, Price = d.Price is > 0 ? d.Price : null };
        switch (_role)
        {
            case "PJ":
                draft.ObserverPrice = d.ObserverPrice is > 0 ? d.ObserverPrice : null;
                draft.DurationDays = d.DurationDays; draft.HuntersPerPh = d.HuntersPerPh;
                draft.Services = _services.ToList(); draft.Species = SplitList(_speciesText);
                break;
            case "PH":
                draft.YearsExperience = d.YearsExperience; draft.RatingAverage = d.RatingAverage; draft.RatingCount = d.RatingCount;
                draft.HuntsCompleted = d.HuntsCompleted; draft.DangerousGameRate = d.DangerousGameRate; draft.DangerousGameAccredited = d.DangerousGameAccredited;
                break;
            case "VG":
                draft.DurationDays = d.DurationDays; draft.VgTier = d.VgTier; draft.Drone = d.Drone; draft.Uhd4k = d.Uhd4k;
                draft.CrewSize = d.CrewSize; draft.YearsExperience = d.YearsExperience;
                break;
            case "FARMER":
                draft.HuntersPerPh = d.HuntersPerPh; draft.FarmSizeHa = d.FarmSizeHa; draft.LodgeRooms = d.LodgeRooms; draft.Catering = d.Catering;
                draft.GuideIncluded = d.GuideIncluded; draft.ColdRoom = d.ColdRoom; draft.Pool = d.Pool; draft.Wifi = d.Wifi; draft.GameFenced = d.GameFenced;
                draft.SpeciesPricing = d.SpeciesPricing.Where(r => !string.IsNullOrWhiteSpace(r.Species)).ToList();
                draft.Species = draft.SpeciesPricing.Select(r => r.Species).ToList();
                break;
            case "AP":
                draft.AdCategory = d.AdCategory; draft.AdPlacement = d.AdPlacement;
                break;
        }
        return new AiOptimizeRequestModel
        {
            RoleCode = _role, Province = _role == "AP" ? null : _province, Currency = _currency,
            Market = string.IsNullOrEmpty(_market) ? null : _market, Goal = _goal, Month = _role == "AP" ? null : _month, Draft = draft
        };
    }

    private async Task Analyse()
    {
        _error = null;
        _result = null;
        _feedbackSent = false;
        if (_role == "AP" && string.IsNullOrWhiteSpace(_draft.Title) && string.IsNullOrWhiteSpace(_draft.Description))
        {
            _error = "Voer ten minste 'n opskrif of teks vir u advertensie in.";
            return;
        }

        _busy = true;
        _applyMessage = null;
        StateHasChanged();
        var (ok, result, error) = await Ai.OptimizeAsync(BuildRequest());
        _busy = false;
        if (ok && result != null) { _result = result; InitApply(result); } else _error = error;
    }

    private async Task Feedback(bool helpful)
    {
        if (_result == null || _result.AdviceId <= 0) return;
        _feedbackSent = await Ai.SendFeedbackAsync(_result.AdviceId, helpful);
    }

    private async Task Copy(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch { /* clipboard blocked - ignore */ }
    }

    // ------------------------------------------------------------------ existing offers (load into the form)

    private string OfferNoun() => _role switch { "PJ" => "pakket", "VG" => "videopakket", "FARMER" => "plaas", "AP" => "advertensie", _ => "aanbod" };

    /// <summary>Fetches the caller's own packages / video packages / farms / ads for the current role (Admin sees all PJ packages).</summary>
    private async Task LoadOffersAsync()
    {
        if (MyUserId <= 0 || _role == "PH") return;
        _loadingOffers = true;
        try
        {
            switch (_role)
            {
                case "PJ":
                    // A PJ's own packages, including ones the marketplace still hides (documents pending).
                    _myPackages = Auth.HasRole("Admin") ? await Api.GetPackagesAsync() : await Api.GetMyPackagesAsync();
                    _offers = _myPackages.Select(p => (p.Id, $"{p.Title} ({WebApp.Services.Money.Format(p.PricePerHunter, WebApp.Services.Money.PackageCurrency)}, {p.DurationDays} dae)")).ToList();
                    break;
                case "VG":
                    _myVgPackages = await Api.GetVgPackagesAsync(MyUserId) ?? new();
                    _offers = _myVgPackages.Select(p => (p.Id, $"{p.Title} (R{p.DailyRate:N0}/dag)")).ToList();
                    break;
                case "FARMER":
                    _myFarms = await Api.GetFarmsAsync(MyUserId);
                    _offers = _myFarms.Select(f => (f.Id, $"{f.Name} (R{f.DailyRateHunter:N0}/dag)")).ToList();
                    break;
                case "AP":
                    _myAds = await Api.GetAdsAsync(MyUserId);
                    _offers = _myAds.Select(a => (a.Id, string.IsNullOrWhiteSpace(a.Title) ? $"Advertensie #{a.Id}" : a.Title)).ToList();
                    break;
            }
        }
        catch { _offers = new(); }
        finally { _loadingOffers = false; }
    }

    private void OnOfferChosen(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0) SelectOffer(id);
        else { _loadedId = 0; _draft = NewDraft(); _speciesText = ""; _result = null; }
    }

    private string MatchProvince(string? text) =>
        Provinces.FirstOrDefault(p => string.Equals(p, text?.Trim(), StringComparison.OrdinalIgnoreCase))
        ?? Provinces.FirstOrDefault(p => !string.IsNullOrWhiteSpace(text) && text.Contains(p, StringComparison.OrdinalIgnoreCase))
        ?? _province;

    private static bool Has(IEnumerable<string> list, params string[] words) =>
        list.Any(a => words.Any(w => a.Contains(w, StringComparison.OrdinalIgnoreCase)));

    /// <summary>Fills the form from one of the caller's existing offers, so the advice is about what is really listed.</summary>
    private void SelectOffer(int id)
    {
        _result = null;
        _error = null;
        _applyMessage = null;
        _draft = NewDraft();
        _speciesText = "";
        _loadedId = id;
        switch (_role)
        {
            case "PJ" when _myPackages.FirstOrDefault(p => p.Id == id) is { } p:
                _currency = WebApp.Services.Money.PackageCurrency;
                _draft.Title = p.Title; _draft.Description = p.Description; _draft.Price = p.PricePerHunter;
                _draft.ObserverPrice = p.PricePerObserver > 0 ? p.PricePerObserver : null;
                _draft.DurationDays = p.DurationDays > 0 ? p.DurationDays : 5;
                _speciesText = string.Join(", ", p.AvailableFarmSpecies ?? new List<string>());
                _province = MatchProvince(p.Province);
                break;
            case "VG" when _myVgPackages.FirstOrDefault(v => v.Id == id) is { } v:
                _currency = "ZAR";
                _draft.Title = v.Title; _draft.Description = v.Description;
                _draft.DurationDays = 3;
                _draft.Price = v.DailyRate > 0 ? v.DailyRate * 3 : null;
                _draft.Drone = Has(new[] { v.EquipmentProvided, v.Description }, "drone", "hommeltuig", "mavic");
                _draft.Uhd4k = Has(new[] { v.EquipmentProvided, v.Description, v.Title }, "4k");
                _province = MatchProvince(v.RegionCovered);
                break;
            case "FARMER" when _myFarms.FirstOrDefault(f => f.Id == id) is { } f:
                _currency = "ZAR";
                _draft.Price = f.DailyRateHunter > 0 ? f.DailyRateHunter : null;
                _draft.FarmSizeHa = f.SizeHectares > 0 ? f.SizeHectares : null;
                _draft.Description = f.Description;
                _draft.Catering = Has(f.Amenities, "etes", "maaltye", "catering", "spyseniering");
                _draft.ColdRoom = Has(f.Amenities, "koelkamer", "cold");
                _draft.Pool = Has(f.Amenities, "swembad", "pool");
                _draft.Wifi = Has(f.Amenities, "wifi");
                _draft.GuideIncluded = Has(f.Amenities, "spoorsnyer", "gids", "guide");
                _province = MatchProvince(f.Province);
                foreach (var g in f.GameInventory.Where(g => !string.IsNullOrWhiteSpace(g.SpeciesName)))
                {
                    if (g.PriceTrophy > 0) _draft.SpeciesPricing.Add(new() { Species = g.SpeciesName, Tier = "trophy", Price = g.PriceTrophy });
                    if (g.PriceMale > 0) _draft.SpeciesPricing.Add(new() { Species = g.SpeciesName, Tier = "male", Price = g.PriceMale });
                    if (g.PriceFemale > 0) _draft.SpeciesPricing.Add(new() { Species = g.SpeciesName, Tier = "female", Price = g.PriceFemale });
                }
                _draft.SpeciesPricing = _draft.SpeciesPricing.Take(25).ToList();
                break;
            case "AP" when _myAds.FirstOrDefault(a => a.Id == id) is { } a:
                _draft.Title = a.Title; _draft.Description = a.Description;
                _draft.AdCategory = CanonicalAdCategory(a.Category);
                _draft.AdPlacement = a.PlacementType is "Banner" or "Spotlight" or "Featured" ? a.PlacementType : "Banner";
                break;
            default:
                _loadedId = 0;
                break;
        }
    }

    private static string CanonicalAdCategory(string? c) => (c ?? "").Trim().ToLowerInvariant() switch
    {
        "taxidermy" or "taksidermie" or "taksidermie & montage" => "Taksidermie",
        "transport" or "vervoer" or "vervoer & logistiek" => "Vervoer",
        "accommodation" or "akkommodasie" or "akkommodasie & jagkampe" or "verblyf" => "Akkommodasie",
        "firearms" or "vuurwapens" or "vuurwapens & ammunisie" => "Vuurwapens",
        _ => "Toerusting"
    };

    /// <summary>PH: loads the saved day rates and the real rating stats into the form.</summary>
    private async Task LoadPhRatesIntoDraft()
    {
        if (MyUserId <= 0) return;
        _loadingOffers = true;
        try
        {
            _phRates = await Api.GetPhDailyRatesAsync(MyUserId);
            var stats = await Api.GetRatingProfileStatsAsync(MyUserId, "PH");
            _currency = "ZAR";
            _draft.DangerousGameAccredited = _phRates.HasDangerousGameAccreditation;
            _draft.Price = _draft.DangerousGameRate ? _phRates.DangerousGameDailyRate : _phRates.StandardDailyRate;
            if (stats.RatingCount > 0) { _draft.RatingAverage = (double)stats.AverageStars; _draft.RatingCount = stats.RatingCount; }
            _draft.HuntsCompleted = stats.CompletedTrips;
        }
        catch { _error = "Kon nie u huidige tariewe laai nie."; }
        finally { _loadingOffers = false; }
    }

    // ------------------------------------------------------------------ packet maker: build the offer from the advice

    private void InitApply(AiOptimizeResponseModel r)
    {
        _applyTitle = !string.IsNullOrWhiteSpace(_draft.Title) ? _draft.Title! : r.Narrative?.TitleSuggestions.FirstOrDefault() ?? "";
        _applyDescription = r.Narrative?.DescriptionRewrite ?? _draft.Description ?? "";
        _applyPriceMode = r.Price == null || _draft.Price is not > 0 || r.Price.Position is "above" or "below" ? "median" : "current";
        _applyCustomPrice = r.Price?.P50;
        _applyAsNew = _loadedId == 0 || _role == "VG";
        _applyFarmId = _role == "FARMER" ? _loadedId : 0;
        _applyMessage = null;
        if (_role == "FARMER" && _myFarms.Count == 0) _ = InvokeAsync(async () => { await LoadOffersAsync(); StateHasChanged(); });
    }

    private decimal? ChosenPrice(AiOptimizeResponseModel r) => _applyPriceMode switch
    {
        "median" => r.Price?.P50,
        "custom" => _applyCustomPrice is > 0 ? _applyCustomPrice : null,
        _ => _draft.Price is > 0 ? _draft.Price : null
    };

    /// <summary>The editors store PJ packages in the package currency and everything else in ZAR; converts with the exchange rate the API used.</summary>
    private static decimal? Convert(decimal? v, string from, string to, decimal fx)
    {
        if (v is null || from == to || fx <= 0) return v;
        return Math.Round(from == "USD" ? v.Value * fx : v.Value / fx, 0);
    }

    private string TargetCurrency => _role == "PJ" ? WebApp.Services.Money.PackageCurrency : "ZAR";

    private string TargetMoney(decimal v) => TargetCurrency == "ZAR" ? $"R{v:N0}" : $"${v:N0}";

    private async Task ApplyAsync()
    {
        if (_result is not { } r) return;
        _applyMessage = null;
        var price = Convert(ChosenPrice(r), r.Currency, TargetCurrency, r.UsdToZarRate);
        string? title = string.IsNullOrWhiteSpace(_applyTitle) ? null : _applyTitle.Trim();
        string? description = string.IsNullOrWhiteSpace(_applyDescription) ? null : _applyDescription.Trim();

        switch (_role)
        {
            case "PH":
                if (price is not > 0) { _applyMessage = "Kies of tik eers 'n dagtarief."; return; }
                _applyBusy = true;
                try
                {
                    _phRates ??= await Api.GetPhDailyRatesAsync(MyUserId);
                    decimal standard = _draft.DangerousGameRate ? _phRates.StandardDailyRate ?? 0 : price.Value;
                    decimal dg = _draft.DangerousGameRate ? price.Value : _phRates.DangerousGameDailyRate ?? 0;
                    await Api.SavePhDailyRatesAsync(MyUserId, standard, dg, _phRates.HasDangerousGameAccreditation || _draft.DangerousGameRate);
                    _phRates = await Api.GetPhDailyRatesAsync(MyUserId);
                    var saved = _draft.DangerousGameRate ? _phRates.DangerousGameDailyRate : _phRates.StandardDailyRate;
                    _applyMessage = saved == price
                        ? $"✓ Gestoor: u {(_draft.DangerousGameRate ? "gevaarlike-wild" : "gewone")} dagtarief is nou R{price:N0}."
                        : "Kon nie die tarief stoor nie. Probeer asseblief weer.";
                }
                catch { _applyMessage = "Kon nie die tarief stoor nie. Probeer asseblief weer."; }
                finally { _applyBusy = false; }
                return;

            case "PJ":
                Handoff.Put(new AiAppliedDraft
                {
                    RoleCode = "PJ", TargetId = _applyAsNew ? 0 : _loadedId, Title = title, Description = description, Price = price,
                    ObserverPrice = Convert(_draft.ObserverPrice, r.Currency, WebApp.Services.Money.PackageCurrency, r.UsdToZarRate), DurationDays = _draft.DurationDays
                });
                Nav.NavigateTo("/pj/pakkette?ai=1");
                return;

            case "VG":
                int days = Math.Max(1, _draft.DurationDays ?? 1);
                Handoff.Put(new AiAppliedDraft
                {
                    RoleCode = "VG", Title = title, Description = description, Province = _province,
                    Price = price is > 0 ? Math.Round(price.Value / days, 0) : null, DurationDays = days
                });
                Nav.NavigateTo("/vg/pakkette?ai=1");
                return;

            case "FARMER":
                if (_applyFarmId <= 0) { _applyMessage = "Kies eers watter plaas bygewerk moet word."; return; }
                var handoff = new AiAppliedDraft { RoleCode = "FARMER", TargetId = _applyFarmId, Description = description, Price = price };
                if (_applySpecies)
                {
                    // The API answers species in the order they were sent; map back to the farm's own spelling (the API returns the catalogue name).
                    var sent = _draft.SpeciesPricing.Where(x => !string.IsNullOrWhiteSpace(x.Species)).ToList();
                    for (int i = 0; i < r.SpeciesPrices.Count; i++)
                    {
                        var s = r.SpeciesPrices[i];
                        if (s.Price is not { Position: "above" or "below" }) continue;
                        handoff.SpeciesPrices.Add(new AiSpeciesPriceDraftModel
                        {
                            Species = i < sent.Count ? sent[i].Species : s.Species, Tier = s.Tier,
                            Price = Convert(s.Price.P50, r.Currency, "ZAR", r.UsdToZarRate)
                        });
                    }
                }
                Handoff.Put(handoff);
                Nav.NavigateTo($"/boer/wysig-plaas/{_applyFarmId}?ai=1");
                return;

            case "AP":
                Handoff.Put(new AiAppliedDraft
                {
                    RoleCode = "AP", TargetId = _applyAsNew ? 0 : _loadedId, Title = title, Description = description, AdCategory = _draft.AdCategory
                });
                Nav.NavigateTo(_applyAsNew ? "/ap/nuwe-advertensie?ai=1" : $"/ap/wysig-advertensie/{_loadedId}?ai=1");
                return;
        }
    }

