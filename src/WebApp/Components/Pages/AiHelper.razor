    // ------------------------------------------------------------------ Smart Teaming

    private static readonly Dictionary<string, string> ProvinceIds = new()
    {
        ["Limpopo"] = "limpopo", ["Gauteng"] = "gauteng", ["Mpumalanga"] = "mpumalanga", ["Noordwes"] = "north_west", ["Vrystaat"] = "free_state",
        ["Noord-Kaap"] = "northern_cape", ["Oos-Kaap"] = "eastern_cape", ["Wes-Kaap"] = "western_cape", ["KwaZulu-Natal"] = "kwazulu_natal"
    };

    private static string ProvinceName(string id) => ProvinceIds.FirstOrDefault(kv => kv.Value == id).Key ?? id;

    private static string RoleName(string code) => code switch
    {
        "PJ" => "Uitruster (PJ)", "PH" => "Professionele Jagter (PH)", "VG" => "Videograaf (VG)", "FARMER" => "Boer", _ => code
    };

    private string _teamProvince = "";
    private decimal? _teamBudget;
    private readonly HashSet<string> _teamWant = new() { "PH", "VG", "FARMER" };
    private bool _teamBusy;
    private string? _teamError;
    private AiTeamResponseModel? _team;
    private readonly HashSet<int> _invited = new();
    private string? _teamMessage;

    private void ToggleWant(string role, bool on)
    {
        if (on) _teamWant.Add(role); else _teamWant.Remove(role);
    }

    private async Task FindPartners()
    {
        _teamError = null;
        _teamMessage = null;
        if (_role == "PJ" && _teamWant.Count == 0) { _teamError = "Kies ten minste een soort vennoot."; return; }
        _teamBusy = true;
        StateHasChanged();
        var (ok, res, error) = await Ai.TeamMatchesAsync(new AiTeamRequestModel
        {
            RoleCode = _role, Province = string.IsNullOrEmpty(_teamProvince) ? null : _teamProvince,
            MaxDailyRate = _role == "PJ" && _teamBudget is > 0 ? _teamBudget : null,
            WantRoles = _role == "PJ" ? _teamWant.ToList() : new()
        });
        _teamBusy = false;
        if (ok) _team = res; else _teamError = error;
    }

    private async Task Invite(AiTeamMatchModel m)
    {
        _teamMessage = null;
        bool ok = await Api.SendTeamInviteAsync(MyUserId, m.UserId, m.UserRoleId, targetUserName: m.Name,
            targetRoleCode: m.RoleCode == "FARMER" ? "Boer" : m.RoleCode);
        if (ok) { _invited.Add(m.UserRoleId); _teamMessage = $"✓ Span-uitnodiging aan {m.Name} gestuur."; }
        else _teamMessage = $"Kon nie die uitnodiging aan {m.Name} stuur nie.";
    }

    private void MessagePartner(AiTeamMatchModel m) =>
        Nav.NavigateTo($"/boodskappe?targetUser={Uri.EscapeDataString(m.Name)}&targetUserId={m.UserId}");

    private RenderFragment TeamTab() => @<div>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var r in Roles())
            {
                <button class="mp-btn @(r.Code == _role ? "mp-btn-primary active" : "mp-btn-secondary") mp-btn-sm ai-role-btn" @onclick="() => SelectRole(r.Code)">@r.Label</button>
            }
        </div>
        @if (_role == "AP")
        {
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-2">Slim Spanbou is nie vir adverteerders nie</h4>
                <p class="mb-3">@ApExclusion</p>
                <button class="mp-btn mp-btn-primary mp-btn-sm" @onclick="ShowPriceTab">✨ Optimeer eerder u advertensie</button>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="mp-card p-4">
                        <h4 class="brand-font text-gold mb-3">@(_role == "PJ" ? "Soek spanmaats" : "Soek uitrusters")</h4>
                        <p class="ai-muted">
                            @(_role == "PJ"
                                ? "Vind professionele jagters, videograwe en boere wat by u span pas."
                                : "Vind uitrusters (PJ) wat by u pas - net 'n uitruster kan 'n span-uitnodiging stuur, so stuur vir hulle 'n boodskap.")
                        </p>
                        <div class="mp-form-group mb-2">
                            <label class="mp-form-label">U gebied</label>
                            <select class="mp-form-control" @bind="_teamProvince">
                                <option value="">Outomaties (uit u lyste)</option>
                                @foreach (var p in Provinces) { <option value="@p">@p</option> }
                            </select>
                        </div>
                        @if (_role == "PJ")
                        {
                            <label class="mp-form-label">Soek na</label>
                            <div class="mb-2">
                                <label class="small d-block"><input type="checkbox" checked="@_teamWant.Contains("PH")" @onchange='e => ToggleWant("PH", (bool)(e.Value ?? false))' /> Professionele jagters (PH)</label>
                                <label class="small d-block"><input type="checkbox" checked="@_teamWant.Contains("VG")" @onchange='e => ToggleWant("VG", (bool)(e.Value ?? false))' /> Videograwe (VG)</label>
                                <label class="small d-block"><input type="checkbox" checked="@_teamWant.Contains("FARMER")" @onchange='e => ToggleWant("FARMER", (bool)(e.Value ?? false))' /> Boere / plase</label>
                            </div>
                            <div class="mp-form-group mb-2">
                                <label class="mp-form-label">Maksimum dagtarief (R) <span class="ai-muted">(opsioneel)</span></label>
                                <input type="number" class="mp-form-control" @bind="_teamBudget" min="0" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_teamError))
                        {
                            <div class="alert alert-danger py-2 small">⚠️ @_teamError</div>
                        }
                        <button class="mp-btn mp-btn-primary w-100 mt-2" disabled="@_teamBusy" @onclick="FindPartners">
                            @if (_teamBusy) { <span class="spinner-border spinner-border-sm me-2"></span><span>Soek tans...</span> }
                            else { <span>🤝 Vind vennote</span> }
                        </button>
                        <p class="ai-muted mt-3 mb-0">
                            Die passingtelling kombineer nabyheid (35%), geloofsbriewe &amp; graderings (25%), @(_role == "PJ" ? "tarief teen u begroting" : "werkvolume") (20%)
                            en rekord (20%). Sodra daar genoeg aanvaarde en afgekeurde uitnodigings is, leer die model self watter faktore saak maak.
                            Die taalmodel sien geen name of kontakbesonderhede nie.
                        </p>
                    </div>
                </div>
                <div class="col-lg-8">
                    @if (_team == null && !_teamBusy)
                    {
                        <div class="mp-card p-4 text-center text-muted">
                            <div style="font-size: 40px;">🤝</div>
                            <p class="mb-0">Klik <strong>Vind vennote</strong> om voorstelle te kry.</p>
                        </div>
                    }
                    @if (_team != null)
                    {
                        @TeamResults(_team)
                    }
                </div>
            </div>
        }
    </div>;

    private const string ApExclusion = "Adverteerders (AP) bemark kommersiële produkte/dienste op die markplein en neem nie deel aan jagspan-teaming in die veld nie. Teaming is beskikbaar vir Uitrusters (PJ), Professionele Jagters (PH), Videograwe (VG) en Boere.";

    private RenderFragment TeamResults(AiTeamResponseModel t) => @<div>
        @if (!string.IsNullOrEmpty(_teamMessage))
        {
            <div class="alert @(_teamMessage.StartsWith("✓") ? "alert-success" : "alert-warning") py-2 small">@_teamMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(t.Summary))
        {
            <div class="mp-card p-3"><strong>AI-opsomming:</strong> @t.Summary</div>
        }
        else if (t.NarrativeStatus != "ok" && t.Matches.Count > 0)
        {
            <div class="alert alert-info small">Die AI-skryfhulp is tans nie beskikbaar nie@(string.IsNullOrEmpty(t.NarrativeError) ? "" : $" ({t.NarrativeError})"). Die rangorde hieronder is steeds geldig.</div>
        }
        @if (t.Matches.Count == 0)
        {
            <div class="mp-card p-4 text-center text-muted">Geen geskikte @(_role == "PJ" ? "spanmaats" : "uitrusters") gevind nie. Probeer 'n ander gebied of verwyder die begroting.</div>
        }
        @foreach (var m in t.Matches)
        {
            <div class="mp-card p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <div class="fw-bold fs-5">@m.Name</div>
                        <div class="ai-muted">@RoleName(m.RoleCode)@(string.IsNullOrEmpty(m.BusinessName) ? "" : $" · {m.BusinessName}")@(m.Provinces.Count > 0 ? " · " + string.Join(", ", m.Provinces.Select(ProvinceName)) : "")</div>
                    </div>
                    <div class="text-end">
                        <div class="ai-score text-gold">@m.Score%</div>
                        <div class="ai-muted">passing</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(m.Reason))
                {
                    <p class="mt-2 mb-2">@m.Reason</p>
                }
                <div class="row g-2 my-2">
                    @foreach (var c in m.Components)
                    {
                        <div class="col-6 col-md-3">
                            <div class="ai-muted">@c.Label</div>
                            <div class="ai-meter"><div style="width:@((c.Value * 100).ToString("0", CultureInfo.InvariantCulture))%"></div></div>
                        </div>
                    }
                </div>
                <div class="small mb-3">@foreach (var f in m.Facts) { <span class="me-3">• @f</span> }</div>
                <div class="d-flex gap-2 flex-wrap">
                    @if (_role == "PJ")
                    {
                        @if (_invited.Contains(m.UserRoleId) || m.Relationship == "invite_pending")
                        {
                            <span class="mp-badge mp-badge-warning">Uitnodiging gestuur</span>
                        }
                        else if (m.CanInvite)
                        {
                            <button class="mp-btn mp-btn-primary mp-btn-sm" @onclick="() => Invite(m)">Stuur Span-Uitnodiging</button>
                        }
                        @if (m.Relationship == "invite_declined")
                        {
                            <span class="ai-muted align-self-center">Het vantevore 'n uitnodiging afgekeur</span>
                        }
                    }
                    <button class="mp-btn mp-btn-secondary mp-btn-sm" @onclick="() => MessagePartner(m)">Stuur boodskap</button>
                    <a class="mp-btn mp-btn-secondary mp-btn-sm" href="/profiel/@m.UserId">Profiel</a>
                </div>
            </div>
        }
        <div class="ai-muted px-1">
            Telling: @(t.Model.Source == "prior+learned"
                ? $"voorafgewigte gemeng met 'n model wat uit {t.Model.LabelledPairs} werklike uitnodiging-uitkomste geleer het ({t.Model.LearnedShare:P0} geleer)"
                : $"voorafgewigte (nog te min werklike uitnodiging-uitkomste om van te leer: {t.Model.LabelledPairs})")
            · Taalmodel @(string.IsNullOrEmpty(t.Engine.LlmModel) ? "-" : $"{t.Engine.LlmProvider}/{t.Engine.LlmModel}").
        </div>
    </div>;

    // ------------------------------------------------------------------ presentation helpers

    private string Money(decimal v) => (_result?.Currency ?? _currency) == "ZAR" ? $"R{v:N0}" : $"${v:N0}";

    private static (string Css, string Text) Verdict(string position) => position switch
    {
        "within" => ("mp-badge-success", "In lyn met die mark"),
        "below" => ("mp-badge-warning", "Onder die mark - moontlik te goedkoop"),
        "above" => ("mp-badge-danger", "Bo die mark - moontlik te duur"),
        _ => ("", "Geen prys ingevoer")
    };

    private static string ConfidenceText(string c) => c switch { "high" => "Hoë vertroue", "medium" => "Gemiddelde vertroue", _ => "Lae vertroue" };

    private static string EvidenceText(string e) => e switch
    {
        "published" => "Gebaseer op gepubliseerde 2026/27 Suid-Afrikaanse uitrusterpryse (internasionale mark, USD).",
        "real+published" => "Gebaseer op gepubliseerde pryse, aangevul met werklike MikPunt-data.",
        _ => "Geen gepubliseerde prysbron bestaan hiervoor nie - die skatting berus op aannames."
    };

    private static string TierText(string t) => t switch { "female" => "wyfie", "male" => "manlik", _ => "trofee" };

    private static string Pct(decimal v, decimal min, decimal max) =>
        Math.Clamp((double)((v - min) / Math.Max(1m, max - min)) * 100, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);

    private RenderFragment PriceBand(AiPriceAssessmentModel p) => @<div>
        @{
            decimal lo = Math.Min(p.P10, p.Current ?? p.P10) * 0.85m;
            decimal hi = Math.Max(p.P90, p.Current ?? p.P90) * 1.10m;
            var (css, text) = Verdict(p.Position);
        }
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <div class="fw-bold">@p.Label</div>
                <div class="ai-muted">Verwagte markprys: <strong>@Money(p.P50)</strong> (gewone band @Money(p.P10) - @Money(p.P90))</div>
            </div>
            <span class="mp-badge @css">@text@(p.DeltaPercent.HasValue ? $" ({(p.DeltaPercent > 0 ? "+" : "")}{p.DeltaPercent:0.#}%)" : "")</span>
        </div>
        <div class="ai-band">
            <div class="ai-band-range" style="left:@Pct(p.P10, lo, hi)%; width:@((double.Parse(Pct(p.P90, lo, hi), CultureInfo.InvariantCulture) - double.Parse(Pct(p.P10, lo, hi), CultureInfo.InvariantCulture)).ToString("0.#", CultureInfo.InvariantCulture))%"></div>
            <div class="ai-band-p50" style="left:@Pct(p.P50, lo, hi)%" title="Verwagte markprys"></div>
            @if (p.Current.HasValue)
            {
                <div class="ai-band-current" style="left:@Pct(p.Current.Value, lo, hi)%" data-label="@Money(p.Current.Value)"></div>
            }
        </div>
        <div class="ai-band-labels"><span>@Money(p.P10)</span><span>@Money(p.P50)</span><span>@Money(p.P90)</span></div>
        <div class="mt-2">
            <span class="ai-chip" style="@(p.Confidence == "low" ? "border-color:#f59e0b;color:#f59e0b" : "")">@ConfidenceText(p.Confidence)</span>
            <span class="ai-muted ms-1">@EvidenceText(p.Evidence)</span>
        </div>
    </div>;

    private RenderFragment Results(AiOptimizeResponseModel r) => @<div>
        @if (r.Notes.Count > 0)
        {
            <div class="alert alert-warning py-2 small">
                @foreach (var n in r.Notes) { <div>⚠️ @n</div> }
            </div>
        }

        @if (r.Price != null)
        {
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-3">Prysverdikt</h4>
                @PriceBand(r.Price)
                @if (r.Market == "domestic")
                {
                    <div class="alert alert-warning py-2 small mt-3 mb-0">Die plaaslike (ZAR) prisvlak is 'n aanname: geen gepubliseerde plaaslike pryslys kon bevestig word nie. Beskou dit as 'n ruwe aanduiding.</div>
                }
            </div>
        }

        @if (r.SpeciesPrices.Count > 0)
        {
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-3">Spesie-pryse</h4>
                @foreach (var s in r.SpeciesPrices)
                {
                    <div class="mb-3 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
                        @if (s.Price != null) { @PriceBand(s.Price) }
                        else { <div class="fw-bold">@s.Species (@TierText(s.Tier))</div><div class="ai-muted">Nie in die markkatalogus nie - geen prysskatting.</div> }
                    </div>
                }
            </div>
        }

        @if (r.AdBenchmark != null)
        {
            var b = r.AdBenchmark;
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-3">Advertensie-prestasie <span class="ai-muted">(werklike getalle)</span></h4>
                @if (b.OwnViews > 0)
                {
                    <p class="mb-1">U @b.OwnAdCount advertensie(s): <strong>@b.OwnViews</strong> kyke, <strong>@b.OwnClicks</strong> klikke - klik-koers <strong>@(b.OwnClickThroughPercent?.ToString("0.##") ?? "-")%</strong>.</p>
                }
                else
                {
                    <p class="mb-1 text-muted">U advertensies het nog geen aangetekende kyke nie, so daar is niks om mee te vergelyk nie.</p>
                }
                <p class="ai-muted mb-0">Platform-gemiddeld: @(b.PlatformClickThroughPercent?.ToString("0.##") ?? "onbekend")% · Kategorie (@b.Category): @(b.CategoryClickThroughPercent?.ToString("0.##") ?? "onbekend")% oor @b.CategoryAdCount advertensie(s).</p>
            </div>
        }

        @if (r.Narrative != null)
        {
            var n = r.Narrative;
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-2">AI-advies</h4>
                <p class="fw-bold fs-6">@n.Headline</p>

                @if (n.Tips.Count > 0)
                {
                    <h6 class="text-gold mt-3">Aanbevelings</h6>
                    @foreach (var t in n.Tips)
                    {
                        <div class="ai-tip ai-tip-@t.Priority"><div class="fw-bold small">@t.Title</div><div class="small">@t.Detail</div></div>
                    }
                }
                @if (n.TitleSuggestions.Count > 0)
                {
                    <h6 class="text-gold mt-3">Titelvoorstelle</h6>
                    @foreach (var t in n.TitleSuggestions)
                    {
                        <div class="d-flex justify-content-between align-items-center small mb-1"><span>• @t</span><button class="btn btn-sm ai-muted" @onclick="() => Copy(t)">Kopieer</button></div>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(n.DescriptionRewrite))
                {
                    <h6 class="text-gold mt-3">Verbeterde beskrywing</h6>
                    <p class="small mb-1">@n.DescriptionRewrite</p>
                    <button class="btn btn-sm ai-muted" @onclick="() => Copy(n.DescriptionRewrite)">Kopieer</button>
                }
                @if (n.InclusionSuggestions.Count > 0)
                {
                    <h6 class="text-gold mt-3">Wat om by te voeg</h6>
                    @foreach (var i in n.InclusionSuggestions)
                    {
                        <div class="small mb-1">• <strong>@i.Item</strong> <span class="ai-chip">@i.Impact</span> - @i.Why</div>
                    }
                }
                @if (n.Upsells.Count > 0)
                {
                    <h6 class="text-gold mt-3">Byverkope</h6>
                    @foreach (var u in n.Upsells)
                    {
                        <div class="small mb-1">• <strong>@u.Name</strong> - @u.Why</div>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(n.SeasonalAdvice))
                {
                    <h6 class="text-gold mt-3">Seisoen</h6>
                    <p class="small mb-0">@n.SeasonalAdvice</p>
                }
                @if (n.Risks.Count > 0)
                {
                    <h6 class="text-gold mt-3">Risiko's</h6>
                    @foreach (var x in n.Risks) { <div class="small mb-1">⚠️ @x</div> }
                }

                <div class="mt-4 pt-3 border-top" style="border-color: var(--border-color) !important;">
                    @if (_feedbackSent)
                    {
                        <span class="small text-success">Dankie vir u terugvoer - dit help die AI leer.</span>
                    }
                    else if (r.AdviceId > 0)
                    {
                        <span class="small me-2">Was hierdie advies nuttig?</span>
                        <button class="mp-btn mp-btn-secondary mp-btn-sm" @onclick="() => Feedback(true)">👍 Ja</button>
                        <button class="mp-btn mp-btn-secondary mp-btn-sm" @onclick="() => Feedback(false)">👎 Nee</button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info small">
                Die AI-skryfhulp is tans nie beskikbaar nie@(string.IsNullOrEmpty(r.NarrativeError) ? "" : $" ({r.NarrativeError})"). Die prysskatting hierbo is steeds geldig.
            </div>
        }

        @if (r.Comparables.Count > 0)
        {
            <div class="mp-card p-4">
                <h4 class="brand-font text-gold mb-3">Vergelykbare lyste op MikPunt</h4>
                <div class="table-responsive">
                    <table class="table table-sm mb-0" style="color: inherit;">
                        <thead><tr><th>Lys</th><th>Bedrag</th><th>Nota</th></tr></thead>
                        <tbody>
                            @foreach (var c in r.Comparables)
                            {
                                <tr>
                                    <td>@c.Title@(c.DurationDays.HasValue ? $" · {c.DurationDays} dae" : "")@(string.IsNullOrEmpty(c.Province) ? "" : $" · {c.Province}")</td>
                                    <td>@(c.Price.HasValue ? c.Price.Value.ToString("N0") : "-")</td>
                                    <td class="ai-muted">@c.PriceNote</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="ai-muted px-1">
            Prysmodel @(r.Engine.ModelVersion ?? "-") · Taalmodel @(string.IsNullOrEmpty(r.Engine.LlmModel) ? "-" : $"{r.Engine.LlmProvider}/{r.Engine.LlmModel}")
            @(r.Engine.LatencyMs > 0 ? $"({r.Engine.LatencyMs / 1000.0:0.#}s)" : "") · Wisselkoers R@(r.UsdToZarRate.ToString("0.00", CultureInfo.InvariantCulture))/USD.
            AI-advies kan foute bevat - kontroleer altyd self voor u publiseer.
        </div>
    </div>;
}
