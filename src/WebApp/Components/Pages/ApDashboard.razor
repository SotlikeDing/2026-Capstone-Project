@code {
    private List<AdvertisementModel> _ads = new();
    private string _filter = "All";
    private string _searchQuery = string.Empty;
    private string _sortBy = "Newest";
    private string _notificationMsg = string.Empty;

    // Delete state
    private bool _showDeleteModal = false;
    private int _adIdToDelete = 0;
    private string _adTitleToDelete = string.Empty;

    // Invoice state
    private bool _showInvoiceModal = false;
    private AdvertisementModel? _selectedAdForInvoice;
    private AdPaymentReceiptModel? _selectedReceiptForInvoice;
    private bool _openedFromAllReceipts = false;

    // All Receipts state (per advertensie)
    private bool _showAllReceiptsModal = false;
    private string _receiptSearchQuery = string.Empty;
    private AdvertisementModel? _selectedAdForReceipts;

    /// <summary>Opens the "all receipts for this ad" modal, scoped to a single ad's payment history.</summary>
    public void OpenReceiptsForAd(AdvertisementModel ad)
    {
        _selectedAdForReceipts = ad;
        _receiptSearchQuery = string.Empty;
        _showAllReceiptsModal = true;
    }

    /// <summary>Flattened view of one payment/receipt, joined back to its parent ad for display in the receipts table/invoice.</summary>
    public class UserAdReceiptViewItem
    {
        public int AdId { get; set; }
        public string AdTitle { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string AdvertiserName { get; set; } = string.Empty;
        public string PaymentRef { get; set; } = string.Empty;
        public DateTime PaymentDate { get; set; }
        public int Months { get; set; }
        public decimal Amount { get; set; }
        public DateTime PeriodStartDate { get; set; }
        public DateTime PeriodEndDate { get; set; }
        public AdvertisementModel Ad { get; set; } = default!;
    }

    /// <summary>
    /// Receipts for the currently selected ad (_selectedAdForReceipts), one per
    /// PaymentHistory entry if present; falls back to synthesizing a single receipt from
    /// the ad's own TotalPaidAmount/PaymentRef fields for ads that predate the
    /// PaymentHistory list being added, so older paid ads still show a receipt.
    /// </summary>
    private List<UserAdReceiptViewItem> AdReceipts
    {
        get
        {
            var list = new List<UserAdReceiptViewItem>();
            var ad = _selectedAdForReceipts;
            if (ad == null) return list;

            if (ad.PaymentHistory != null && ad.PaymentHistory.Count > 0)
            {
                foreach (var rc in ad.PaymentHistory)
                {
                    list.Add(new UserAdReceiptViewItem
                    {
                        AdId = ad.Id,
                        AdTitle = ad.Title,
                        Category = ad.Category,
                        AdvertiserName = ad.AdvertiserName,
                        PaymentRef = !string.IsNullOrWhiteSpace(rc.PaymentRef) ? rc.PaymentRef : $"MP-ADPAY-{ad.Id:D6}",
                        PaymentDate = rc.PaymentDate,
                        Months = rc.Months > 0 ? rc.Months : 1,
                        Amount = rc.Amount > 0 ? rc.Amount : 100m,
                        PeriodStartDate = rc.PeriodStartDate,
                        PeriodEndDate = rc.PeriodEndDate,
                        Ad = ad
                    });
                }
            }
            else if ((ad.PaymentStatus == "Betaal / Aktief" || ad.PaymentStatus == "Active") && (ad.TotalPaidAmount > 0 || !string.IsNullOrWhiteSpace(ad.PaymentRef)))
            {
                list.Add(new UserAdReceiptViewItem
                {
                    AdId = ad.Id,
                    AdTitle = ad.Title,
                    Category = ad.Category,
                    AdvertiserName = ad.AdvertiserName,
                    PaymentRef = !string.IsNullOrWhiteSpace(ad.PaymentRef) ? ad.PaymentRef : $"MP-ADPAY-{ad.Id:D6}",
                    PaymentDate = ad.PaymentDate ?? ad.StartDate,
                    Months = ad.LastPaymentMonths > 0 ? ad.LastPaymentMonths : (int)Math.Max(1, ad.TotalPaidAmount / 100m),
                    Amount = ad.LastPaymentAmount > 0 ? ad.LastPaymentAmount : ad.TotalPaidAmount,
                    PeriodStartDate = ad.LastPaymentStartDate ?? ad.StartDate,
                    PeriodEndDate = ad.LastPaymentEndDate ?? ad.EndDate,
                    Ad = ad
                });
            }
            return list.OrderByDescending(r => r.PaymentDate).ThenByDescending(r => r.PaymentRef).ToList();
        }
    }

    /// <summary>AdReceipts filtered by _receiptSearchQuery (ref/title/category/advertiser name) - backs the receipts-table search box.</summary>
    private IEnumerable<UserAdReceiptViewItem> FilteredAdReceipts
    {
        get
        {
            var receipts = AdReceipts.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_receiptSearchQuery))
            {
                var q = _receiptSearchQuery.Trim();
                receipts = receipts.Where(r =>
                    r.PaymentRef.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.AdTitle.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.Category.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.AdvertiserName.Contains(q, StringComparison.OrdinalIgnoreCase)
                );
            }
            return receipts;
        }
    }

    /// <summary>Ads scoped to the signed-in advertiser; Admin sees every ad unfiltered (dashboard doubles as an admin ad-overview when opened by an Admin account).</summary>
    private IEnumerable<AdvertisementModel> UserScopedAds
    {
        get
        {
            var list = _ads.AsEnumerable();
            if (!Auth.HasRole("Admin"))
            {
                int? currentUserId = Auth.CurrentUser?.UserId;
                if (currentUserId.HasValue && currentUserId.Value > 0)
                {
                    list = list.Where(a => a.AdvertiserUserId == currentUserId.Value);
                }
            }
            return list;
        }
    }

    private List<AdvertisementModel> ExpiringSoonAds =>
        UserScopedAds.Where(a => a.IsActive && a.EndDate >= DateTime.Today && a.EndDate <= DateTime.Today.AddDays(7)).ToList();

    private int TotalImpressions => UserScopedAds.Sum(a => a.ImpressionsCount);
    private int TotalClicks => UserScopedAds.Sum(a => a.ClicksCount);
    private double OverallCtr => TotalImpressions > 0 ? ((double)TotalClicks / TotalImpressions * 100) : 0.0;
    private decimal TotalInvestment => UserScopedAds.Sum(a =>
    {
        if (a.PaymentHistory != null && a.PaymentHistory.Count > 0)
        {
            return a.PaymentHistory.Sum(p => p.Amount);
        }
        return a.TotalPaidAmount;
    });

    /// <summary>Opens the printable tax-invoice modal for an ad, defaulting to its most recent payment when a specific receipt isn't given.</summary>
    private void OpenInvoiceModal(AdvertisementModel ad, AdPaymentReceiptModel? specificReceipt = null)
    {
        _selectedAdForInvoice = ad;
        _selectedAdForReceipts = ad;
        _selectedReceiptForInvoice = specificReceipt 
            ?? (ad.PaymentHistory != null && ad.PaymentHistory.Count > 0 ? ad.PaymentHistory.First() : null);
        _openedFromAllReceipts = false;
        _showInvoiceModal = true;
    }

    /// <summary>Drills from the "all receipts for this ad" table into the invoice view for one specific past payment (tracks _openedFromAllReceipts so the invoice modal can show a "back" button).</summary>
    private void OpenReceiptFromList(UserAdReceiptViewItem item)
    {
        _selectedAdForInvoice = item.Ad;
        _selectedAdForReceipts = item.Ad;
        _selectedReceiptForInvoice = new AdPaymentReceiptModel
        {
            PaymentRef = item.PaymentRef,
            PaymentDate = item.PaymentDate,
            Months = item.Months,
            Amount = item.Amount,
            PeriodStartDate = item.PeriodStartDate,
            PeriodEndDate = item.PeriodEndDate
        };
        _openedFromAllReceipts = true;
        _showAllReceiptsModal = false;
        _showInvoiceModal = true;
    }

    /// <summary>Closes the invoice modal and reopens the per-ad receipts list it was opened from.</summary>
    private void BackToAllReceipts()
    {
        _showInvoiceModal = false;
        if (_selectedAdForInvoice != null)
        {
            _selectedAdForReceipts = _selectedAdForInvoice;
        }
        _showAllReceiptsModal = true;
    }

    /// <summary>Switches which past payment the invoice modal is currently displaying, via the "other payments" quick-switcher buttons.</summary>
    private void SelectReceiptForInvoice(AdPaymentReceiptModel receipt)
    {
        _selectedReceiptForInvoice = receipt;
    }

    private decimal _adMonthlyPrice = 100m;

    /// <summary>Loads the flat ad price, redirects the legacy /ap/ads route, and loads the advertiser's ads.</summary>
    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += HandleAuthChanged;
        _adMonthlyPrice = (await Api.GetPublicSettingsAsync()).AdMonthlyPrice;

        // If accessed via /ap/advertensies (or legacy /ap/ads), redirect to /ap/paneelbord
        var relativeUri = Nav.ToBaseRelativePath(Nav.Uri);
        if (relativeUri.StartsWith("ap/ads", StringComparison.OrdinalIgnoreCase) || relativeUri.StartsWith("ap/advertensies", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/ap/paneelbord", replace: true);
        }

        await LoadDataAsync();
    }

    /// <summary>Re-runs the data load when auth state changes (e.g. login completes after this page rendered its "please sign in" gate) — subscribed in OnInitializedAsync, unsubscribed in Dispose.</summary>
    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    /// <summary>Cache-then-network load: renders instantly from Api's in-memory ad cache if warm, then refreshes from the API and re-renders.</summary>
    private async Task LoadDataAsync()
    {
        if (Auth.IsAuthenticated && (Auth.HasRole("AP") || Auth.HasRole("Admin")))
        {
            int? currentUserId = Auth.CurrentUser?.UserId;
            bool isAdmin = Auth.HasRole("Admin");
            int? effectiveUserId = isAdmin ? (int?)null : currentUserId;

            // 1. Fast-path: immediately load from in-memory cache with 0 delay
            var cached = Api.GetCachedAds(userId: effectiveUserId);
            if (cached != null && cached.Count > 0)
            {
                _ads = FilterAdsForScope(cached, effectiveUserId, currentUserId, isAdmin);
            }

            // 2. Refresh from API in background
            try
            {
                var all = await Api.GetAdsAsync(userId: effectiveUserId);
                if (all != null && all.Count > 0)
                {
                    _ads = FilterAdsForScope(all, effectiveUserId, currentUserId, isAdmin);
                    // The shared ads cache may lack this user's receipts - load them for this circuit.
                    await Api.RefreshAdPaymentHistoryAsync(_ads);
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    /// <summary>Re-applies advertiser-ownership scoping to a freshly-fetched ad list (the API call itself already scopes by userId, but this is a defensive second filter).</summary>
    private List<AdvertisementModel> FilterAdsForScope(List<AdvertisementModel> all, int? effectiveUserId, int? currentUserId, bool isAdmin)
    {
        if (!isAdmin && currentUserId.HasValue && currentUserId.Value > 0)
        {
            return all.Where(a => a.AdvertiserUserId == currentUserId.Value).ToList();
        }
        return all;
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= HandleAuthChanged;
    }

    /// <summary>UserScopedAds narrowed by the active filter tab (All/Active/Pending), the search box, and the chosen sort order — feeds the campaigns table directly.</summary>
    private List<AdvertisementModel> FilteredAds
    {
        get
        {
            var list = UserScopedAds;

            // 1. Status Filter Tab
            if (_filter == "Active")
                list = list.Where(a => a.IsActive && a.EndDate >= DateTime.Today);
            else if (_filter == "Pending")
                list = list.Where(a => !a.IsActive || a.PaymentStatus == "Pending Payment" || a.EndDate < DateTime.Today);

            // 2. Search Query Filter
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim();
                list = list.Where(a => 
                    (a.Title?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.AdvertiserName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.Category?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.PaymentRef?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            // 3. Sorting
            list = _sortBy switch
            {
                "ExpiringSoon" => list.OrderBy(a => a.EndDate),
                "MostViews" => list.OrderByDescending(a => a.ImpressionsCount),
                "MostClicks" => list.OrderByDescending(a => a.ClicksCount),
                "HighestInvestment" => list.OrderByDescending(a => a.TotalPaidAmount),
                _ => list.OrderByDescending(a => a.Id)
            };

            return list.ToList();
        }
    }

    /// <summary>Opens the delete-confirmation modal for a given ad, deferring the actual delete until confirmed.</summary>
    private void PromptDelete(int id, string title)
    {
        _adIdToDelete = id;
        _adTitleToDelete = title;
        _showDeleteModal = true;
    }

    /// <summary>Deletes the ad selected via PromptDelete and reloads the list. Admin can delete any ad (userId passed as null bypasses ownership check server-side); a non-admin deletes only their own.</summary>
    private async Task ConfirmDeleteAd()
    {
        if (_adIdToDelete > 0)
        {
            int? userId = Auth.HasRole("Admin") ? (int?)null : Auth.CurrentUser?.UserId;
            await Api.DeleteAdAsync(_adIdToDelete, userId: userId);
            _notificationMsg = $"Die advertensie '{_adTitleToDelete}' is suksesvol verwyder.";
            _showDeleteModal = false;
            _adIdToDelete = 0;
            _adTitleToDelete = string.Empty;
            await LoadDataAsync();
        }
    }
}
