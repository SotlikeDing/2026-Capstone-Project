@* AP (Adverteerder/Advertiser) dashboard - routes /ap/dashboard and legacy /ap/ads (which
   redirects to /ap/dashboard, see OnInitializedAsync). Restricted to users with the "AP"
   role (or Admin). Lets an advertiser create/pay-for/edit/delete/renew ad campaigns, see
   impressions/clicks/CTR/investment stats, and view/print tax-invoice-style receipts for
   past payments. Ads are paid via the PayFast-simulation flow (see Payment.razor /
   AdPaymentSimulation.razor) at a flat rate (_adMonthlyPrice, loaded from
   GetPublicSettingsAsync) per month. *@
@page "/ap/paneelbord"
@page "/ap/advertensies"
@page "/ap/dashboard"
@page "/ap/ads"
@inject MikpuntApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>AP Adverteerderportaal &amp; Veldtogte | MikPunt</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="mp-card text-center p-5">
        <div class="spinner-border text-gold mb-3" role="status"></div>
        <div class="fs-4 text-gold">Verifieer tans toegang...</div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Teken asseblief eers in</h3>
        <p class="text-muted mb-4">Die Adverteerders (AP) Portaal is slegs toeganklik vir geregistreerde en aangemelde lede.</p>
        <a href="/teken-in?returnUrl=/ap/paneelbord" class="mp-btn mp-btn-primary">Teken In &rarr;</a>
    </div>
}
else if (!Auth.HasRole("AP") && !Auth.HasRole("Admin"))
{
    <div class="mp-card text-center p-5">
        <div class="mp-brand-logo mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h3 class="brand-font text-gold mb-2">Toegang Beperk: Adverteerder (AP) Rol Benodig</h3>
        <p class="text-muted mb-4 max-w-700 mx-auto" style="max-width: 600px;">
            U rekening is tans nie geregistreer as 'n <strong>Adverteerder (AP)</strong> nie. U kan hierdie rol op u profiel aktiveer om produkte, toerusting en dienste aan die jagter- en plaasgemeenskap te bemark.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/profiel" class="mp-btn mp-btn-primary">+ Aktiveer AP Rol op Profiel &rarr;</a>
            <a href="/rolle" class="mp-btn mp-btn-secondary">Lees Rollegids</a>
        </div>
    </div>
}
else
{
    <div class="no-print">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
            <div class="me-3">
                <h1 class="brand-font text-gold mb-1">Adverteerders (AP) Portaal &amp; Veldtogte</h1>
                <p class="text-muted mb-0 small">Skep, betaal, wysig, verleng en monitor al jou kommersiële adverteringsveldtogte (R@_adMonthlyPrice.ToString("N0")/maand).</p>
                <AiHelperLinks RoleCode="AP" />
            </div>

            <div class="d-flex gap-2 flex-shrink-0 align-items-center flex-wrap">
                <a href="/advertensies" class="mp-btn mp-btn-secondary mp-btn-sm text-nowrap">
                    Verken Markplein ↗
                </a>
                <a href="/ap/nuwe-advertensie" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">
                    + Plaas Nuwe Advertensie
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_notificationMsg))
        {
            <div class="alert alert-success alert-dismissible fade show p-3 mb-4 d-flex justify-content-between align-items-center">
                <div>@_notificationMsg</div>
                <button type="button" class="btn-close btn-close-white" @onclick='() => _notificationMsg = ""'></button>
            </div>
        }

        <!-- Expiry Alert Banner (if any ads expiring within 7 days) -->
        @if (ExpiringSoonAds.Count > 0)
        {
            <div class="alert alert-warning p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2" 
                 style="background: rgba(217, 119, 6, 0.18); border: 1.5px solid #f59e0b; color: #fef3c7; border-radius: 8px;">
                <div class="d-flex align-items-center gap-3">
                    <div style="font-size: 24px;">⚠️</div>
                    <div>
                        <strong class="d-block" style="color: #ffffff; font-size: 15px;">
                            Kennisgewing: @ExpiringSoonAds.Count @(ExpiringSoonAds.Count == 1 ? "advertensie verval" : "advertensies verval") binne die volgende 7 dae!
                        </strong>
                        <div class="small" style="color: #e5e7eb;">
                            Verleng vroegtydig teen R@_adMonthlyPrice.ToString("N0")/maand om deurlopende blootstelling op die markplein te verseker sonder onderbreking.
                        </div>
                    </div>
                </div>
                <a href="/ap/betaal-advertensie/@ExpiringSoonAds.First().Id" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">
                    Verleng Nou (@ExpiringSoonAds.First().Title) &rarr;
                </a>
            </div>
        }

        <!-- Pricing Policy Banner -->
        <div class="p-3 rounded mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 mp-pricing-banner" 
             style="background: rgba(35, 20, 10, 0.88); border: 1.5px solid #d97706; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <div class="d-flex align-items-center gap-3">
                <div style="color: #f59e0b;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                </div>
                <div>
                    <strong class="d-block text-white fw-bold" style="font-size: 16px; color: #ffffff !important;">Vaste Advertering Tarief: R@_adMonthlyPrice.ToString("N0") / maand per advertensie</strong>
                    <div class="small" style="color: #e5e7eb;">
                        Elke advertensie vereis 'n fooi van R@_adMonthlyPrice.ToString("N0")/maand vir die gekose tydperk voor publisering.
                    </div>
                </div>
            </div>
            <a href="/ap/nuwe-advertensie" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">Plaas Advertensie Nou &rarr;</a>
        </div>

        <!-- Stat Metrics Row 1: 4 Cards -->
        <div class="mp-grid-4 mb-3">
            <div class="mp-card text-center">
                <div class="fs-2 text-gold font-bold">@UserScopedAds.Count()</div>
                <div class="small text-muted text-uppercase fw-bold">Totale Veldtogte</div>
            </div>
            <div class="mp-card text-center">
                <div class="fs-2 text-success font-bold">@UserScopedAds.Count(a => a.IsActive && a.EndDate >= DateTime.Today)</div>
                <div class="small text-muted text-uppercase fw-bold">Aktiewe Advertensies</div>
            </div>
            <div class="mp-card text-center">
                <div class="fs-2 text-warning font-bold">@UserScopedAds.Count(a => !a.IsActive || a.PaymentStatus == "Pending Payment" || a.EndDate < DateTime.Today)</div>
                <div class="small text-muted text-uppercase fw-bold">Wag op Betaling</div>
            </div>
            <div class="mp-card text-center">
                <div class="fs-2 text-gold font-bold">@TotalImpressions.ToString("N0")</div>
                <div class="small text-muted text-uppercase fw-bold">Totale Vertonings</div>
            </div>
        </div>

        <!-- Stat Metrics Row 2: Centralized 3 Performance Cards -->
        <div class="d-flex justify-content-center gap-3 flex-wrap mb-4">
            <div class="mp-card text-center" style="min-width: 240px; max-width: 320px; flex: 1 1 240px;">
                <div class="fs-2 text-gold font-bold">@TotalClicks.ToString("N0")</div>
                <div class="small text-muted text-uppercase fw-bold">Totale Klikke</div>
                <div class="small text-muted mt-1" style="font-size: 11px;">Besoekers na skakels</div>
            </div>
            <div class="mp-card text-center" style="min-width: 240px; max-width: 320px; flex: 1 1 240px;">
                <div class="fs-2 text-gold font-bold">@OverallCtr.ToString("F1")%</div>
                <div class="small text-muted text-uppercase fw-bold">Gemiddelde CTR (Deurklik)</div>
                <div class="small text-success mt-1" style="font-size: 11px;">
                    @(OverallCtr >= 5.0 ? "Uitstekende Bereik ⭐" : OverallCtr >= 2.0 ? "Goeie Prestasie 👍" : "Aktiewe Blootstelling 📈")
                </div>
            </div>
            <div class="mp-card text-center" style="min-width: 240px; max-width: 320px; flex: 1 1 240px;">
                <div class="fs-2 text-success font-bold text-nowrap">R @TotalInvestment.ToString("N0")</div>
                <div class="small text-muted text-uppercase fw-bold">Totale Belegging</div>
                <div class="small text-muted mt-1" style="font-size: 11px;">Aktiewe veldtogbelegging</div>
            </div>
        </div>

        <!-- Quick Action Navigation Cards -->
        <div class="mp-grid mb-4">
            <a href="/ap/nuwe-advertensie" class="mp-card text-decoration-none" style="border: 2px solid var(--accent-gold);">
                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                    <h3 class="brand-font text-gold mb-0 text-nowrap">Plaas Advertensie</h3>
                    <span class="badge bg-warning text-dark text-nowrap flex-shrink-0">R@_adMonthlyPrice.ToString("N0") / mnd</span>
                </div>
                <p class="text-muted small mb-0">Skep teiken advertensies vir jagters en boere en aktiveer via veilige betaling.</p>
            </a>

            <div class="mp-card text-decoration-none" style="border: 1px solid var(--border-color);">
                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                    <h3 class="brand-font text-gold mb-0 text-nowrap">Bestuur Veldtogte</h3>
                </div>
                <p class="text-muted small mb-0">Verleng tydsduur, wysig prentskakel, monitor en bestuur veldtogte in die tabel hieronder &darr;</p>
            </div>
        </div>

        <!-- Full Detailed Campaigns Table with Search, Filter Tabs & Sorting -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
            <!-- Filter Tabs -->
            <div class="d-flex gap-2 flex-wrap">
                <button class="mp-btn @(_filter == "All" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _filter = "All"'>
                    Alle Veldtogte (@_ads.Count)
                </button>
                <button class="mp-btn @(_filter == "Active" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _filter = "Active"'>
                    Aktief (@_ads.Count(a => a.IsActive && a.EndDate >= DateTime.Today))
                </button>
                <button class="mp-btn @(_filter == "Pending" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _filter = "Pending"'>
                    Wag op Betaling (@_ads.Count(a => !a.IsActive || a.PaymentStatus == "Pending Payment" || a.EndDate < DateTime.Today))
                </button>
            </div>

            <!-- Search & Sort Controls -->
            <div class="d-flex gap-2 align-items-center flex-wrap flex-grow-1 justify-content-md-end">
                <div class="mp-search-box">
                    <span class="mp-search-icon">🔍</span>
                    <input type="text" 
                           class="mp-search-input" 
                           placeholder="Soek veldtogte, borg, kontak, ref..." 
                           @bind="_searchQuery" 
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button type="button" class="mp-search-clear" 
                                @onclick='() => _searchQuery = ""' title="Maak soektog skoon">✕</button>
                    }
                </div>

                <select class="mp-select" style="width: auto;" @bind="_sortBy">
                    <option value="Newest">Sorteer: Nuutste Eerste</option>
                    <option value="ExpiringSoon">Sorteer: Verval Binnekort</option>
                    <option value="MostViews">Sorteer: Meeste Vertonings</option>
                    <option value="MostClicks">Sorteer: Meeste Klikke</option>
                    <option value="HighestInvestment">Sorteer: Hoogste Belegging</option>
                </select>
            </div>
        </div>

        <!-- Table View of Ads -->
        @if (FilteredAds.Count == 0)
        {
            <div class="mp-card p-5 text-center mb-4">
                <div class="display-6 mb-3">📢</div>
                <h4 class="brand-font text-gold">Geen Veldtogte Gevind Nie</h4>
                <p class="text-muted">Daar is tans geen advertensies wat ooreenstem met u filterkriteria nie.</p>
                <a href="/ap/nuwe-advertensie" class="mp-btn mp-btn-primary mt-2">+ Plaas Jou Eerste Advertensie</a>
            </div>
        }
        else
        {
            <div class="mp-card p-0 mb-4" style="width: 100%; overflow: hidden;">
                <table class="mp-table mp-table-compact align-middle w-100" style="margin: 0; width: 100%; table-layout: fixed;">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Veldtog &amp; Borg</th>
                            <th style="width: 11%; text-align: center;">Kategorie</th>
                            <th style="width: 14%;">Geldigheid &amp; Tydperk</th>
                            <th style="width: 14%;">Betaling &amp; Fooi</th>
                            <th style="width: 6%; text-align: center;">Vertonings</th>
                            <th style="width: 6%; text-align: center;">Klikke</th>
                            <th style="width: 8%; text-align: center;">Status</th>
                            <th class="text-end" style="width: 16%;">Aksies</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in FilteredAds)
                        {
                            var isExpired = a.EndDate < DateTime.Today;
                            var isPending = !a.IsActive || a.PaymentStatus == "Pending Payment";
                            var daysLeft = Math.Max(0, (a.EndDate - DateTime.Today).Days);
                            var isExpiringSoon = a.IsActive && !isExpired && daysLeft <= 7;

                            <tr style="@(isExpiringSoon ? "background: rgba(245, 158, 11, 0.06);" : "")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(a.ImageUrls.Count > 0 ? a.ImageUrls[0] : "images/savanna_sunrise.jpg")" 
                                             alt="@a.Title" 
                                             class="rounded"
                                             style="width: 38px; height: 38px; object-fit: cover; border: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;" />
                                        <div class="text-truncate" style="min-width: 0;">
                                            <strong class="d-block text-gold text-truncate" style="font-size: 13px;" title="@a.Title">@a.Title</strong>
                                            <div class="small text-muted text-truncate" style="font-size: 11px;">@a.AdvertiserName</div>
                                            @if (!string.IsNullOrEmpty(a.ContactNumber))
                                            {
                                                <div class="small text-muted font-monospace text-truncate" style="font-size: 10px;">📞 @a.ContactNumber</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary d-inline-block text-wrap" style="max-width: 90px; line-height: 1.25; padding: 4px 6px; font-size: 11px; white-space: normal;">
                                        @((MarkupString)MikpuntApiService.FormatCategory(a.Category).Replace(" & ", "<br/>& "))
                                    </span>
                                </td>
                                <td>
                                    @if (isPending)
                                    {
                                        <span class="text-muted small d-block">Onaktief (Wag)</span>
                                        <div class="small text-muted" style="font-size: 11px;">1 Mnd Veldtog</div>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="text-danger small fw-bold d-block">Verval: @a.EndDate.ToString("dd/MM/yyyy")</span>
                                        <div class="small text-muted" style="font-size: 11px;">0 dae oor</div>
                                    }
                                    else
                                    {
                                        <span class="text-success small fw-bold d-block">Tot: @a.EndDate.ToString("dd/MM/yyyy")</span>
                                        <div class="small @(isExpiringSoon ? "text-warning fw-bold" : "text-muted")" style="font-size: 11px;">
                                            @daysLeft @(daysLeft == 1 ? "dag" : "dae") oor @(isExpiringSoon ? "⚠️" : "")
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (isPending)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 10.5px;">Wag op Betaling</span>
                                        <div class="small text-muted mt-1" style="font-size: 11px;">R 100 / maand</div>
                                    }
                                    else
                                    {
                                        var displayPaymentRef = !string.IsNullOrWhiteSpace(a.PaymentRef) && a.PaymentRef.StartsWith("MP-ADPAY-")
                                            ? a.PaymentRef
                                            : $"MP-ADPAY-{a.Id:D6}";

                                        <span class="badge bg-success" style="font-size: 10.5px;">Betaal (R @a.TotalPaidAmount.ToString("N0"))</span>
                                        <div class="text-muted font-monospace text-truncate mt-1" style="font-size: 10px;" title="@displayPaymentRef">@displayPaymentRef</div>
                                        <button type="button" class="btn btn-link p-0 text-gold text-decoration-none small d-inline-block mt-1 fw-bold" 
                                                style="font-size: 11px;" @onclick="() => OpenInvoiceModal(a)" title="Bekyk en druk amptelike faktuur/kwitansie">
                                            🧾 Faktuur
                                        </button>
                                    }
                                </td>
                                <td class="text-center"><strong>@a.ImpressionsCount.ToString("N0")</strong></td>
                                <td class="text-center"><strong>@a.ClicksCount.ToString("N0")</strong></td>
                                <td class="text-center">
                                    @if (a.IsActive && !isExpired)
                                    {
                                        <span class="mp-badge mp-badge-success" style="font-size: 10.5px; padding: 2px 6px;">Aktief</span>
                                    }
                                    else if (isPending)
                                    {
                                        <span class="mp-badge mp-badge-warning" style="font-size: 10.5px; padding: 2px 6px;">Wag</span>
                                    }
                                    else
                                    {
                                        <span class="mp-badge mp-badge-danger" style="font-size: 10.5px; padding: 2px 6px;">Verval</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1 flex-wrap">
                                        <a href="/advertensies/@a.Id" class="mp-btn mp-btn-secondary mp-btn-xs" title="Bekyk lewendige advertensie op markplein">
                                            Bekyk
                                        </a>

                                        @if (isPending)
                                        {
                                            <a href="/ap/betaal-advertensie/@a.Id" class="mp-btn mp-btn-primary mp-btn-xs">
                                                Betaal
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="/ap/betaal-advertensie/@a.Id" class="mp-btn mp-btn-primary mp-btn-xs">
                                                Verleng
                                            </a>
                                        }

                                        <button type="button" class="mp-btn mp-btn-secondary mp-btn-xs" 
                                                @onclick="() => OpenReceiptsForAd(a)" 
                                                title="Bekyk alle kwitansies vir hierdie advertensie">
                                            Kwitansies
                                        </button>

                                        <a href="/ap/wysig-advertensie/@a.Id" class="mp-btn mp-btn-secondary mp-btn-xs">
                                            Wysig
                                        </a>

                                        <button class="mp-btn mp-btn-danger mp-btn-xs" @onclick="() => PromptDelete(a.Id, a.Title)">
                                            Skrap
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal)
{
    <div class="modal fade show d-block no-print" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content mp-card p-4" style="border: 1px solid var(--accent-gold);">
                <h4 class="brand-font text-gold mb-3">Bevestig Skrapping van Advertensie</h4>
                <p class="text-muted mb-4">
                    Is u seker u wil die advertensie <strong>"@_adTitleToDelete"</strong> permanent verwyder? Hierdie aksie kan nie ongedaan gemaak word nie.
                </p>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="mp-btn mp-btn-secondary" @onclick="() => _showDeleteModal = false">Kanselleer</button>
                    <button type="button" class="mp-btn mp-btn-danger" @onclick="ConfirmDeleteAd">Ja, Skrap Advertensie</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Official Tax Invoice & Receipt Modal -->
@if (_showInvoiceModal && _selectedAdForInvoice != null)
{
    var currentReceipt = _selectedReceiptForInvoice 
        ?? (_selectedAdForInvoice.PaymentHistory != null && _selectedAdForInvoice.PaymentHistory.Count > 0 
            ? _selectedAdForInvoice.PaymentHistory.First() 
            : null);

    var invRef = currentReceipt?.PaymentRef 
        ?? (!string.IsNullOrWhiteSpace(_selectedAdForInvoice.PaymentRef) && _selectedAdForInvoice.PaymentRef.StartsWith("MP-ADPAY-")
            ? _selectedAdForInvoice.PaymentRef
            : $"MP-ADPAY-{_selectedAdForInvoice.Id:D6}");

    var invMonths = currentReceipt?.Months 
        ?? (_selectedAdForInvoice.LastPaymentMonths > 0 
            ? _selectedAdForInvoice.LastPaymentMonths 
            : (_selectedAdForInvoice.TotalPaidAmount > 0 
                ? (int)Math.Max(1, _selectedAdForInvoice.TotalPaidAmount / 100m) 
                : Math.Max(1, _selectedAdForInvoice.DurationMonths)));

    var invAmount = currentReceipt?.Amount 
        ?? (_selectedAdForInvoice.LastPaymentAmount > 0 
            ? _selectedAdForInvoice.LastPaymentAmount 
            : _selectedAdForInvoice.TotalPaidAmount);

    var paymentDate = currentReceipt?.PaymentDate 
        ?? (_selectedAdForInvoice.PaymentDate ?? DateTime.Today);

    var paymentDateFormatted = paymentDate.ToString("dd MMMM yyyy");

    var periodStart = currentReceipt?.PeriodStartDate 
        ?? _selectedAdForInvoice.LastPaymentStartDate 
        ?? _selectedAdForInvoice.StartDate;

    var periodEnd = currentReceipt?.PeriodEndDate 
        ?? _selectedAdForInvoice.LastPaymentEndDate 
        ?? _selectedAdForInvoice.EndDate;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.85); z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content mp-invoice-paper p-4 p-md-5 mp-invoice-scroll" id="adInvoicePrintArea"
                 style="background-color: #ffffff !important; color: #000000 !important; border: 2px solid #b45309;">
                <!-- Navigation & Quick Switcher for Multi-Receipts -->
                @if (_openedFromAllReceipts || (_selectedAdForInvoice.PaymentHistory != null && _selectedAdForInvoice.PaymentHistory.Count > 1))
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom mp-inv-divider flex-wrap gap-2 no-print" style="border-color: #cbd5e1 !important;">
                        <div>
                            @if (_openedFromAllReceipts)
                            {
                                <button type="button" class="mp-btn mp-inv-btn-close mp-btn-xs d-inline-flex align-items-center gap-1" 
                                        style="background: #e2e8f0; color: #000000 !important; font-weight: 700; border: 1px solid #94a3b8;" 
                                        @onclick="BackToAllReceipts">
                                    &larr; Terug na Alle Kwitansies
                                </button>
                            }
                            else
                            {
                                <button type="button" class="mp-btn mp-inv-btn-close mp-btn-xs d-inline-flex align-items-center gap-1" 
