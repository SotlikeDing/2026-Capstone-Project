                                    <div class="small text-muted mt-1" style="font-size: 11px;">Gevaarlike wildgidsing (Buffel, Olifant, Leeu, Renoster, Luiperd)</div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 4. VIDEOGRAAF (VG) -->
                    @if (_roleForm.SelectedRoleCode == "VG")
