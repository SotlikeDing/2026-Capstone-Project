@* /profile - authenticated-user self-service page (any logged-in user, any role or no
   role yet). Three jobs in one page: (1) edit personal contact/ID details used for
   SAPS 520 / permit paperwork, (2) activate additional roles (Jagter/PJ/PH/VG/Boer/AP)
   via a role-specific accreditation form plus document upload (PJ/PH/VG/Boer require
   documents, gated by PendingDocumentUploads/UserDocumentsController - already
   documented server-side), and (3) remove a role or delete the whole account. Also
   surfaces each paid-role's monthly advertising-subscription status inline. *@
@page "/profiel"
@page "/profile"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text.RegularExpressions
@inject AuthService Auth
@inject MikpuntApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>My Profiel &amp; Rolbestuur | MikPunt</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="p-5 text-center"><div class="spinner-border text-gold"></div></div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-3">Teken asseblief eers in om jou profiel en rolle te bestuur.</h3>
        <a href="/teken-in" class="mp-btn mp-btn-primary">Teken In &rarr;</a>
    </div>
}
else
{
    var u = Auth.CurrentUser!;

    <!-- Guide Alert Banner -->
    <div class="mp-card p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background: rgba(217, 119, 6, 0.08); border-left: 4px solid var(--accent-gold);">
        <div>
            <strong class="text-gold">Nuuskierig oor wat elke rol kan doen?</strong>
            <span class="text-muted ms-1 small">Leer hoe Boere, Uitrusters, PH's, Videograwe, Adverteerders en Jagters saamwerk.</span>
        </div>
        <a href="/rolle" class="mp-btn mp-btn-secondary mp-btn-sm">
            Lees die Rol- &amp; Ekosisteem Gids &rarr;
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_roleSuccessMsg))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Sukses!</strong> @_roleSuccessMsg
            <button type="button" class="btn-close" @onclick="() => _roleSuccessMsg = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_roleErrorMsg))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <strong>Fout:</strong> @_roleErrorMsg
            <button type="button" class="btn-close" @onclick="() => _roleErrorMsg = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: User Overview & Active Roles -->
        <div class="col-md-5">
            <!-- Profile Overview Card -->
            <div class="mp-card text-center p-4 mb-4">
                <div class="position-relative mx-auto mb-3" style="width: 100px; height: 100px;">
                    @if (!string.IsNullOrEmpty(_model.ProfilePictureUrl ?? u.ProfilePictureUrl))
                    {
                        <img src="@(_model.ProfilePictureUrl ?? u.ProfilePictureUrl)" alt="Profiel Foto" 
                             class="rounded-circle shadow" 
                             style="width: 100px; height: 100px; object-fit: cover; border: 3px solid var(--accent-gold);" />
                    }
                    else
                    {
                        <div class="mp-brand-logo rounded-circle mx-auto d-flex align-items-center justify-content-center" 
                             style="width: 100px; height: 100px; font-size: 38px; border: 3px solid var(--accent-gold);">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    <label class="mp-btn mp-btn-secondary mp-btn-sm mb-0 cursor-pointer" style="cursor: pointer;">
                        <InputFile OnChange="HandleProfilePicSelected" accept="image/png,image/jpeg,image/webp" style="display: none;" />
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                        Verander Foto
                    </label>
                    @if (!string.IsNullOrEmpty(_model.ProfilePictureUrl ?? u.ProfilePictureUrl))
                    {
                        <button type="button" class="mp-btn mp-btn-danger mp-btn-sm" @onclick="RemoveProfilePic">
                            Verwyder
                        </button>
                    }
                </div>

                <h2 class="brand-font text-gold mb-1" style="font-size: 22px;">@(string.IsNullOrWhiteSpace(u.FullName) || u.FullName == "Lid" ? "My Profiel" : u.FullName)</h2>
                <p class="text-muted mb-2 small">@u.Email</p>
                <div class="mb-3">
                    <span class="mp-badge mp-badge-success d-inline-flex align-items-center gap-1 px-3 py-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        Geverifieerde MikPunt Lid
                    </span>
                </div>

                <button class="mp-btn mp-btn-primary w-100" @onclick="OpenAddRoleModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Aktiveer Nuwe Rol
                </button>
            </div>

            <!-- Active Registered Roles Card -->
            <div class="mp-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <h4 class="brand-font text-gold mb-0" style="font-size: 18px;">Jou Aktiewe Rolle</h4>
                    <span class="mp-badge mp-badge-warning px-3 py-1" style="font-size: 13px; font-weight: 800;">
                        @u.Roles.Count @(u.Roles.Count == 1 ? "Rol" : "Rolle")
                    </span>
                </div>
                
                @if (u.Roles.Count == 0)
                {
                    <div class="p-3 text-center rounded text-muted small" style="background: rgba(255,255,255,0.03); border: 1px dashed var(--border-color);">
                        U het tans nog geen rolle geaktiveer nie. Klik "+ Aktiveer Nuwe Rol" hierbo om te begin.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var r in u.Roles)
                        {
                            <div class="p-3 border border-secondary rounded" style="background: rgba(255,255,255,0.02);">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <strong class="text-gold" style="font-size: 15px;">@GetRoleDisplayName(r.RoleCode)</strong>
                                        <div class="small text-muted">Kode: @r.RoleCode</div>
                                    </div>
                                    <span class="mp-badge mp-badge-success d-inline-flex align-items-center gap-1 px-2 py-1">
                                        <span style="font-size: 8px;">●</span> @GetRoleStatusLabel(r.Status)
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(r.CredentialsDetails))
                                {
                                    <div class="small text-muted mb-2 p-2 rounded" style="background: rgba(0,0,0,0.2); font-size: 11px; white-space: pre-wrap; line-height: 1.5;">
                                        @r.CredentialsDetails
                                    </div>
                                }

                                <div class="mt-2 d-flex gap-2">
                                    <a href="@GetRoleDashboardUrl(r.RoleCode)" class="mp-btn mp-btn-secondary mp-btn-sm flex-grow-1 text-center">
                                        @GetRoleDisplayName(r.RoleCode) Portaal &rarr;
                                    </a>
                                    <button type="button" class="mp-btn mp-btn-danger mp-btn-sm d-flex align-items-center justify-content-center px-2" title="Verwyder rol van profiel" @onclick="() => PromptDeleteRole(r.RoleCode, GetRoleDisplayName(r.RoleCode))">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>

                                @if (r.RoleCode is "PH" or "Boer" or "PJ" or "VG")
                                {
                                    var sub = _userSubscriptions.TryGetValue(r.RoleCode, out var s) ? s : null;
                                    <div class="mt-2 p-2 rounded border" style="background: rgba(0,0,0,0.25); border-color: @(sub != null && sub.IsActive && sub.HasPaidActivePeriod ? "#10b981" : (sub != null && sub.HasPaidActivePeriod ? "#f59e0b" : "var(--border-color)"));">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <strong class="text-gold small d-block">⭐ Maandelikse Advertensie:</strong>
                                                @if (sub != null && sub.IsActive && sub.HasPaidActivePeriod)
                                                {
                                                    <span class="text-success small fw-bold">Aktief (Geldig tot @sub.ExpiryDate.ToString("dd MMM yyyy") — @sub.DaysRemaining dae oor)</span>
                                                }
                                                else if (sub != null && sub.HasPaidActivePeriod)
                                                {
                                                    <span class="text-warning small fw-bold">Tydelik Gedeaktiveer (@sub.DaysRemaining dae oor op betaalde tydperk)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Inaktief (Geen Betaalde Intekening)</span>
                                                }
                                            </div>

                                            <div class="d-flex gap-1 flex-wrap align-items-center">
                                                @if (sub != null && sub.HasPaidActivePeriod)
                                                {
                                                    <a href="/betaling?type=subscription&role=@r.RoleCode" class="mp-btn mp-btn-primary mp-btn-sm py-1 px-2 text-nowrap" style="font-size: 11px;">
                                                        ➕ Verleng
                                                    </a>
                                                    <button type="button" class="mp-btn @(sub.IsActive ? "mp-btn-secondary" : "mp-btn-success") mp-btn-sm py-1 px-2 text-nowrap" style="font-size: 11px;" @onclick="() => ToggleRoleSubscriptionOnProfile(r.RoleCode)">
                                                        @(sub.IsActive ? "⏸️ Deaktiveer" : "▶️ Heraktiveer")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a href="/betaling?type=subscription&role=@r.RoleCode" class="mp-btn mp-btn-primary mp-btn-sm py-1 px-2 text-nowrap" style="font-size: 11px;">
                                                        💳 Aktiveer
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Personal Profile Details Form -->
        <div class="col-md-7">
            <div class="mp-card p-4">
                <h3 class="brand-font text-gold mb-3" style="font-size: 20px;">Persoonlike Besonderhede</h3>
                <p class="text-muted small mb-4">Dateer u kontakinligting en identiteitsbesonderhede op vir amptelike SAPS 520 en permitverifikasie.</p>

                @if (_savedProfile)
                {
                    <div class="alert alert-success mb-3">Jou profielbesonderhede is suksesvol opgedateer en in die databasis gestoor!</div>
                }

                @if (!string.IsNullOrEmpty(_profileSaveError))
                {
                    <div class="alert alert-danger mb-3">@_profileSaveError</div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSaveProfile">
                    <DataAnnotationsValidator />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6 mp-form-group mb-0">
                            <label class="mp-form-label">Voornaam <span class="text-danger">*</span></label>
                            <InputText @bind-Value="_model.FirstName" class="mp-form-control" placeholder="bv. Johan" maxlength="50" autocomplete="given-name" />
                            <ValidationMessage For="() => _model.FirstName" class="text-danger small mt-1" />
                        </div>
                        <div class="col-md-6 mp-form-group mb-0">
                            <label class="mp-form-label">Van <span class="text-danger">*</span></label>
                            <InputText @bind-Value="_model.LastName" class="mp-form-control" placeholder="bv. Van der Merwe" maxlength="50" autocomplete="family-name" />
                            <ValidationMessage For="() => _model.LastName" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6 mp-form-group mb-0">
                            <label class="mp-form-label">E-posadres</label>
                            <InputText @bind-Value="_model.Email" class="mp-form-control" readonly />
                            <small class="text-muted" style="font-size: 11px;">E-posadres is gekoppel aan u login</small>
                        </div>
                        <div class="col-md-6 mp-form-group mb-0">
                            <label class="mp-form-label">Telefoonnommer <span class="text-danger">*</span></label>
                            <InputText @bind-Value="_model.Phone" type="tel" class="mp-form-control" placeholder="082 555 0192" maxlength="15" autocomplete="tel" />
                            <ValidationMessage For="() => _model.Phone" class="text-danger small mt-1" />
                        </div>
                    </div>

                    @if (UserHasIdRole || !string.IsNullOrWhiteSpace(_model.IdPassportNum))
                    {
                        <div class="mp-form-group mb-4">
                            <label class="mp-form-label">ID- of Paspoortnommer (Vir Vuurwapen- &amp; Permitklaring) @if (UserHasIdRole) { <span class="text-danger">*</span> }</label>
                            <InputText @bind-Value="_model.IdPassportNum" class="mp-form-control" placeholder="bv. 8804125019083 of Paspoortnommer (Alle lande &amp; formate)" maxlength="20" />
                            <ValidationMessage For="() => _model.IdPassportNum" class="text-danger small mt-1" />
                        </div>
                    }

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="mp-btn mp-btn-primary" disabled="@_isSavingProfile">
                            @if (_isSavingProfile)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Besig om te stoor...</span>
                            }
                            else
                            {
                                <span>Stoor Profielbesonderhede</span>
                            }
                        </button>
                    </div>
                </EditForm>

                <!-- DANGER ZONE: DELETE ACCOUNT -->
                <div class="p-3 mt-4 rounded" style="border: 1px solid rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.04);">
                    <div class="d-flex align-items-center gap-2 mb-2 text-danger">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <h4 class="brand-font mb-0 text-danger" style="font-size: 16px;">Gevaarsone: Skrap Rekening</h4>
                    </div>
                    <p class="small text-muted mb-3" style="font-size: 13px; line-height: 1.5;">
                        As u u rekening skrap, sal u profiel, alle aktiewe rolle, dokumente, lyste en verwante geskiedenis permanent uit MikPunt verwyder word. Hierdie aksie is onomkeerbaar.
                    </p>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="mp-btn mp-btn-danger mp-btn-sm" @onclick="PromptDeleteUser">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            Skrap My Rekening Permanent
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- CONFIRM DELETE USER ACCOUNT MODAL POPUP -->
@if (_showDeleteAccountModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.85); z-index: 2700; padding: 20px;" @onclick="CancelDeleteAccount">
        <div class="mp-card border-danger" style="width: 540px; max-width: 100%; box-shadow: 0 20px 50px rgba(0,0,0,0.9);" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-3 mb-3">
                <div class="d-flex align-items-center gap-2 text-danger">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <h3 class="brand-font mb-0 text-danger" style="font-size: 20px;">Skrap Gebruikersrekening Permanent?</h3>
                </div>
                <button type="button" class="btn-close btn-close-white" aria-label="Maak toe" @onclick="CancelDeleteAccount" disabled="@_isDeletingAccount"></button>
            </div>

            <!-- Modal Body -->
            <div class="mb-4">
                <p class="mb-2">Is u heeltemal seker dat u die rekening van <strong class="text-gold">@Auth.CurrentUser?.FullName</strong> wil skrap?</p>
                <div class="alert alert-danger small mb-0" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4); color: #fca5a5;">
                    <strong>Let Wel:</strong> Alle aktiewe rolle, geassosieerde data, plaasinskrywings, permitte, pakkette en aanmeldbesonderhede sal onherroeplik uit MikPunt verwyder word. U sal onmiddellik uitgeteken word.
                </div>
            </div>

            <!-- Modal Actions -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary">
                <button type="button" class="mp-btn mp-btn-secondary" @onclick="CancelDeleteAccount" disabled="@_isDeletingAccount">
                    Kanselleer
                </button>
                <button type="button" class="mp-btn mp-btn-danger" @onclick="ConfirmDeleteAccount" disabled="@_isDeletingAccount">
                    @if (_isDeletingAccount)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Besig om te skrap...</span>
                    }
                    else
                    {
                        <span>Ja, Skrap My Rekening Permanent</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- CONFIRM DELETE ROLE MODAL POPUP -->
@if (_showDeleteConfirmModal && _roleToDelete != null)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.85); z-index: 2600; padding: 20px;" @onclick="CancelDeleteRole">
        <div class="mp-card border-danger" style="width: 520px; max-width: 100%; box-shadow: 0 20px 50px rgba(0,0,0,0.9);" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-3 mb-3">
                <div class="d-flex align-items-center gap-2 text-danger">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <h3 class="brand-font mb-0 text-danger" style="font-size: 20px;">Bevestig Rol-verwydering</h3>
                </div>
                <button type="button" class="btn-close btn-close-white" aria-label="Maak toe" @onclick="CancelDeleteRole" disabled="@_isDeletingRole"></button>
            </div>

            <!-- Modal Body -->
            <div class="mb-4">
                <p class="mb-2">Is u seker u wil die rol <strong class="text-gold">@_roleToDeleteName</strong> van u profiel verwyder?</p>
                <div class="alert alert-warning small mb-0" style="background: rgba(234, 179, 8, 0.1); border-color: rgba(234, 179, 8, 0.3); color: #fef08a;">
                    <strong>Waarskuwing:</strong> Alle verwante data, pakkette, advertensies, lyste, besprekings en instellings wat aan hierdie rol gekoppel is, sal permanent verwyder word.
                </div>
            </div>

            <!-- Modal Actions -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary">
                <button type="button" class="mp-btn mp-btn-secondary" @onclick="CancelDeleteRole" disabled="@_isDeletingRole">
                    Kanselleer
                </button>
                <button type="button" class="mp-btn mp-btn-danger" @onclick="ConfirmDeleteRole" disabled="@_isDeletingRole">
                    @if (_isDeletingRole)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Besig om te verwyder...</span>
                    }
                    else
                    {
                        <span>Ja, Verwyder Rol</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- INTERACTIVE ROLE ACTIVATION MODAL -->
@if (_showAddRoleModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.85); z-index: 2500; padding: 20px;" @onclick="CloseAddRoleModal">
        <div class="mp-card" style="width: 780px; max-width: 100%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 50px rgba(0,0,0,0.8);" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-3 mb-3">
                <div>
                    <span class="mp-badge mp-badge-warning mb-1">Nuwe Rol Aktivering</span>
                    <h2 class="brand-font text-gold mb-0" style="font-size: 22px;">Voeg 'n Rol by jou Profiel</h2>
                    <div class="small text-muted mt-1">Kies 'n rol wat u wil aktiveer en voer die vereiste akkreditasie-besonderhede in.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" aria-label="Maak toe" @onclick="CloseAddRoleModal"></button>
            </div>

            @if (!string.IsNullOrEmpty(_modalErrorMsg))
            {
                <div class="alert alert-danger py-2 px-3 small mb-3">
                    <strong>Aandag:</strong> @_modalErrorMsg
                </div>
            }

            @if (AvailableUnassignedRoles.Count == 0)
            {
                <div class="text-center p-4">
                    <div class="fs-1 text-gold mb-2">&#9733;</div>
                    <h3 class="brand-font text-gold mb-2">Alle Rolle Reeds Aktief!</h3>
                    <p class="text-muted mb-4">U het reeds al die beskikbare rolle op u profiel geaktiveer.</p>
                    <button class="mp-btn mp-btn-secondary" @onclick="CloseAddRoleModal">Maak Toe</button>
                </div>
            }
            else
            {
                <EditForm Model="_roleForm" OnValidSubmit="HandleActivateRole">
                    <DataAnnotationsValidator />

                    <!-- Step 1: Select Role -->
                    <div class="mp-form-group mb-4">
                        <label class="mp-form-label">Kies 'n Rol om te Aktiveer <span class="text-danger">*</span></label>
                        <select class="mp-form-control" value="@_roleForm.SelectedRoleCode" @onchange="HandleRoleCodeChanged">
                            @foreach (var r in AvailableUnassignedRoles)
                            {
                                <option value="@r.Key">@r.Value.Name</option>
                            }
                        </select>
