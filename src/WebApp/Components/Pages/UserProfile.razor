                        <div class="mp-card p-3 mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color);">
                            <h5 class="brand-font text-gold mb-3" style="font-size: 16px;">Hommeltuig (Drone) Lisensies &amp; Sertifisering</h5>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6 mp-form-group mb-0">
                                    <label class="mp-form-label">SACAA Registrasienommer <span class="text-danger">*</span></label>
