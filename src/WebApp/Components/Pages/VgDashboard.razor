@* Videographer (VG) role dashboard at /vg/dashboard. Requires the "VG" or "Admin" role
   (gated below via Auth.HasRole - anonymous/wrong-role visitors get an access-restricted
   card instead of the dashboard). Shows the VG's video/drone packages, assigned filming
   bookings, pending PJ team invites, ad-subscription status, and lets the VG accept/decline
   PJ staff assignments inline. *@
@page "/vg/paneelbord"
@page "/vg/dashboard"
@inject MikpuntApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Videograaf-paneelbord | MikPunt</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="p-5 text-center"><div class="spinner-border text-gold"></div></div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Teken asseblief eers in</h3>
        <p class="text-muted mb-4">Die Videograaf (VG) Portaal is slegs toeganklik vir geregistreerde en aangemelde lede.</p>
        <a href="/teken-in?returnUrl=/vg/paneelbord" class="mp-btn mp-btn-primary">Teken In &rarr;</a>
    </div>
}
else if (!Auth.HasRole("VG") && !Auth.HasRole("Admin"))
{
    <div class="mp-card text-center p-5">
        <div class="mp-brand-logo mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h3 class="brand-font text-gold mb-2">Toegang Beperk: Videograaf (VG) Rol Benodig</h3>
        <p class="text-muted mb-4 max-w-700 mx-auto" style="max-width: 600px;">
            U rekening is tans nie geregistreer as 'n <strong>Videograaf (VG)</strong> nie. U kan hierdie rol op u profiel aktiveer om video- en hommeltuigdienste aan te bied.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/profiel" class="mp-btn mp-btn-primary">+ Aktiveer VG Rol op Profiel &rarr;</a>
            <a href="/rolle" class="mp-btn mp-btn-secondary">Lees Rollegids</a>
        </div>
    </div>
}
else
{
    <div class="no-print">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="me-3">
                <h1 class="brand-font text-gold mb-1">Videograaf (VG) &amp; Hommeltuigportaal</h1>
                <p class="text-muted mb-0 small">Bestuur verfilming van ekspedisies, 4K hommeltuig video pakkette en verwerkingskedules.</p>
                <AiHelperLinks RoleCode="VG" />
            </div>

            <div class="d-flex gap-2 flex-shrink-0 align-items-center flex-wrap">
                <a href="/soek-span" class="mp-btn mp-btn-secondary mp-btn-sm text-nowrap">
                    Netwerk &amp; Werwing ↗
                </a>
                <a href="/uitnodigings" class="mp-btn mp-btn-secondary mp-btn-sm text-nowrap position-relative">
                    Spanaansoeke 📩
                    @if (PendingInvitesCount > 0)
                    {
                        <span class="badge bg-danger ms-1">@PendingInvitesCount</span>
                    }
                </a>
                <a href="/vg/besprekings" class="mp-btn mp-btn-secondary mp-btn-sm text-nowrap">
                    📅 Opdragteskedule
                </a>
                <a href="/vg/pakkette" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">
                    + Voeg Video Pakket By
                </a>
            </div>
        </div>

        @if (_myUserRoleId > 0)
        {
            <DocumentManager UserRoleId="_myUserRoleId" RoleCode="VG" />
        }

        @if (!string.IsNullOrEmpty(_notificationMsg))
        {
            <div class="alert alert-success alert-dismissible fade show p-3 mb-4 d-flex justify-content-between align-items-center">
                <div>@_notificationMsg</div>
                <button type="button" class="btn-close" @onclick='() => _notificationMsg = ""'></button>
            </div>
        }

        <!-- Pending Invites Alert Banner -->
        @if (PendingInvitesCount > 0)
        {
            <div class="alert alert-warning p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2"
                 style="background: rgba(217, 119, 6, 0.18); border: 1.5px solid #f59e0b; color: #fef3c7; border-radius: 8px;">
                <div class="d-flex align-items-center gap-3">
                    <div style="font-size: 24px;">⚠️</div>
                    <div>
                        <strong class="d-block" style="color: #ffffff; font-size: 15px;">
                            Kennisgewing: @PendingInvitesCount @(PendingInvitesCount == 1 ? "span-uitnodiging wag" : "span-uitnodigings wag") op u reaksie!
                        </strong>
                        <div class="small" style="color: #e5e7eb;">
                            Uitrusters (PJ) het u genooi om as amptelike Videograaf (VG) op hul ekspedisies te dien.
                        </div>
                    </div>
                </div>
                <a href="/uitnodigings" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">
                    Bekyk Uitnodigings Nou &rarr;
                </a>
            </div>
        }

        <!-- Quality & Compliance Banner -->
        <div class="p-3 rounded mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 mp-pricing-banner"
             style="background: rgba(35, 20, 10, 0.88); border: 1.5px solid #d97706; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <div class="d-flex align-items-center gap-3">
                <div style="color: #f59e0b;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>
                </div>
                <div>
                    <strong class="d-block text-white fw-bold" style="font-size: 16px; color: #ffffff !important;">MikPunt VG Kwaliteit Standaard: 4K Resolusie &amp; Hommeltuig Veiligheid</strong>
                    <div class="small" style="color: #e5e7eb;">
                        Maak seker dat u u CAA hommeltuig lisensie opdateer. Alle filmopdragte vereis 'n minimum afleweringstandaard van 4K HDR.
                    </div>
                </div>
            </div>
            <a href="/profiel" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">Opdateer VG Profiel &rarr;</a>
        </div>

        <!-- Monthly Advertising Subscription Status Banner -->
        <div class="alert p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2"
             style="background: @(_subscription.IsActive && _subscription.HasPaidActivePeriod ? "rgba(16, 185, 129, 0.14)" : (_subscription.HasPaidActivePeriod ? "rgba(245, 158, 11, 0.14)" : "rgba(107, 114, 128, 0.14)")); border: 1.5px solid @(_subscription.IsActive && _subscription.HasPaidActivePeriod ? "#10b981" : (_subscription.HasPaidActivePeriod ? "#f59e0b" : "#6b7280")); color: #ffffff; border-radius: 8px;">
            <div class="d-flex align-items-center gap-3">
                <div style="font-size: 24px;">⭐</div>
                <div>
                    <strong class="d-block" style="color: #ffffff; font-size: 15px;">
                        @if (_subscription.IsActive && _subscription.HasPaidActivePeriod)
                        {
                            <span>Videograaf (VG) Advertensie-Subskripsie: <strong class="text-success">Aktief op /browse ⭐</strong></span>
                        }
                        else if (_subscription.HasPaidActivePeriod)
                        {
                            <span>Videograaf (VG) Advertensie-Subskripsie: <strong class="text-warning">Tydelik Gedeaktiveer (Betaalde Tydperk Geldig)</strong></span>
                        }
                        else
                        {
                            <span>Videograaf (VG) Advertensie-Subskripsie: <strong class="text-muted">Geen Aktiewe Intekening</strong></span>
                        }
                    </strong>
                    <div class="small" style="color: #e5e7eb;">
                        @if (_subscription.IsActive && _subscription.HasPaidActivePeriod)
                        {
                            <span>U Videograaf profiel en pakkette is amptelik gereklameer op <code>/browse</code>. Geldig tot <strong>@_subscription.ExpiryDate.ToString("dd MMM yyyy")</strong> (@_subscription.DaysRemaining dae oor).</span>
                        }
                        else if (_subscription.HasPaidActivePeriod)
                        {
                            <span>U betaalde tydperk is nog geldig tot <strong>@_subscription.ExpiryDate.ToString("dd MMM yyyy")</strong> (@_subscription.DaysRemaining dae oor). Klik "Heraktiveer Advertensie" om te vertoon sonder betaling.</span>
                        }
                        else
                        {
                            <span>U profiel is tans nie gereklameer nie. Klik "Aktiveer Advertensie" om u verlangde tydperk op die betalingsbladsy te kies.</span>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (_subscription.HasPaidActivePeriod)
                {
                    <a href="/betaling?type=subscription&role=VG" class="mp-btn mp-btn-primary mp-btn-sm text-nowrap">
                        ➕ Verleng Advertensie
                    </a>
                }
                <button class="mp-btn @(_subscription.IsActive && _subscription.HasPaidActivePeriod ? "mp-btn-secondary" : "mp-btn-primary") mp-btn-sm text-nowrap" @onclick="HandleSubscriptionAction">
                    @if (_subscription.IsActive && _subscription.HasPaidActivePeriod)
                    {
                        <span>Deaktiveer Advertensie ⏸️</span>
                    }
                    else if (_subscription.HasPaidActivePeriod)
                    {
                        <span>Heraktiveer Advertensie ▶️</span>
                    }
                    else
                    {
                        <span>Aktiveer Advertensie 💳</span>
                    }
                </button>
            </div>
        </div>

        <!-- Stat Metrics -->
        <div class="d-flex justify-content-center flex-wrap gap-3 mb-4">
            <div class="mp-card text-center flex-fill" style="min-width: 200px; max-width: 320px;">
                <div class="fs-2 text-gold font-bold">@_vgPackages.Count</div>
                <div class="small text-muted text-uppercase fw-bold">Aktiewe Video Pakkette</div>
                <div class="small text-muted mt-1" style="font-size: 11px;">Gepubliseer op markplein</div>
            </div>
            <div class="mp-card text-center flex-fill" style="min-width: 200px; max-width: 320px;">
                <div class="fs-2 text-gold font-bold">@TotalAssignedExpeditions</div>
                <div class="small text-muted text-uppercase fw-bold">Verfilmings Opdragte</div>
                <div class="small text-muted mt-1" style="font-size: 11px;">
                    <span class="text-success">@_bookings.Count Besprekings</span> | <span class="text-gold">@AcceptedInvitesCount Spanne</span>
                </div>
            </div>
            <div class="mp-card text-center flex-fill" style="min-width: 200px; max-width: 320px;">
                <div class="fs-2 text-gold font-bold">@(_ratingStats.RatingCount > 0 ? $"{_ratingStats.AverageStars:0.0} / 5" : "Geen nog")</div>
                <div class="small text-muted text-uppercase fw-bold">Kliënte Gradering</div>
                <div class="small text-muted mt-1" style="font-size: 11px;">@(_ratingStats.RatingCount > 0 ? $"Gebaseer op {_ratingStats.RatingCount} gradering(s)" : "Nog geen graderings ontvang nie")</div>
            </div>
            <div class="mp-card text-center flex-fill" style="min-width: 200px; max-width: 320px;">
                <div class="fs-2 text-warning font-bold">@PendingInvitesCount</div>
                <div class="small text-muted text-uppercase fw-bold">Afwagtende Uitnodigings</div>
                <div class="small text-muted mt-1" style="font-size: 11px;">Van Uitrusters (PJ)</div>
            </div>
            <div class="mp-card text-center flex-fill" style="min-width: 200px; max-width: 320px;">
                <div class="fs-2 text-gold font-bold">@AcceptedInvitesCount</div>
                <div class="small text-muted text-uppercase fw-bold">Aanvaarde Spanplasings</div>
                <div class="small text-success mt-1" style="font-size: 11px;">Aktiewe PJ Vennootskappe</div>
            </div>
        </div>

        <!-- Quick Action Navigation Cards -->
        <div class="mp-grid mb-4">
            <a href="/vg/pakkette" class="mp-card text-decoration-none h-100" style="border: 2px solid var(--accent-gold); overflow: hidden;">
                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                    <h3 class="brand-font text-gold mb-0" style="font-size: 1.15rem; line-height: 1.25;">Bestuur VG Pakkette</h3>
                    <span class="badge bg-warning text-dark">@_vgPackages.Count Pakkette</span>
                </div>
                <p class="text-muted small mb-0">Stel verfilmingstariewe, hommeltuig opsies en afleweringstyd in.</p>
            </a>

            <a href="/vg/besprekings" class="mp-card text-decoration-none h-100" style="border: 1px solid var(--border-color); overflow: hidden;">
                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                    <h3 class="brand-font text-gold mb-0" style="font-size: 1.15rem; line-height: 1.25;">Verfilmings Opdragte</h3>
                    <span class="badge bg-secondary text-light">@_bookings.Count Opdragte</span>
                </div>
                <p class="text-muted small mb-0">Sien toegewese ekspedisies en video projekte van kliënte.</p>
            </a>

            <a href="/uitnodigings" class="mp-card text-decoration-none h-100" style="border: 1px solid var(--border-color); overflow: hidden;">
                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                    <h3 class="brand-font text-gold mb-0" style="font-size: 1.15rem; line-height: 1.25;">Spanaansoeke</h3>
                    @if (PendingInvitesCount > 0)
                    {
                        <span class="badge bg-danger">@PendingInvitesCount Nuut</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-light">@_invites.Count Uitnodigings</span>
                    }
                </div>
                <p class="text-muted small mb-0">Sien inkomende uitnodigings van PJ organiseerders om by spanne aan te sluit.</p>
            </a>

            <a href="/soek-span" class="mp-card text-decoration-none h-100" style="border: 1px solid var(--border-color); overflow: hidden;">
                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                    <h3 class="brand-font text-gold mb-0" style="font-size: 1.15rem; line-height: 1.25;">Netwerk &amp; Uitrusters</h3>
                    <span class="badge bg-secondary text-light">Netwerk ↗</span>
                </div>
                <p class="text-muted small mb-0">Verbind met geregistreerde Uitrusters (PJ) om u dienste te bemark.</p>
            </a>
        </div>

        <!-- Aksie Nodig: VG toewysings wat nog aanvaar/geweier moet word -->
        @if (PendingAssignments.Any())
        {
            <div class="mp-card mb-4 border-warning" style="border-width: 2px;">
                <h3 class="brand-font text-gold mb-1">⚠️ Aksie Nodig: Nuwe Toewysings</h3>
                <p class="text-muted small mb-3">'n Uitruster (PJ) het u aan die volgende ekspedisie(s) toegewys. Aanvaar of wys van die hand.</p>
                <div class="d-flex flex-column gap-2">
                    @foreach (var b in PendingAssignments)
                    {
                        <div class="p-3 rounded" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <strong class="text-gold">@(string.IsNullOrWhiteSpace(b.PackageTitle) ? "Jagekspedisie" : b.PackageTitle)</strong>
                                    <div class="small text-muted">
                                        Jagter: @b.HunterName &bull; @b.StartDate.ToString("dd MMM") – @b.EndDate.ToString("dd MMM yyyy") &bull; Uitruster: @(string.IsNullOrWhiteSpace(b.PjName) ? "Uitruster" : b.PjName)
                                    </div>
                                </div>
                                @if (_decliningBookingId != b.Id)
                                {
                                    <div class="d-flex gap-2">
                                        <button class="mp-btn mp-btn-success mp-btn-sm" @onclick="() => RespondToAssignment(b, true)">
                                            Aanvaar 🤝
                                        </button>
                                        <button class="mp-btn mp-btn-danger mp-btn-sm" @onclick="() => StartDecline(b.Id)">
                                            Wys van hand ✕
                                        </button>
                                    </div>
                                }
                            </div>
                            @if (_decliningBookingId == b.Id)
                            {
                                <div class="mt-2 pt-2 border-top border-secondary">
                                    <label class="small text-muted mb-1 d-block">Rede (opsioneel):</label>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Bv. Nie beskikbaar op hierdie datums nie..." @bind="_declineReasonDraft" />
                                        <button class="mp-btn mp-btn-danger mp-btn-sm" @onclick="() => RespondToAssignment(b, false)">
                                            Bevestig Weiering
                                        </button>
                                        <button class="mp-btn mp-btn-secondary mp-btn-sm" @onclick="CancelDecline">
                                            Kanselleer
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Recent Assigned Expeditions Preview Table -->
        <div class="mp-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h3 class="brand-font text-gold mb-1">Onlangse Verfilmings Opdragte</h3>
                    <p class="text-muted small mb-0">Die mees onlangse ekspedisies waar u as amptelike Videograaf toegewys is.</p>
                </div>
                <a href="/vg/besprekings" class="mp-btn mp-btn-secondary mp-btn-sm">Bekyk Volledige Skedule &rarr;</a>
            </div>

            @if (_bookings.Count == 0 && AcceptedInvitesCount == 0)
            {
                <div class="text-center p-4 text-muted">
                    <p class="mb-2">Geen aktiewe verfilmings opdragte tans toegewys nie.</p>
                    <p class="small">Sodra u 'n span-uitnodiging van 'n Uitruster (PJ) aanvaar of aan 'n bespreking gekoppel word, sal dit hier verskyn.</p>
                    <a href="/uitnodigings" class="mp-btn mp-btn-primary mp-btn-sm">Bekyk Span-Uitnodigings</a>
                </div>
            }
            else if (_bookings.Count > 0)
            {
                <div class="mp-table-responsive">
                    <table class="mp-table">
                        <thead>
                            <tr>
                                <th>Ekspedisie / Projek</th>
                                <th>Jagter</th>
                                <th>Datums</th>
                                <th>Organiseerder (PJ)</th>
                                <th>Aflewering Status</th>
                                <th>Aksies</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in _bookings.Take(5))
                            {
                                <tr>
                                    <td>
                                        <strong>@(string.IsNullOrWhiteSpace(b.PackageTitle) ? "Jagekspedisie" : b.PackageTitle)</strong>
                                    </td>
                                    <td>
                                        <strong>@b.HunterName</strong>
                                    </td>
                                    <td class="small">
                                        @b.StartDate.ToString("dd MMM") – @b.EndDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="small text-muted">
                                        @(string.IsNullOrWhiteSpace(b.PjName) ? "Uitruster" : b.PjName)
                                    </td>
                                    <td>
                                        @if (string.Equals(b.Status, "Approved", StringComparison.OrdinalIgnoreCase) || string.Equals(b.Status, "Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="mp-badge mp-badge-warning">Besig met Verfilming</span>
                                        }
                                        else if (string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="mp-badge mp-badge-success">Aflewerbaar Gereed</span>
                                        }
                                        else
                                        {
                                            <span class="mp-badge mp-badge-secondary">Beplan</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button class="mp-btn mp-btn-outline-gold mp-btn-sm text-nowrap" @onclick='() => StartChat(b.HunterName, b.HunterUserId)'>
                                                <i class="bi bi-chat-dots-fill text-gold me-1"></i> Klets
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="mp-table-responsive">
                    <table class="mp-table">
                        <thead>
                            <tr>
                                <th>Uitruster (PJ)</th>
                                <th>U Rol</th>
                                <th>Datum Ontvang</th>
                                <th>Status</th>
                                <th>Aksies</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in _invites.Where(i => string.Equals(i.Status, "Accepted", StringComparison.OrdinalIgnoreCase)).Take(5))
                            {
                                <tr>
                                    <td>
                                        <strong>@inv.PjName @inv.PjSurname</strong>
                                        <div class="small text-muted">@inv.PjEmail</div>
                                    </td>
                                    <td>
                                        <span class="mp-badge mp-badge-warning">
                                            @(string.IsNullOrWhiteSpace(inv.TargetRoleCode) ? "Videograaf (VG)" : inv.TargetRoleCode)
                                        </span>
                                    </td>
                                    <td class="small text-muted">@inv.InviteDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="mp-badge mp-badge-success">Aanvaar &#10003;</span>
                                    </td>
                                    <td>
                                        <button class="mp-btn mp-btn-outline-gold mp-btn-sm text-nowrap" @onclick='() => StartChat($"{inv.PjName} {inv.PjSurname}", inv.PjUserId)'>
                                            <i class="bi bi-chat-dots-fill text-gold me-1"></i> Klets
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<ServicePackageModel> _vgPackages = new();
    private RatingProfileStatsModel _ratingStats = new();
    private int _myUserRoleId = 0;
    private List<TeamInviteResponse> _invites = new();
    private List<BookingModel> _bookings = new();
    private RoleSubscriptionModel _subscription = new();
    private string _notificationMsg = string.Empty;

    private int PendingInvitesCount => _invites.Count(i => string.Equals(i.Status, "Pending", StringComparison.OrdinalIgnoreCase));
    private int AcceptedInvitesCount => _invites.Count(i => string.Equals(i.Status, "Accepted", StringComparison.OrdinalIgnoreCase));
    private int TotalAssignedExpeditions => _bookings.Count + AcceptedInvitesCount;
    private IEnumerable<BookingModel> PendingAssignments => _bookings.Where(b => string.Equals(b.VgAssignmentStatus, "Pending", StringComparison.OrdinalIgnoreCase));

    private int _decliningBookingId = 0;
    private string _declineReasonDraft = string.Empty;

    /// <summary>Switches a pending-assignment row into "enter decline reason" mode.</summary>
    private void StartDecline(int bookingId)
    {
        _decliningBookingId = bookingId;
        _declineReasonDraft = string.Empty;
    }

    /// <summary>Backs out of decline-reason entry without submitting a response.</summary>
    private void CancelDecline()
    {
        _decliningBookingId = 0;
        _declineReasonDraft = string.Empty;
    }

    /// <summary>Accepts or declines a PJ's VG staff assignment for a booking, then reloads dashboard data on success.</summary>
    private async Task RespondToAssignment(BookingModel b, bool accept)
    {
        var (success, _, message) = await Api.RespondToStaffAssignmentAsync(b.Id, "VG", accept, accept ? null : _declineReasonDraft);
        _notificationMsg = message;
        _decliningBookingId = 0;
        _declineReasonDraft = string.Empty;
        if (success)
        {
            await LoadDataAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += HandleAuthChanged;
        await LoadDataAsync();
    }

    /// <summary>Re-fetches dashboard data when auth state changes (e.g. login completes after this page already rendered its "please sign in" state).</summary>
    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Loads packages, invites, bookings, subscription and rating stats for the current
    /// VG. Known bug: falls back to hardcoded UserId 5 if Auth.CurrentUser is somehow
    /// null despite Auth.IsAuthenticated being true - a leftover dev/testing default
    /// that would silently show the wrong user's data rather than failing loudly.
    /// </summary>
    private async Task LoadDataAsync()
    {
        if (Auth.IsAuthenticated && (Auth.HasRole("VG") || Auth.HasRole("Admin")))
        {
            var myUserId = Auth.CurrentUser?.UserId ?? 0;
            _vgPackages = await Api.GetVgPackagesAsync(myUserId);
            _invites = await Api.GetInvitesForUserAsync(myUserId);
            _bookings = await Api.GetBookingsForVgAsync(myUserId);
            _subscription = await Api.GetRoleSubscriptionAsync(myUserId, "VG");
            _ratingStats = await Api.GetRatingProfileStatsAsync(myUserId, "VG");

            var profileResult = await Api.GetProfileAsync(myUserId);
            _myUserRoleId = profileResult.Data?.Roles.FirstOrDefault(r => r.RoleCode == "VG")?.Id ?? 0;
        }
    }

    /// <summary>Toggles the VG's /browse advertising visibility off/on if a paid period is still valid, or routes to the payment page to start a new subscription period.</summary>
    private async Task HandleSubscriptionAction()
    {
        if (_subscription.IsActive && _subscription.HasPaidActivePeriod)
        {
            _subscription.IsActive = false;
            var (saved, saveError) = await Api.SaveRoleSubscriptionAsync(_subscription);
            if (!saved) _subscription.IsActive = !_subscription.IsActive;
            _notificationMsg = saved ? $"U VG advertensie is tydelik gedeaktiveer. U betaalde tydperk bly nog geldig tot {_subscription.ExpiryDate:dd MMM yyyy}." : (saveError ?? "Kon nie die advertensie opdateer nie.");
        }
        else if (_subscription.HasPaidActivePeriod)
        {
            _subscription.IsActive = true;
            var (saved, saveError) = await Api.SaveRoleSubscriptionAsync(_subscription);
            if (!saved) _subscription.IsActive = !_subscription.IsActive;
            _notificationMsg = saved ? $"U VG advertensie is suksesvol her-geaktiveer! Geen addisionele betaling was nodig nie (Geldig tot {_subscription.ExpiryDate:dd MMM yyyy})." : (saveError ?? "Kon nie die advertensie opdateer nie.");
        }
        else
        {
            Nav.NavigateTo("/betaling?type=subscription&role=VG");
        }
    }

    /// <summary>
    /// Navigates to the Messages page pre-filled with a target user. Known bug: falls
    /// back to hardcoded targetUserId 1 when userId is 0/negative instead of e.g.
    /// disabling the chat button, which could open a chat with the wrong (id-1) user.
    /// </summary>
    private void StartChat(string? targetName, int userId)
    {
        var name = string.IsNullOrWhiteSpace(targetName) ? "Gebruiker" : targetName;
        var targetId = userId > 0 ? userId : 1;
        Nav.NavigateTo($"/boodskappe?targetUser={Uri.EscapeDataString(name)}&targetUserId={targetId}");
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= HandleAuthChanged;
    }
}
