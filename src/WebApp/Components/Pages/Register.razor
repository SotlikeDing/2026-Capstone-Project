                                    <i class="bi bi-arrow-left me-2"></i>Terug na Stap 1
                                </button>
                                <button type="button" class="mp-btn mp-btn-primary w-50 py-2 fw-bold" @onclick="HandleRegister" disabled="@(_isSubmitting || !_registrationsOpen)">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Besig om te registreer...</span>
