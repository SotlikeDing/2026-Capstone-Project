<style>
    /* Input Labels: Black in Light Mode (#111111), White in Dark Mode (#ffffff) */
    .mp-input-label {
        color: #111111;
    }
    [data-theme="dark"] .mp-input-label,
    .dark-theme .mp-input-label {
        color: #ffffff !important;
    }
</style>

@code {
    private int _currentStep = 1;
    private EnterpriseRegisterFormModel _model = new();

    /// <summary>
    /// Set by a booking invite link (/registreer?email=...): a main hunter added this email
    /// to their booking, and the invite only links itself once exactly this email is
    /// verified on a Hunter account - so pre-fill it rather than let a typo break the link.
    /// </summary>
    [SupplyParameterFromQuery(Name = "email")] public string? InvitedEmail { get; set; }

    private bool _registrationsOpen = true;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(InvitedEmail) && string.IsNullOrWhiteSpace(_model.Email))
            _model.Email = InvitedEmail.Trim();
        _registrationsOpen = (await Api.GetSiteStatusAsync()).RegistrationsOpen;
    }
    private string _errorMessage = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;
    private bool _isSubmitting = false;

    // Multi-Role Selection State
    private HashSet<string> _selectedRoles = new() { "Jagter" };

    // Password strength meter states (Enforcing 12 Characters)
    private int _passwordScore = 0;
    private string _strengthText = "Swak";
    private string _strengthBadgeClass = "bg-danger";
    private string _strengthBarClass = "bg-danger";
    private bool _hasMinLength = false;
    private bool _hasUpper = false;
    private bool _hasNumber = false;
    private bool _hasSpecial = false;

    private bool IsRoleSelected(string roleCode) => _selectedRoles.Contains(roleCode);
    /// <summary>
    /// Every role has its own mandatory-fields card (Boer: FarmName/FarmRegion/
    /// FarmRegNumber; AP: BusinessName/TaxVatNumber/PhysicalAddress; and so on), checked
    /// in HandleRegister - so any selected role shows its card.
    /// </summary>
    private bool RequiresAdditionalInfo => IsRoleSelected("Jagter") || IsRoleSelected("PJ") || IsRoleSelected("PH") || IsRoleSelected("VG")
                                           || IsRoleSelected("Boer") || IsRoleSelected("AP");

    /// <summary>Adds/removes a role from the multi-select set; refuses to deselect the last remaining role since at least one is required.</summary>
    private void ToggleRole(string roleCode)
    {
        if (_selectedRoles.Contains(roleCode))
        {
            // Allow deselecting if more than 1 role is selected
            if (_selectedRoles.Count > 1)
            {
                _selectedRoles.Remove(roleCode);
            }
        }
        else
        {
            _selectedRoles.Add(roleCode);
        }
    }

    /// <summary>Live password-strength meter: scores 0-4 on length/upper/digit/special-char presence and updates the badge/bar text+color. GoToStep2 separately re-enforces a minimum score of 3 as a hard gate.</summary>
    private void OnPasswordInput(ChangeEventArgs e)
    {
        string pwd = e.Value?.ToString() ?? string.Empty;
        _model.Password = pwd;

        _hasMinLength = pwd.Length >= 12; // Enforcing MINIMUM 12 Characters
        _hasUpper = pwd.Any(char.IsUpper);
        _hasNumber = pwd.Any(char.IsDigit);
        _hasSpecial = pwd.Any(ch => !char.IsLetterOrDigit(ch));

        _passwordScore = 0;
        if (_hasMinLength) _passwordScore++;
        if (_hasUpper) _passwordScore++;
        if (_hasNumber) _passwordScore++;
        if (_hasSpecial) _passwordScore++;

        switch (_passwordScore)
        {
            case 0:
            case 1:
                _strengthText = "Baie Swak";
                _strengthBadgeClass = "bg-danger text-white";
                _strengthBarClass = "bg-danger";
                break;
            case 2:
                _strengthText = "Matig";
                _strengthBadgeClass = "bg-warning text-dark";
                _strengthBarClass = "bg-warning";
                break;
            case 3:
                _strengthText = "Goed";
                _strengthBadgeClass = "bg-info text-dark";
                _strengthBarClass = "bg-info";
                break;
            case 4:
                _strengthText = "Uitstekend";
                _strengthBadgeClass = "bg-success text-white";
                _strengthBarClass = "bg-success";
                break;
        }
    }

    /// <summary>Scrolls the page to the top so a newly-shown validation error alert is visible - swallows JS errors since this is a cosmetic nicety, not load-bearing.</summary>
    private async Task ScrollToTop()
    {
        try
        {
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch { }
    }

    /// <summary>Step 1 -&gt; Step 2 gate: validates identity/contact/password/terms fields client-side (including the 12-char/score-3 password policy and a client-only IsEmailRegistered duplicate-email check) before advancing.</summary>
    private async Task GoToStep2()
    {
        _errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_model.FirstName) || string.IsNullOrWhiteSpace(_model.LastName))
        {
            _errorMessage = "Voer asseblief jou Voornaam en Van in.";
            await ScrollToTop();
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Email) || !_model.Email.Contains('@'))
        {
            _errorMessage = "Voer asseblief 'n geldige e-posadres in.";
            await ScrollToTop();
            return;
        }

        // Client-side-only pre-check against AuthService's in-memory _registeredUsers
        // list (empty on a fresh page load in a new session/device) - a real duplicate
        // email is actually caught by WebAPI's server-side check later in
        // HandleRegister (Api.RegisterUserAsync), surfaced via apiMsg. This early check
        // only helps within the same browser session (e.g. re-registering right after
        // an earlier successful registration in the same tab).
        if (Auth.IsEmailRegistered(_model.Email))
        {
            _errorMessage = $"'n Rekening met die e-posadres '{_model.Email}' bestaan reeds in MikPunt. Slegs een rekening per e-pos word toegelaat.";
            await ScrollToTop();
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Phone))
        {
            _errorMessage = "Voer asseblief jou telefoonnommer in.";
            await ScrollToTop();
            return;
        }

        if (_model.Password != _model.ConfirmPassword)
        {
            _errorMessage = "Wagwoorde stem nie ooreen nie.";
            await ScrollToTop();
            return;
        }

        // Enforce 12-character minimum password policy
        if (_model.Password.Length < 12 || _passwordScore < 3)
        {
            _errorMessage = "Jou wagwoord is te swak. Dit moet ten minste 12 karakters, 1 hoofletter, 1 kleinletter, 1 syfer en 1 spesiale teken bevat.";
            await ScrollToTop();
            return;
        }

        if (!_model.TermsAccepted)
        {
            _errorMessage = "Jy moet die Diensvoorwaardes en Privaatheidsbeleid aanvaar om voort te gaan.";
            await ScrollToTop();
            return;
        }

        _currentStep = 2;
        await ScrollToTop();
    }

    /// <summary>
    /// Step 2 submit: re-validates terms + at least one role, then runs mandatory-field
    /// checks per selected role (Jagter/Boer/PJ/PH/VG/AP), builds the
    /// WebAPI RegisterApiRequestModel and posts via Api.RegisterUserAsync (the actual,
    /// server-persisted registration), then calls Auth.Register for local UI state
    /// only and redirects to the email-verification page.
    /// </summary>
    private async Task HandleRegister()
    {
        _errorMessage = string.Empty;

        if (!_model.TermsAccepted)
        {
            _errorMessage = "Jy moet die Diensvoorwaardes en Privaatheidsbeleid aanvaar om voort te gaan.";
            await ScrollToTop();
            return;
        }

        if (_selectedRoles.Count == 0)
        {
            _errorMessage = "Kies asseblief ten minste een rol om voort te gaan.";
            await ScrollToTop();
            return;
        }

        // STRICT MANDATORY VALIDATION FOR ALL SELECTED ROLES
        if (IsRoleSelected("Jagter"))
        {
            if (string.IsNullOrWhiteSpace(_model.LeaderboardNickname))
            {
                _errorMessage = "Vul asseblief jou Bynaam vir die Ranglys in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.PassportOrIdNumber))
            {
                _errorMessage = "Vul asseblief jou ID- of Paspoortnommer in.";
                await ScrollToTop();
                return;
            }
        }

        if (IsRoleSelected("PJ"))
        {
            if (string.IsNullOrWhiteSpace(_model.PjLicenseNumber) || string.IsNullOrWhiteSpace(_model.PjLicenseExpiry))
            {
                _errorMessage = "Vul asseblief jou Provinsiale Uitruster Lisensienommer en Vervaldatum in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.PjProvinceDocuments))
            {
                _errorMessage = "Vul asseblief jou Provinsiale Lisensiedokument verwysings in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.CipcRegNumber) || string.IsNullOrWhiteSpace(_model.TaxVatNumber))
            {
                _errorMessage = "Vul asseblief jou CIPC Registrasienommer en BTW/Belasting PIN nommer in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.PhysicalAddress))
            {
                _errorMessage = "Vul asseblief jou Fisiese Besigheidsadres in.";
                await ScrollToTop();
                return;
            }
        }

        if (IsRoleSelected("PH"))
        {
            if (string.IsNullOrWhiteSpace(_model.PhLicenseNumber) || string.IsNullOrWhiteSpace(_model.PhIssuingProvince) || string.IsNullOrWhiteSpace(_model.PhLicenseExpiry))
            {
                _errorMessage = "Vul asseblief jou PH Lisensienommer, Uitgewer Provinsie en Vervaldatum in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.DangerousGameEndorsement))
            {
                _errorMessage = "Vul asseblief jou Gevaarlike Wild Endossement besonderhede in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.PhAssociationName) || string.IsNullOrWhiteSpace(_model.PhAssociationMemberNumber) || string.IsNullOrWhiteSpace(_model.PhAssociationDocument))
            {
                _errorMessage = "Vul asseblief jou PH Vereniging (PHASA/CHASA/Ander), Lidmaatskapnommer en Verifikasiedokument in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.FirstAidCertDetails) || string.IsNullOrWhiteSpace(_model.FirearmCompetencyDetails))
            {
                _errorMessage = "Vul asseblief jou Eerstehulp Sertifisering en Vuurwapenbevoegdheid in.";
                await ScrollToTop();
                return;
            }
        }

        if (IsRoleSelected("Boer"))
        {
            if (string.IsNullOrWhiteSpace(_model.FarmName) || string.IsNullOrWhiteSpace(_model.FarmRegion))
            {
                _errorMessage = "Vul asseblief jou Jagplaas Naam en Provinsie / Streek in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.FarmRegNumber))
            {
                _errorMessage = "Vul asseblief jou Plaas Registrasienommer / Grondbrief Besonderhede in.";
                await ScrollToTop();
                return;
            }
        }

        if (IsRoleSelected("AP"))
        {
            if (string.IsNullOrWhiteSpace(_model.BusinessName))
            {
                _errorMessage = "Vul asseblief jou Besigheids- / Handelsnaam in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.TaxVatNumber) || string.IsNullOrWhiteSpace(_model.PhysicalAddress))
            {
                _errorMessage = "Vul asseblief jou BTW- / Belastingnommer en Besigheidsadres in.";
                await ScrollToTop();
                return;
            }
        }

        if (IsRoleSelected("VG"))
        {
            if (string.IsNullOrWhiteSpace(_model.DroneLicenses))
            {
                _errorMessage = "Vul asseblief jou Hommeltuig Lisensies (SACAA/RPL/ROC) in.";
                await ScrollToTop();
                return;
            }
            if (string.IsNullOrWhiteSpace(_model.MediaQualifications))
            {
                _errorMessage = "Vul asseblief jou Media Kwalifikasies & Toerusting Opsomming in.";
                await ScrollToTop();
                return;
            }
        }

        _isSubmitting = true;

        try
        {
            // Create fresh user profile with all selected roles. UserId here is a
            // random client-side placeholder, not the real database id issued by
            // WebAPI's Register endpoint above - see AuthService.Register's doc
            // comment for why that's fine (this object only seeds local UI state
            // for the redirect to /verify-email, it isn't the source of truth).
            var newUser = new UserModel
            {
                UserId = new Random().Next(100, 9999),
                Email = _model.Email,
                FirstName = _model.FirstName,
                LastName = _model.LastName,
                Phone = $"{_model.PhoneCountryCode} {_model.Phone}",
                IdPassportNum = _model.PassportOrIdNumber,
                IsVerified = false,
                CreatedAt = DateTime.UtcNow,
                Roles = new List<UserRoleModel>()
            };

            // Populate all selected roles into the user's role collection
            int roleId = 1;
            foreach (var rCode in _selectedRoles)
            {
                string rName = rCode switch
                {
                    "Jagter" => "Jagter",
                    "Boer" => "Grondeienaar (Boer)",
                    "PJ" => "Uitruster (PJ)",
                    "PH" => "Professionele Jagter (PH)",
                    "VG" => "Videograaf (VG)",
                    "AP" => "Adverteerder (AP)",
                    _ => rCode
                };

                newUser.Roles.Add(new UserRoleModel
                {
                    Id = roleId++,
                    UserId = newUser.UserId,
                    RoleCode = rCode,
                    RoleName = rName,
                    Status = "Active",
                    AssignedDate = DateTime.UtcNow
                });
            }

            var apiRegModel = new RegisterApiRequestModel
            {
                FirstName = _model.FirstName,
                Surname = _model.LastName,
                Email = _model.Email,
                Password = _model.Password,
                Phone = $"{_model.PhoneCountryCode} {_model.Phone}",
                PrimaryRoleCode = _selectedRoles.FirstOrDefault() ?? "Jagter",
                SelectedRoles = _selectedRoles.ToList(),
                TermsAccepted = _model.TermsAccepted,
                ProfilePictureUrl = _model.ProfilePictureUrl,

                // Role data
                LeaderboardNickname = _model.LeaderboardNickname,
                PassportOrIdNumber = _model.PassportOrIdNumber,
                PjLicenseNumber = _model.PjLicenseNumber,
                PjLicenseExpiry = _model.PjLicenseExpiry,
                PjProvinceDocuments = _model.PjProvinceDocuments,
                CipcRegNumber = _model.CipcRegNumber,
                TaxVatNumber = _model.TaxVatNumber,
                PhysicalAddress = _model.PhysicalAddress,
                PhLicenseNumber = _model.PhLicenseNumber,
                PhIssuingProvince = _model.PhIssuingProvince,
                PhLicenseExpiry = _model.PhLicenseExpiry,
                DangerousGameEndorsement = _model.DangerousGameEndorsement,
                PhAssociationName = _model.PhAssociationName,
                PhAssociationMemberNumber = _model.PhAssociationMemberNumber,
                PhAssociationDocument = _model.PhAssociationDocument,
                FirstAidCertDetails = _model.FirstAidCertDetails,
                FirstAidExpiry = _model.FirstAidExpiry,
                FirearmCompetencyDetails = _model.FirearmCompetencyDetails,
                DroneLicenses = _model.DroneLicenses,
                MediaQualifications = _model.MediaQualifications,
                FarmName = _model.FarmName,
                FarmRegion = _model.FarmRegion,
                FarmRegNumber = _model.FarmRegNumber,
                BusinessName = _model.BusinessName
            };

            var (success, apiMsg) = await Api.RegisterUserAsync(apiRegModel);
            if (!success)
            {
                _errorMessage = apiMsg;
                await ScrollToTop();
                return;
            }

            Auth.Register(newUser);
            Nav.NavigateTo($"/bevestig-epos?email={Uri.EscapeDataString(_model.Email)}&status=sent");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            await ScrollToTop();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string? _profilePicPreviewUrl = null;

    /// <summary>Resizes the picked file client-side to 300x300 PNG and stores it as a base64 data URI directly on the model - there's no separate file-upload endpoint, the picture travels inline with the registration payload.</summary>
    private async Task HandleProfilePicSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 3 * 1024 * 1024)
        {
            _errorMessage = "Die foto is te groot. Kies asseblief 'n prent kleiner as 3 MB.";
            await ScrollToTop();
            return;
        }

        try
        {
            var resized = await file.RequestImageFileAsync("image/png", 300, 300);
            using var stream = resized.OpenReadStream(3 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            _profilePicPreviewUrl = $"data:image/png;base64,{base64}";
            _model.ProfilePictureUrl = _profilePicPreviewUrl;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PROFILE PIC ERROR] {ex.Message}");
        }
    }

    private void RemoveProfilePic()
    {
        _profilePicPreviewUrl = null;
        _model.ProfilePictureUrl = null;
    }

