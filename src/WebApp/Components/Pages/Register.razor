                                                    <InputText @bind-Value="_model.BusinessName" class="mp-form-control" placeholder="bv. Safari Gear SA" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label text-light small fw-bold">BTW- / Belastingnommer <span class="text-danger">*</span></label>
                                                    <InputText @bind-Value="_model.TaxVatNumber" class="mp-form-control" placeholder="bv. 4991029384" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label text-light small fw-bold">Besigheidsadres <span class="text-danger">*</span></label>
