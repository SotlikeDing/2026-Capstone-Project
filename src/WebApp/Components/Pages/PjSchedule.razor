</style>

@code {
    private List<BookingModel> _bookings = new();
    private List<TeamMemberResponse> _teamMembers = new();
    private List<TeamMemberResponse> _phCandidates = new();
    private List<TeamMemberResponse> _vgCandidates = new();
    private bool _loading = true;

    private DateTime _currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string _viewMode = "calendar"; // "calendar" or "timeline"
    private string _selectedStaffFilter = "all"; // "all", "PH", "VG"

    private List<CalendarGridCell> _calendarGridCells = new();
    private readonly string[] _dayOfWeekNames = new[] { "Maandag", "Dinsdag", "Woensdag", "Donderdag", "Vrydag", "Saterdag", "Sondag" };

    // Quick detail modal
    private bool _showQuickModal = false;
    private BookingModel? _selectedBooking;

    /// <summary>One day cell in the rendered 5-week (35-day) calendar grid, including leading/trailing days from adjacent months.</summary>
    public class CalendarGridCell
    {
        public DateTime Date { get; set; }
    }

    /// <summary>Count of the PJ's confirmed/completed bookings whose start date falls in the currently viewed month.</summary>
    private int ActiveBookingsThisMonthCount =>
        _bookings.Count(b => (b.Status == "Approved" || b.Status == "Paid" || b.Status == "Completed") &&
                             b.StartDate.Month == _currentMonth.Month && b.StartDate.Year == _currentMonth.Year);

    /// <summary>Team members not assigned as PH or VG on any booking whose date range covers today.</summary>
    private int AvailableStaffTodayCount
    {
        get
        {
            var today = DateTime.Today;
            var busyStaffIds = _bookings.Where(b => (b.Status == "Approved" || b.Status == "Paid") &&
                                                    b.StartDate <= today && b.EndDate >= today)
                                       .SelectMany(b => new[] { b.AssignedPhUserId, b.AssignedVgUserId })
                                       .Where(id => id.HasValue && id.Value > 0)
                                       .Select(id => id!.Value)
                                       .ToHashSet();

            return _teamMembers.Count(m => !busyStaffIds.Contains(m.UserId));
        }
    }

    /// <summary>
    /// Total count of pairwise date-range overlaps across all staff (O(n^2) per member's
    /// booking list, fine at this scale - a PJ's team/booking volume is small). Counts each
    /// overlapping pair once per member, so a single 3-way overlap contributes multiple times
    /// here versus GetStaffMonthConflicts, which dedupes to distinct bookings involved.
    /// </summary>
    private int ScheduleConflictCount
    {
        get
        {
            int count = 0;
            foreach (var m in _teamMembers)
            {
                var memberBookings = _bookings.Where(b => (b.Status == "Approved" || b.Status == "Paid") &&
                                                          ((b.AssignedPhUserId == m.UserId) || (b.AssignedVgUserId == m.UserId))).ToList();

                for (int i = 0; i < memberBookings.Count; i++)
                {
                    for (int j = i + 1; j < memberBookings.Count; j++)
                    {
                        if (memberBookings[i].StartDate <= memberBookings[j].EndDate && memberBookings[i].EndDate >= memberBookings[j].StartDate)
                        {
                            count++;
                        }
                    }
                }
            }
            return count;
        }
    }

    /// <summary>Team members restricted to the currently selected role filter ("all"/"PH"/"VG") for the timeline view.</summary>
    private IEnumerable<TeamMemberResponse> FilteredTeamMembers =>
        _selectedStaffFilter switch
        {
            "PH" => _phCandidates,
            "VG" => _vgCandidates,
            _ => _teamMembers
        };

    /// <summary>Subscribes to auth/theme change events and loads schedule data immediately if already authenticated with the right role.</summary>
    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += HandleAuthChanged;
        Theme.OnThemeChanged += HandleThemeChanged;
        if (Auth.IsAuthenticated && (Auth.HasRole("PJ") || Auth.HasRole("Admin")))
        {
            await LoadData();
        }
    }

    /// <summary>Re-renders on theme toggle - several calendar cell colors are set via inline style with explicit light/dark branches rather than CSS variables alone.</summary>
    private void HandleThemeChanged() => InvokeAsync(StateHasChanged);

    /// <summary>AuthService login/logout callback - reloads schedule data as the session changes within the same tab.</summary>
    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            if (Auth.IsAuthenticated && (Auth.HasRole("PJ") || Auth.HasRole("Admin")))
            {
                await LoadData();
            }
            StateHasChanged();
        });
    }

    /// <summary>
    /// Loads the PJ's team bookings and roster, then builds the PH/VG candidate lists used
    /// by the role filter - if the PJ personally also holds the PH or VG role but isn't
    /// already in their own team roster (a PJ doesn't invite themselves), they're synthesized
    /// in as an extra "(PJ &amp; PH)"/"(PJ &amp; VG)" entry so their own bookings still show up.
    /// </summary>
    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var myUserId = Auth.CurrentUser?.UserId ?? 0;
            _bookings = await Api.GetBookingsForPjAsync(myUserId);
            _teamMembers = await Api.GetPjTeamMembersAsync(myUserId);

            _phCandidates = _teamMembers.Where(m => string.Equals(m.Role, "PH", StringComparison.OrdinalIgnoreCase)).ToList();
            if (Auth.HasRole("PH") && !_phCandidates.Any(c => c.UserId == myUserId))
            {
                _phCandidates.Insert(0, new TeamMemberResponse
                {
                    UserId = myUserId,
                    Name = Auth.CurrentUser?.FirstName ?? "Ekself",
                    Surname = $"{Auth.CurrentUser?.LastName} (PJ & PH)",
                    Role = "PH"
                });
            }

            _vgCandidates = _teamMembers.Where(m => string.Equals(m.Role, "VG", StringComparison.OrdinalIgnoreCase)).ToList();
            if (Auth.HasRole("VG") && !_vgCandidates.Any(c => c.UserId == myUserId))
            {
                _vgCandidates.Insert(0, new TeamMemberResponse
                {
                    UserId = myUserId,
                    Name = Auth.CurrentUser?.FirstName ?? "Ekself",
                    Surname = $"{Auth.CurrentUser?.LastName} (PJ & VG)",
                    Role = "VG"
                });
            }

            BuildCalendarGrid();
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Fills a fixed 35-cell (5-week) grid starting on the Monday on/before the 1st of _currentMonth, so the grid always shows complete weeks even when they spill into adjacent months.</summary>
    private void BuildCalendarGrid()
    {
        _calendarGridCells.Clear();

        // Find first day of week for current month (Monday = 1 ... Sunday = 7)
        var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
        int dayOfWeekVal = (int)firstDayOfMonth.DayOfWeek;
        int offset = dayOfWeekVal == 0 ? 6 : dayOfWeekVal - 1; // Monday start

        var startDate = firstDayOfMonth.AddDays(-offset);

        for (int i = 0; i < 35; i++) // 5 weeks grid
        {
            _calendarGridCells.Add(new CalendarGridCell { Date = startDate.AddDays(i) });
        }
    }

    private void PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        BuildCalendarGrid();
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        BuildCalendarGrid();
    }

    private void GoToToday()
    {
        _currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        BuildCalendarGrid();
    }

    /// <summary>Every non-rejected/cancelled booking whose date range spans the given day - used for the calendar grid cells.</summary>
    private List<BookingModel> GetBookingsForDate(DateTime date)
    {
        return _bookings.Where(b => (b.Status == "Approved" || b.Status == "Paid" || b.Status == "Pending") &&
                                    b.StartDate.Date <= date.Date && b.EndDate.Date >= date.Date).ToList();
    }

    /// <summary>Bookings for one staff member starting in the given month, PH- or VG-assigned - used to build a member's timeline row.</summary>
    private List<BookingModel> GetBookingsForStaff(int staffUserId, DateTime month)
    {
        return _bookings.Where(b => (b.Status == "Approved" || b.Status == "Paid" || b.Status == "Pending") &&
                                    ((b.AssignedPhUserId == staffUserId) || (b.AssignedVgUserId == staffUserId)) &&
                                    b.StartDate.Month == month.Month && b.StartDate.Year == month.Year)
                        .OrderBy(b => b.StartDate)
                        .ToList();
    }

    /// <summary>Distinct bookings (deduped, unlike ScheduleConflictCount's raw pair count) among a staff member's bookings for the month whose date ranges overlap another of their own bookings.</summary>
    private List<BookingModel> GetStaffMonthConflicts(int staffUserId, DateTime month)
    {
        var list = GetBookingsForStaff(staffUserId, month);
        var conflicts = new List<BookingModel>();

        for (int i = 0; i < list.Count; i++)
        {
            for (int j = i + 1; j < list.Count; j++)
            {
                if (list[i].StartDate <= list[j].EndDate && list[i].EndDate >= list[j].StartDate)
                {
                    if (!conflicts.Contains(list[i])) conflicts.Add(list[i]);
                    if (!conflicts.Contains(list[j])) conflicts.Add(list[j]);
                }
            }
        }
        return conflicts;
    }

    /// <summary>Whether a booking has an assignment matching the selected staff-role filter - used to skip calendar-cell badges that don't match.</summary>
    private bool FilterStaffMatch(BookingModel b)
    {
        if (_selectedStaffFilter == "all") return true;
        if (_selectedStaffFilter == "PH" && b.AssignedPhUserId.HasValue && b.AssignedPhUserId.Value > 0) return true;
        if (_selectedStaffFilter == "VG" && b.AssignedVgUserId.HasValue && b.AssignedVgUserId.Value > 0) return true;
        return false;
    }

    /// <summary>Inline badge color per booking status for the calendar-cell event chips.</summary>
    private string GetBookingBadgeStyle(BookingModel b) => b.Status switch
    {
        "Approved" or "Paid" => "background: rgba(16, 185, 129, 0.85); color: #ffffff; border: 1px solid #10b981;",
        "Completed" => "background: rgba(59, 130, 246, 0.85); color: #ffffff; border: 1px solid #3b82f6;",
        _ => "background: rgba(245, 158, 11, 0.85); color: #1a1a1a; border: 1px solid #f59e0b;"
    };

    /// <summary>Opens the read-only booking-summary modal; full editing happens on the separate /pj/bookings page (linked from the modal).</summary>
    private void OpenQuickDetailModal(BookingModel b)
    {
        _selectedBooking = b;
        _showQuickModal = true;
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= HandleAuthChanged;
        Theme.OnThemeChanged -= HandleThemeChanged;
    }
