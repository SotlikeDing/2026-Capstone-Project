@* Password-reset request page (route: /forgot-password), public/anonymous. Submits an
   email to Api.ForgotPasswordAsync, which triggers UserController.ForgotPassword server-side
   to email a reset link; see ResetPassword.razor for the link-consuming side. *@
@page "/wagwoord-vergeet"
@page "/forgot-password"
@inject MikpuntApiService Api

<PageTitle>Wagwoord Vergeet | MikPunt</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="mp-card">
            <h2 class="brand-font text-gold mb-3 text-center">Wagwoord Herstel</h2>
            <p class="text-muted text-center mb-4">Voer jou geregistreerde e-posadres in en ons sal vir jou 'n herstelskakel stuur.</p>

            @if (_sent)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>Wagwoord herstel e-pos is gestuur na <strong>@_sentEmail</strong>! Kontroleer asseblief jou inboks.</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@_errorMessage</div>
                    </div>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="mp-form-group mb-3">
                    <label class="mp-form-label">E-posadres</label>
                    <InputText @bind-Value="_model.Email" class="form-control mp-form-input" placeholder="jagter@mikpunt.co.za" />
                </div>

                <button type="submit" class="mp-btn mp-btn-primary w-100 mb-3" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Stuur tans...</span>
                    }
                    else
                    {
                        <span>Stuur Herstelskakel</span>
                    }
                </button>
            </EditForm>

            <div class="text-center mt-3">
                <a href="/teken-in" class="text-gold text-decoration-none small">&larr; Terug na In Teken</a>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordForm _model = new();
    private bool _sent = false;
    private string _sentEmail = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isSubmitting = false;

    /// <summary>
    /// Client-side validates presence of an "@" (a real format check happens server-side
    /// too), then calls the API. Always shows the "sent" success state on success
    /// regardless of whether the email is actually registered - the API intentionally
    /// doesn't reveal account existence via this endpoint.
    /// </summary>
    private async Task HandleSubmit()
    {
        _errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(_model.Email) || !_model.Email.Contains('@'))
        {
            _errorMessage = "Voer asseblief 'n geldige e-posadres in.";
            return;
        }

        _isSubmitting = true;
        string targetEmail = _model.Email;

        var (success, msg) = await Api.ForgotPasswordAsync(targetEmail);
        _isSubmitting = false;

        if (success)
        {
            _sent = true;
            _sentEmail = targetEmail;
        }
        else
        {
            _errorMessage = msg;
        }
    }

    public class ForgotPasswordForm
    {
        public string Email { get; set; } = string.Empty;
    }
}
