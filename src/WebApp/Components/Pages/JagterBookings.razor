@* Hunter's own bookings list at /jagter/bookings: status-filterable table, a full booking-detail
   modal (with rejection reason, confirmed pricing breakdown, assigned PH/VG), a printable
   voucher/quotation modal (native browser print via a print-only stylesheet at the bottom of
   this file, not a PDF library), and deposit-payment/cancel actions. Needs a signed-in Jagter
   (or Admin); everyone sees only their own bookings (LoadBookings scopes by CurrentUser.UserId). *@
@page "/jagter/besprekings"
@page "/jagter/bookings"
@inject MikpuntApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>My Besprekings | MikPunt</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="p-5 text-center"><div class="spinner-border text-gold"></div></div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Teken asseblief eers in</h3>
        <p class="text-muted mb-4">U besprekings is slegs sigbaar vir aangemelde jagters.</p>
        <a href="/teken-in?returnUrl=/jagter/besprekings" class="mp-btn mp-btn-primary">Teken In &rarr;</a>
    </div>
}
else if (!Auth.HasRole("Jagter") && !Auth.HasRole("Admin"))
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Toegang Beperk: Jagter Rol Benodig</h3>
        <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">
            Besprekings word deur jagters gemaak. Aktiveer die <strong>Jagter</strong> rol op u profiel om jagte te bespreek en hulle hier te bestuur.
        </p>
        <a href="/profiel" class="mp-btn mp-btn-primary">+ Aktiveer Jagter Rol op Profiel &rarr;</a>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 no-print">
        <div>
            <h1 class="brand-font text-gold mb-1">Bestuur My Jag Besprekings</h1>
            <p class="text-muted mb-0">Hersien jou besprekings op plase en pakkette, bekyk redes vir enige afkeurings, of voltooi deposito-betalings.</p>
        </div>

        <a href="/markplein" class="mp-btn mp-btn-primary mp-btn-sm">+ Bespreek Nuwe Jag</a>
    </div>

    <!-- Filters -->
    <div class="d-flex gap-2 mb-4 flex-wrap no-print">
        <button class="mp-btn @(string.IsNullOrEmpty(_statusFilter) ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _statusFilter = ""'>Alle Statusse</button>
        <button class="mp-btn @(_statusFilter == "Approved" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _statusFilter = "Approved"'>Goedgekeur</button>
        <button class="mp-btn @(_statusFilter == "Pending" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _statusFilter = "Pending"'>Afwagtend</button>
        <button class="mp-btn @(_statusFilter == "Paid" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _statusFilter = "Paid"'>Betaal</button>
        <button class="mp-btn @(_statusFilter == "Rejected" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _statusFilter = "Rejected"'>Van Hand Gewys</button>
        <button class="mp-btn @(_statusFilter == "Cancelled" ? "mp-btn-primary" : "mp-btn-secondary") mp-btn-sm" @onclick='() => _statusFilter = "Cancelled"'>Gekanselleer</button>
    </div>

    @if (!string.IsNullOrEmpty(_cancelError))
    {
        <div class="alert alert-danger no-print">@_cancelError</div>
    }

    <div class="mp-card no-print">
        @if (FilteredBookings.Count() == 0)
        {
            <div class="text-center p-4 text-muted">Geen besprekings gevind nie.</div>
        }
        else
        {
            <div class="mp-table-responsive">
                <table class="mp-table">
                    <thead>
                        <tr>
                            <th>Titel / Plaas</th>
                            <th>Datums</th>
                            <th>Jagters &amp; Waarnemers</th>
                            <th>Ingeslote Wild</th>
                            <th>Totale Prys</th>
                            <th>Status &amp; Terugvoer</th>
                            <th>Aksie</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in FilteredBookings)
                        {
                            <tr @onclick="() => OpenDetailModal(b)" style="cursor: pointer;" title="Klik om volledige besonderhede te sien">
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(b.PackageTitle) ? "Jagekspedisie" : b.PackageTitle)</strong>
                                    <div class="small text-muted">@b.FarmName</div>
                                    <div class="small text-gold" style="font-family: monospace;">Ref: @b.PaymentReference</div>
                                </td>
                                <td>
                                    <div>@b.StartDate.ToString("dd MMM") – @b.EndDate.ToString("dd MMM yyyy")</div>
                                    <div class="small text-muted">@Math.Max(1, (b.EndDate - b.StartDate).Days) dae ekspedisie</div>
                                </td>
                                <td>@b.HunterCount Jagters, @b.ObserverCount Waarnemers</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (b.BookedSpecies != null && b.BookedSpecies.Count > 0)
                                        {
                                            @foreach (var sp in b.BookedSpecies)
                                            {
                                                <span class="mp-badge">@sp</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Volgens pakket</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (b.TotalPrice > 0)
                                    {
                                        <strong class="text-gold">@Money.Format(b.TotalPrice, b.PriceBreakdown?.Currency, "N0")</strong>
                                        <span class="small text-muted ms-1">@Money.ZarHint(b.TotalPrice, b.PriceBreakdown?.Currency, _usdToZar)</span>
                                    }
                                    else
                                    {
                                        <a href="@($"/kontak?subject={Uri.EscapeDataString($"Bespreking #{b.Id} het geen geldige prys nie")}&message={Uri.EscapeDataString($"Goeiedag, my bespreking #{b.Id} vertoon geen geldige prys nie. Kan julle dit asseblief regstel?")}")" class="small text-warning">⚠️ Kontak die administrateur</a>
                                    }
                                </td>
                                <td>
                                    @if (b.Status == "Paid")
                                    {
                                        <span class="mp-badge mp-badge-success">Betaal (Bevestig) &#10003;</span>
                                    }
                                    else if (b.Status == "Approved")
                                    {
                                        <span class="mp-badge mp-badge-success">Goedgekeur (Gereed vir Betaling) &#10003;</span>
                                    }
                                    else if (b.Status == "PendingStaffAcceptance")
                                    {
                                        <span class="mp-badge mp-badge-warning">Wag op PH/VG se Bevestiging &#9203;</span>
                                    }
                                    else if (b.Status == "Pending")
                                    {
                                        <span class="mp-badge mp-badge-warning">In Afwagting (PJ Hersiening) &#9203;</span>
                                    }
                                    else if (b.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary">Deur u Gekanselleer</span>
                                    }
                                    else if (b.Status == "Rejected")
                                    {
                                        <div>
                                            <span class="mp-badge mp-badge-danger mb-1">Van Hand Gewys &#10007;</span>
                                            <div class="p-2 rounded mt-1 small" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35); max-width: 280px;">
                                                <div class="fw-bold text-danger" style="font-size: 11.5px;">
                                                    Rede: @(!string.IsNullOrWhiteSpace(b.RejectionReason) ? b.RejectionReason : "Onvoldoende beskikbaarheid")
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(b.RejectionNotes))
                                                {
                                                    <div class="text-muted mt-1 fst-italic" style="font-size: 11px;">
                                                        "@b.RejectionNotes"
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="mp-badge mp-badge-info">@StatusLabels.Booking(b.Status)</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1 align-items-start" @onclick:stopPropagation="true">
                                         <button class="mp-btn mp-btn-secondary mp-btn-sm" @onclick="() => OpenDetailModal(b)">
                                            Besonderhede 🔍
                                        </button>

                                        @if (b.Status == "Approved" || b.Status == "Paid")
                                        {
                                            <button class="mp-btn mp-btn-secondary mp-btn-sm" @onclick="() => OpenVoucherModal(b)">
                                                Bekyk Bewys 📜
                                            </button>
                                            @if (b.Status == "Approved")
                                            {
                                                <button class="mp-btn mp-btn-primary mp-btn-sm" @onclick="() => PayBooking(b)">
                                                    Betaal Deposito 💳
                                                </button>
                                            }
                                        }
                                        else if (b.Status == "PendingStaffAcceptance")
                                        {
                                            <span class="small text-muted" style="font-size: 11px;">Wag op PH/VG bevestiging</span>
                                        }
                                        else if (b.Status == "Pending")
                                        {
                                            <span class="small text-muted" style="font-size: 11px;">Wag op PJ toewysing</span>
                                        }
                                        else if (b.Status is "Rejected" or "Cancelled")
                                        {
                                            <a href="/markplein" class="mp-btn mp-btn-secondary mp-btn-sm" style="font-size: 11px;">
                                                Ander Pakkette 🏹
                                            </a>
                                        }

                                        @if (b.Status is "Pending" or "PendingStaffAcceptance" or "Approved")
                                        {
                                            <button class="mp-btn mp-btn-danger mp-btn-sm py-0 px-2" style="font-size: 11px;" @onclick="() => CancelBooking(b.Id)">
                                                Kanselleer
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Trips the hunter joins as an added hunter: no price, payment or voucher (the main hunter pays) -->
    @if (_companionTrips.Count > 0)
    {
        <div class="mp-card mt-4 no-print">
            <h4 class="brand-font text-gold mb-1">Reise Waarby Ek Aansluit</h4>
            <p class="small text-muted mb-3">Besprekings waar 'n ander jagter jou as medejagter bygevoeg het. Die hoofjagter is verantwoordelik vir betaling.</p>
            <div class="mp-table-responsive">
                <table class="mp-table">
                    <thead>
                        <tr>
                            <th>Titel / Plaas</th>
                            <th>Datums</th>
                            <th>Hoofjagter</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _companionTrips)
                        {
                            <tr @onclick="() => _selectedTrip = t" style="cursor: pointer;" title="Klik om besonderhede te sien">
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(t.PackageTitle) ? "Jagekspedisie" : t.PackageTitle)</strong>
                                    <div class="small text-muted">@t.FarmName</div>
                                </td>
                                <td class="small">@t.StartDate.ToString("dd MMM yyyy") - @t.EndDate.ToString("dd MMM yyyy")</td>
                                <td class="small">@t.MainHunterName</td>
                                <td><span class="mp-badge mp-badge-info">@StatusLabels.Booking(t.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_selectedTrip != null)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3" style="background: rgba(0,0,0,0.85); z-index: 2200; overflow-y: auto;" @onclick="() => _selectedTrip = null">
            <div class="mp-card" style="width: 720px; max-width: 98%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
                <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3 border-secondary">
                    <div>
                        <span class="mp-badge mp-badge-warning mb-1">Medejagter</span>
                        <h3 class="brand-font text-gold mb-1">@(string.IsNullOrWhiteSpace(_selectedTrip.PackageTitle) ? "Jagekspedisie" : _selectedTrip.PackageTitle)</h3>
                        <div class="small text-muted">Plaas: <strong>@_selectedTrip.FarmName</strong>@(string.IsNullOrWhiteSpace(_selectedTrip.Province) ? "" : $" ({_selectedTrip.Province})") | Hoofjagter: <strong>@_selectedTrip.MainHunterName</strong></div>
                    </div>
                    <button type="button" class="btn-close pj-modal-close" aria-label="Maak toe" @onclick="() => _selectedTrip = null"></button>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="mp-card p-3 h-100" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-gold fw-bold mb-2">📅 Datums &amp; Status</h6>
                            <div class="small mb-1"><span class="text-muted">Aankoms:</span> <strong>@_selectedTrip.StartDate.ToString("dddd, dd MMMM yyyy")</strong></div>
                            <div class="small mb-1"><span class="text-muted">Vertrek:</span> <strong>@_selectedTrip.EndDate.ToString("dddd, dd MMMM yyyy")</strong></div>
                            <div class="small"><span class="text-muted">Status:</span> <span class="mp-badge">@StatusLabels.Booking(_selectedTrip.Status)</span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mp-card p-3 h-100" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-gold fw-bold mb-2">🔫 Gidse &amp; Groep</h6>
                            <div class="small mb-1"><span class="text-muted">Uitruster (PJ):</span> @(_selectedTrip.PjName ?? "-")</div>
                            <div class="small mb-1"><span class="text-muted">PH:</span> @(_selectedTrip.PhName ?? "Wag op toewysing")</div>
                            <div class="small mb-1"><span class="text-muted">Videograaf:</span> @(_selectedTrip.VgName ?? "-")</div>
                            <div class="small"><span class="text-muted">Groep:</span> @_selectedTrip.HuntGuests jagters, @_selectedTrip.NonHuntGuests waarnemers</div>
                        </div>
                    </div>
                </div>

                @if (_selectedTrip.BookedSpecies.Count > 0)
                {
                    <div class="mp-card p-3 mb-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                        <h6 class="text-gold fw-bold mb-2">🦌 Ingeslote / Gevraagde Wild</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sp in _selectedTrip.BookedSpecies)
                            {
                                <span class="mp-badge">@sp</span>
                            }
                        </div>
                    </div>
                }

                <BookingHuntersPanel BookingId="_selectedTrip.Id" OnLeft="OnLeftTrip" />

                <div class="small text-muted mb-3">Prys en betaling word deur die hoofjagter hanteer.</div>
                <button type="button" class="mp-btn mp-btn-secondary" @onclick="() => _selectedTrip = null">Maak Toe</button>
            </div>
        </div>
    }

    <!-- Hunter Full Booking Details Modal -->
    @if (_showDetailModal && _selectedBooking != null)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3" style="background: rgba(0,0,0,0.85); z-index: 2200; overflow-y: auto;" @onclick="CloseDetailModal">
            <div class="mp-card" style="width: 720px; max-width: 98%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
                <!-- Modal Header -->
                <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3 border-secondary">
                    <div>
                        <span class="mp-badge mp-badge-warning mb-1">Ekspedisie Besonderhede</span>
                        <h3 class="brand-font text-gold mb-1">@(!string.IsNullOrWhiteSpace(_selectedBooking.PackageTitle) ? _selectedBooking.PackageTitle : "Jagekspedisie")</h3>
                        <div class="small text-muted">
                            Plaas: <strong>@_selectedBooking.FarmName</strong> | Verwysingsnommer: <strong class="text-gold" style="font-family: monospace;">@_selectedBooking.PaymentReference</strong>
                        </div>
                    </div>
                    <button type="button" class="btn-close pj-modal-close" aria-label="Maak toe" @onclick="CloseDetailModal"></button>
                </div>

                <!-- Status Banner / Feedback -->
                @if (_selectedBooking.Status == "Cancelled")
                {
                    <div class="alert alert-secondary mb-4 p-3">
                        <h5 class="fw-bold mb-1">Bespreking Gekanselleer</h5>
                        <p class="small mb-0">U het hierdie besprekingsversoek gekanselleer.</p>
                    </div>
                }
                else if (_selectedBooking.Status == "Rejected")
                {
                    <div class="alert alert-danger mb-4 p-3 border border-danger">
                        <h5 class="fw-bold mb-2"> Besprekingsversoek Van Hand Gewys</h5>
                        <p class="small mb-2">Die geregistreerde Uitruster (PJ) kon nie hierdie spesifieke besprekingsversoek aanvaar nie om die volgende rede:</p>
                        <div class="p-2 rounded mb-2" style="background: rgba(239, 68, 68, 0.15); border-left: 3px solid #ef4444;">
                            <strong>Rede:</strong> @(!string.IsNullOrWhiteSpace(_selectedBooking.RejectionReason) ? _selectedBooking.RejectionReason : "Onvoldoende beskikbaarheid op die gekose datums.")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selectedBooking.RejectionNotes))
                        {
                            <div class="small">
                                <strong>Notas van Uitruster:</strong> @_selectedBooking.RejectionNotes
                            </div>
                        }
                    </div>
                }
                else if (_selectedBooking.Status == "Approved")
                {
                    <div class="alert alert-success mb-4 p-3 border border-success">
                        <h6 class="fw-bold mb-1"> Goedgekeur deur Uitruster!</h6>
                        <div class="small">U ekspedisie is goedgekeur en u PH gids is toegewys. Voltooi asseblief die deposito-betaling om u datums finaal te verseker.</div>
                    </div>
                }
                else if (_selectedBooking.Status == "PendingStaffAcceptance")
                {
                    <div class="alert alert-warning mb-4 p-3 border border-warning text-dark">
                        <h6 class="fw-bold mb-1">⏳ Wag op PH/VG se Bevestiging</h6>
                        <div class="small">Die Uitruster (PJ) het u gids(e) gekies. U ekspedisie word outomaties goedgekeur sodra hulle die toewysing aanvaar.</div>
                    </div>
                }
                else if (_selectedBooking.Status == "Pending")
                {
                    <div class="alert alert-warning mb-4 p-3 border border-warning text-dark">
                        <h6 class="fw-bold mb-1">⏳ In Afwagting van Goedkeuring</h6>
                        <div class="small">U versoek word tans deur die Uitruster (PJ) hersien om gidsbeskikbaarheid en plaasreëlings te finaliseer.</div>
                    </div>
                }
                else if (_selectedBooking.Status == "Paid")
                {
                    <div class="alert alert-success mb-4 p-3 border border-success">
                        <h6 class="fw-bold mb-1">✓ Betaal — Deposito Ontvang</h6>
                        <div class="small">U deposito is ontvang en u datums is finaal bevestig. Ons sien uit daarna om u by die plaas te verwelkom.</div>
                    </div>
                }
                else if (_selectedBooking.Status == "Completed")
                {
                    <div class="alert alert-success mb-4 p-3 border border-success">
                        <h6 class="fw-bold mb-1">✓ Ekspedisie Suksesvol Afgehandel</h6>
                        <div class="small">Hierdie ekspedisie is afgehandel. Ons hoop u het 'n uitstekende jagondervinding gehad!</div>
                    </div>
                }

                <!-- Details Grid -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="mp-card p-3 h-100" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-gold fw-bold mb-2">📅 Datums &amp; Duur</h6>
                            <div class="small mb-1"><span class="text-muted">Aankoms:</span> <strong>@_selectedBooking.StartDate.ToString("dddd, dd MMMM yyyy")</strong></div>
                            <div class="small mb-1"><span class="text-muted">Vertrek:</span> <strong>@_selectedBooking.EndDate.ToString("dddd, dd MMMM yyyy")</strong></div>
                            <div class="small"><span class="text-muted">Tydsduur:</span> <span class="mp-badge mp-badge-warning">@Math.Max(1, (_selectedBooking.EndDate - _selectedBooking.StartDate).Days) Dae</span></div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mp-card p-3 h-100" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-gold fw-bold mb-2">👥 Gaste &amp; Jagters</h6>
                            <div class="small mb-1"><span class="text-muted">Aktiewe Jagters:</span> <strong>@_selectedBooking.HunterCount</strong></div>
                            <div class="small mb-1"><span class="text-muted">Nie-jagters / Waarnemers:</span> <strong>@_selectedBooking.ObserverCount</strong></div>
                            <div class="small"><span class="text-muted">Totale Groep:</span> <strong>@(_selectedBooking.HunterCount + _selectedBooking.ObserverCount) persone</strong></div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mp-card p-3 h-100" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-gold fw-bold mb-2">🔫 Vuurwapens &amp; Gidse</h6>
                            <div class="small mb-1">
                                <span class="text-muted">Vuurwapen-reëling:</span>
                                <strong>@(_selectedBooking.FirearmOption == "Rental" ? "Huur van PH ter plaatse" : "Voer eie wapens in (SAPS 520)")</strong>
                            </div>
                            <div class="small">
                                <span class="text-muted">Toegewese PH:</span>
                                <span>@(!string.IsNullOrWhiteSpace(_selectedBooking.AssignedPhName) ? _selectedBooking.AssignedPhName : "Wag op toewysing")</span>
                            </div>
                            <div class="small mt-1">
                                <span class="text-muted">Videograaf (VG):</span>
                                <span>@(!string.IsNullOrWhiteSpace(_selectedBooking.AssignedVgName) ? _selectedBooking.AssignedVgName : (_selectedBooking.WantsVideographer ? "Versoek (Wag op toewysing)" : "Geen VG verlang nie"))</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mp-card p-3 h-100" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-gold fw-bold mb-2">💰 Finansies &amp; Prys</h6>
                            <div class="small mb-1"><span class="text-muted">Totale Prys:</span> <strong class="text-gold fs-6">@Money.Format(_selectedBooking.TotalPrice, _selectedBooking.PriceBreakdown?.Currency, "N0")</strong></div>
                            <div class="small"><span class="text-muted">Status:</span> <span class="mp-badge">@StatusLabels.Booking(_selectedBooking.Status)</span></div>
                        </div>
                    </div>
                </div>

                @if (_selectedBooking.BookedSpecies != null && _selectedBooking.BookedSpecies.Count > 0)
                {
                    <div class="mp-card p-3 mb-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                        <h6 class="text-gold fw-bold mb-2">🦌 Ingeslote / Gevraagde Wild</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sp in _selectedBooking.BookedSpecies)
                            {
                                <span class="mp-badge">@sp</span>
                            }
                        </div>
                    </div>
                }

                <!-- Confirmed Pricing Breakdown (Verblyf & Bokke) -->
                @if (_selectedBooking.PriceBreakdown != null)
                {
                    var pb = _selectedBooking.PriceBreakdown;
                    <div class="p-3 mb-4 rounded pj-confirmed-price-box">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <h6 class="text-success fw-bold mb-0">📜 Goedgekeurde Kwotasie &amp; Tariewe (Deur Uitruster Bevestig)</h6>
                            <span class="text-gold fw-bold fs-6">Totale Kwotasie: @Money.Format(_selectedBooking.TotalPrice, _selectedBooking.PriceBreakdown?.Currency, "N2")</span>
                        </div>
                        <div class="small text-muted mb-2">
                            Verblyf &amp; Akkommodasie (@pb.Days dae &bull; @pb.HunterCount Jagters @(pb.ObserverCount > 0 ? $"+ {pb.ObserverCount} Waarnemers" : "")):
                            <strong class="pj-accommodation-total ms-1">@Money.Format(pb.AccommodationTotal, pb.Currency, "N2")</strong>
                        </div>
                        @if (pb.ConfirmedSpecies != null && pb.ConfirmedSpecies.Count > 0)
                        {
                            <div class="small text-muted mb-1 fw-bold">Goedgekeurde Wildtariewe per Bok (Beskikbaar op Plaas):</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var sp in pb.ConfirmedSpecies)
                                {
                                    <span class="badge pj-species-tag p-2" style="font-size: 11px;">
                                        <strong>@sp.SpeciesName:</strong> @Money.Format(sp.PricePerAnimal, pb.Currency, "N2") @(sp.SelectedCount > 0 ? $" ({sp.SelectedCount}x ingereken = {Money.Format(sp.PricePerAnimal * sp.SelectedCount, pb.Currency)})" : "")
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }

                <BookingHuntersPanel BookingId="_selectedBooking.Id" />

                @if (TripLifecycle.IsFinished(_selectedBooking))
                {
                    <BookingTeamRatingPanel BookingId="_selectedBooking.Id" />
                }

                @if (!string.IsNullOrWhiteSpace(_selectedBooking.SpecialNotes))
                {
                    <div class="mp-card p-3 mb-4" style="background: rgba(217, 119, 6, 0.06); border: 1px solid rgba(217, 119, 6, 0.3);">
                        <h6 class="text-gold fw-bold mb-1">📝 My Notas &amp; Spesiale Versoeke:</h6>
                        <div class="small">@_selectedBooking.SpecialNotes</div>
                    </div>
                }

                <!-- Modal Footer -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top border-secondary">
                    <button type="button" class="mp-btn mp-btn-secondary" @onclick="CloseDetailModal">Maak Toe</button>

                    <div class="d-flex gap-2 flex-wrap">
                        @if (_selectedBooking.Status == "Approved" || _selectedBooking.Status == "Paid")
                        {
                            <button type="button" class="mp-btn mp-btn-secondary" @onclick="() => OpenVoucherModal(_selectedBooking)">
                                Bekyk Bewys / Voucher 📜
                            </button>
                        }
                        @if (_selectedBooking.Status == "Approved")
                        {
                            <button type="button" class="mp-btn mp-btn-primary" @onclick="() => PayBooking(_selectedBooking)">
                                Betaal Deposito Nou 💳
                            </button>
                        }
                        else if (_selectedBooking.Status is "Rejected" or "Cancelled")
                        {
                            <a href="/markplein" class="mp-btn mp-btn-primary">
                                Kies Alternatiewe Pakket 🏹
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Hunter Voucher Modal (Print & PDF) -->
    @if (_showVoucherModal && _activeVoucherBooking != null)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3" style="background: rgba(0,0,0,0.85); z-index: 2300; overflow-y: auto;">
            <div class="mp-card p-0" style="width: 820px; max-width: 98%; max-height: 92vh; display: flex; flex-direction: column;">
                <!-- Modal Header / Actions -->
                <div class="p-3 d-flex justify-content-between align-items-center border-bottom pj-voucher-bar">
