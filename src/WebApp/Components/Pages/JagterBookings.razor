@code {
    private List<BookingModel> _bookings = new();
    private List<CompanionTripModel> _companionTrips = new();
    private CompanionTripModel? _selectedTrip;
    private string _statusFilter = string.Empty;
    private bool _showDetailModal = false;
    private BookingModel? _selectedBooking;

    private bool _showVoucherModal = false;
    private BookingModel? _activeVoucherBooking;

    private decimal _usdToZar = 18m;

    protected override async Task OnInitializedAsync()
    {
        _usdToZar = (await Api.GetPublicSettingsAsync()).UsdToZarRate;
        Auth.OnAuthStateChanged += HandleAuthChanged;
        await LoadBookings();
    }

    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadBookings();
            StateHasChanged();
        });
    }

    /// <summary>Loads the signed-in hunter's own bookings and the trips they were added to (nothing when signed out).</summary>
    private async Task LoadBookings()
    {
        if (!Auth.IsAuthenticated || Auth.CurrentUser == null) return;
        var myUserId = Auth.CurrentUser.UserId;
        _bookings = await Api.GetHunterBookingsAsync(myUserId);
        _companionTrips = myUserId > 0 ? await Api.GetCompanionTripsAsync() : new();
    }

    /// <summary>The hunter left a trip they had been added to: close it and refresh the list.</summary>
    private async Task OnLeftTrip()
    {
        _selectedTrip = null;
        await LoadBookings();
    }

    private IEnumerable<BookingModel> FilteredBookings => _bookings.Where(b =>
        string.IsNullOrEmpty(_statusFilter) || b.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase)
    );

    private void OpenDetailModal(BookingModel b)
    {
        _selectedBooking = b;
        _showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
        _selectedBooking = null;
    }

    /// <summary>Opens the printable voucher/quotation modal for a confirmed (Approved/Paid) booking.</summary>
    private void OpenVoucherModal(BookingModel b)
    {
        _activeVoucherBooking = b;
        _showVoucherModal = true;
    }

    /// <summary>Triggers the browser's native print dialog - the print-only CSS at the bottom of this file hides everything except #voucherPrintArea for the printed/PDF-saved output.</summary>
    private async Task PrintVoucher()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    /// <summary>
    /// Routes to the payment page for this booking's deposit - the WebAPI works out the
    /// amount there. A booking with no real total is a data problem for an admin, so the
    /// hunter is sent to Contact instead of being shown a guessed price.
    /// </summary>
    private void PayBooking(BookingModel b)
    {
        CloseDetailModal();

        if (b.TotalPrice <= 0)
        {
            string subject = Uri.EscapeDataString($"Bespreking #{b.Id} het geen geldige prys nie");
            string message = Uri.EscapeDataString($"Goeiedag, my bespreking #{b.Id} ({b.PackageTitle ?? b.FarmName ?? "Bespreking"}) vertoon geen geldige prys nie. Kan julle dit asseblief regstel?");
            Nav.NavigateTo($"/kontak?subject={subject}&message={message}");
            return;
        }

        Nav.NavigateTo($"/betaling?bookingId={b.Id}");
    }

    /// <summary>The hunter cancelling their own request (allowed until it is paid). Shows the server's reason when it refuses.</summary>
    private async Task CancelBooking(int id)
    {
        var (ok, error) = await Api.UpdateBookingStatusAsync(id, "Cancelled");
        _cancelError = ok ? null : (error ?? "Kon nie die bespreking kanselleer nie.");
        await LoadBookings();
    }

    private string? _cancelError;

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= HandleAuthChanged;
    }
}
