                                <div style="font-weight: bold; font-size: 12px; color: #92400e; text-transform: uppercase; letter-spacing: 0.5px;">Amptelik Geverifieerde Ekspedisie-Bewys</div>
                                <div style="font-size: 11px; color: #666; font-family: monospace;">KODE: MP-SEC-@(_activeVoucherBooking.Id.ToString("D6"))-@(_activeVoucherBooking.PaymentReference?.Replace("-", "") ?? "EXP")</div>
                            </div>
                        </div>
                        <div style="text-align: right;">
