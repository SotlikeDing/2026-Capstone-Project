                            <div style="padding: 10px 12px; font-size: 12px; background: #fff;">
                                <div style="display: flex; justify-content: space-between; padding-bottom: 6px; border-bottom: 1px dashed #eee;">
                                    <span><strong>Verblyf &amp; Akkommodasie</strong> (@pb.Days dae &bull; @pb.HunterCount Jagters teen @Money.Format(pb.DailyRateHunter, pb.Currency)/dag @(pb.ObserverCount > 0 ? $"+ {pb.ObserverCount} Waarnemers teen {Money.Format(pb.DailyRateObserver, pb.Currency)}/dag" : "")):</span>
