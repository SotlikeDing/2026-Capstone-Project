@* Single advertisement detail page (route: /ads/{AdId}), public/no auth required.
   Records an impression once per page load and a click event when the sponsor's
   website link is followed, both for advertiser analytics. Nav is injected but
   unused - dead injection, harmless. *@
@page "/advertensies/{AdId:int}"
@page "/ads/{AdId:int}"
@inject MikpuntApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Advertensie Besonderhede | MikPunt</PageTitle>

@if (_ad == null)
{
    <div class="mp-card text-center p-5">
        <div class="spinner-border text-gold mb-3" role="status"></div>
        <div class="fs-4 text-gold">Laai tans advertensiebesonderhede...</div>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="mp-card p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="mp-badge mp-badge-warning">@MikpuntApiService.FormatCategory(_ad.Category)</span>
                    <span class="small text-muted">ID: #@_ad.Id</span>
                </div>

                <h1 class="brand-font text-gold mb-3">@_ad.Title</h1>

                <!-- Main Active Image -->
                <div style="height: 380px; overflow: hidden; border-radius: 12px; background: #111;" class="mb-3 border border-secondary">
                    <img src="@_activeImageUrl" alt="@_ad.Title" style="width: 100%; height: 100%; object-fit: contain; background: #0b0b0b;" />
                </div>

                <!-- Gallery Thumbnails if multiple images -->
                @if (_ad.ImageUrls != null && _ad.ImageUrls.Count > 1)
                {
                    <div class="d-flex gap-2 overflow-auto pb-2 mb-4">
                        @foreach (var img in _ad.ImageUrls)
                        {
                            var selected = img == _activeImageUrl;
                            <div class="rounded overflow-hidden cursor-pointer border @(selected ? "border-warning border-2" : "border-secondary")" 
                                 style="width: 80px; height: 60px; flex-shrink: 0; opacity: @(selected ? "1" : "0.65"); transition: all 0.2s;"
                                 @onclick="() => _activeImageUrl = img">
                                <img src="@img" alt="Foto voorskou" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                        }
                    </div>
                }

                <div class="fs-5 leading-relaxed text-muted mb-4" style="line-height: 1.6;">
                    @_ad.Description
                </div>

                <div class="p-3 border border-secondary rounded mb-4 bg-dark">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="small text-muted mb-1">Borg &amp; Maatskappy:</div>
                            <div class="fw-bold text-gold fs-5">@_ad.AdvertiserName</div>
                            @if (!string.IsNullOrEmpty(_ad.ContactNumber))
                            {
                                <div class="small text-muted mt-1">Kontak: @_ad.ContactNumber</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_ad.AddressCity))
                            {
                                <div class="small text-muted mt-1">Ligging: 📍 @_ad.AddressCity@(!string.IsNullOrWhiteSpace(_ad.AddressRegion) ? $", {_ad.AddressRegion}" : "")</div>
                            }
                        </div>
                        <div>
                            <span class="badge bg-secondary px-3 py-2">Geverifieerde Adverteerder</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a href="/advertensies" class="mp-btn mp-btn-secondary">&larr; Terug na Advertensies</a>
                    @if (HasValidTargetUrl)
                    {
                        <a href="@FormattedTargetUrl" target="_blank" rel="noopener noreferrer" class="mp-btn mp-btn-primary" @onclick="HandleWebsiteClick">
                            Besoek Borg se Webtuiste &rarr;
                        </a>
                    }
                    else
                    {
                        <button type="button" class="mp-btn mp-btn-secondary" disabled title="Geen eksterne webtuiste vir hierdie advertensie beskikbaar nie" style="opacity: 0.5; cursor: not-allowed;">
                            Geen Webtuiste Beskikbaar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int AdId { get; set; }
    private AdvertisementModel? _ad;
    private string _activeImageUrl = string.Empty;
    private bool _impressionRecorded = false;
    private int _recordedAdId = 0;

    /// <summary>True only when TargetUrl is a real, non-placeholder ("#" or "/") absolute http/https URL - gates whether the "visit website" button is enabled or shown disabled.</summary>
    private bool HasValidTargetUrl =>
        !string.IsNullOrWhiteSpace(_ad?.TargetUrl) &&
        _ad.TargetUrl.Trim() != "#" &&
        _ad.TargetUrl.Trim() != "/" &&
        (Uri.TryCreate(FormattedTargetUrl, UriKind.Absolute, out var uri) && 
         (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps));

    /// <summary>Normalizes TargetUrl by prepending "https://" when the stored value has no scheme, so an advertiser-entered value like "example.co.za" still produces a working link.</summary>
    private string FormattedTargetUrl
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_ad?.TargetUrl)) return string.Empty;
            var url = _ad.TargetUrl.Trim();
            if (url == "#" || url == "/") return string.Empty;
            if (!url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
                !url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
                return "https://" + url;
            }
            return url;
        }
    }

    /// <summary>Loads the ad and defaults the gallery's active image to the ad's primary ImageUrl.</summary>
    protected override async Task OnInitializedAsync()
    {
        _ad = await Api.GetAdByIdAsync(AdId);
        if (_ad != null)
        {
            _activeImageUrl = _ad.ImageUrl;
        }
    }

    /// <summary>Records one impression per component lifetime on first render - the _recordedAdId/_impressionRecorded pair is redundant (both guard the same thing) but harmless double-booking against re-renders.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_impressionRecorded && _recordedAdId != AdId)
        {
            _impressionRecorded = true;
            _recordedAdId = AdId;
            await Api.RecordAdImpressionAsync(AdId, Auth.CurrentUser?.UserId);
        }
    }

    /// <summary>Records a click event before the outbound link opens (the anchor's own href/target still does the actual navigation - this only fires the tracking call).</summary>
    private async Task HandleWebsiteClick()
    {
        if (_ad != null)
        {
            await Api.RecordAdClickAsync(_ad.Id, Auth.CurrentUser?.UserId);
        }
    }
}

