    }

    /// <summary>Submits the rejection; server-side this also frees any reserved package slots and notifies the hunter (per the modal's own notice text).</summary>
    private async Task ConfirmRejection()
    {
        if (_rejectingBooking == null) return;

        bool ok = await Api.RejectBookingAsync(_rejectingBooking.Id, _selectedRejectReason, _rejectNotes);
        if (ok)
        {
            _notificationMsg = $"Besprekingsversoek vir '{_rejectingBooking.PackageTitle}' is van die hand gewys. Kennisgewing is aan die jagter gestuur en slots is herstel.";
            _showRejectModal = false;
            await LoadData();
        }
        else
        {
            _rejectError = "Kon nie die bespreking van die hand wys nie. Probeer asseblief weer.";
        }
    }

