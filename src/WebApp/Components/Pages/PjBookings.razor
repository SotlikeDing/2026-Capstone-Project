@code {
    private List<BookingModel> _bookings = new();
    private List<TeamMemberResponse> _teamMembers = new();
    private List<TeamMemberResponse> _phCandidates = new();
    private List<TeamMemberResponse> _vgCandidates = new();
    private List<FarmModel> _farms = new();
    private bool _loading = true;
    private string _notificationMsg = string.Empty;

    // Filters & Search (Fase 5)
    private string _currentFilter = "all"; // "all", "Pending", "Approved", "Rejected"
    private string _searchQuery = string.Empty;

    // Detail modal state
    private bool _showDetailModal = false;
    private BookingModel? _selectedDetailBooking;
    private List<BookingAuditLog>? _detailAuditLogs;

    // Team Schedule Matrix modal state
    private bool _showScheduleModal = false;

    // Approval & Reassignment modal state (Fase 1)
    private bool _showApprovalModal = false;
    private bool _isReassigning = false;
    private BookingModel? _activeBooking;
    private int _selectedPhUserId = 0;
    private int _selectedVgUserId = 0;
    private string _approvalError = string.Empty;
    // Auto-included prices from staff
    private decimal _phTotal = 0m;
    private decimal _vgTotal = 0m;
    private bool _phIsDangerousGame = false;
    private bool _phRatesNotConfigured = false;
    private string _vgPackageName = string.Empty;
    private List<ServicePackageModel> _vgPackages = new();
    private int _selectedVgPackageId = 0;

    // Enterprise Conflict Override & Currency/Deposit State
    private string _selectedCurrency = Money.PackageCurrency;   // quote in the package currency by default
    private decimal _depositPercentage = 50m;
    private decimal _depositAmount = 0m;
    private decimal _outstandingBalance = 0m;
    private bool _confirmScheduleOverride = false;
    private string _scheduleOverrideReason = string.Empty;

    // Pricing Confirmation State (Verblyf & Prys per Bok)
    private int _expeditionDays = 1;
    private decimal _dailyRateHunter = 850m;
    private decimal _dailyRateObserver = 350m;
    private decimal _calculatedAccommodation = 0m;
    private decimal _confirmedAccommodationPrice = 0m;
    private List<ConfirmedSpeciesPriceItem> _farmSpeciesPrices = new();
    private decimal _gameTotal = 0m;
    private decimal _grandTotal = 0m;

    // Rejection modal state (Fase 2)
    private bool _showRejectModal = false;
    private BookingModel? _rejectingBooking;
    private string _selectedRejectReason = "Plaas is reeds vol bespreek op hierdie datums";
    private string _rejectNotes = string.Empty;
    private string _rejectError = string.Empty;

    // Voucher modal state (Fase 4)
    private bool _showVoucherModal = false;

    [SupplyParameterFromQuery(Name = "openVoucher")]
    private int? openVoucher { get; set; }

    /// <summary>Applies the active status filter tab and free-text search query to _bookings, newest first. Computed on every access (no caching) since the underlying list is small and this is only read during render.</summary>
    private IEnumerable<BookingModel> FilteredBookings
    {
        get
        {
            var query = _bookings.AsEnumerable();

            if (_currentFilter == "Pending")
                query = query.Where(b => b.Status == "Pending" || b.Status == "PendingStaffAcceptance");
            else if (_currentFilter == "Approved")
                query = query.Where(b => b.Status == "Approved" || b.Status == "Paid" || b.Status == "Completed");
            else if (_currentFilter == "Rejected")
                query = query.Where(b => b.Status == "Rejected");

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(b =>
                    (!string.IsNullOrEmpty(b.HunterName) && b.HunterName.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(b.HunterEmail) && b.HunterEmail.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(b.PackageTitle) && b.PackageTitle.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(b.FarmName) && b.FarmName.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(b.PaymentReference) && b.PaymentReference.ToLowerInvariant().Contains(q)) ||
                    (!string.IsNullOrEmpty(b.AssignedPhName) && b.AssignedPhName.ToLowerInvariant().Contains(q))
                );
            }

            return query.OrderByDescending(b => b.CreatedAt);
        }
    }

    /// <summary>Subscribes to auth/theme change events and does the initial data load if already authenticated with the right role at first render.</summary>
    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += HandleAuthChanged;
        Theme.OnThemeChanged += HandleThemeChanged;
        if (Auth.IsAuthenticated && (Auth.HasRole("PJ") || Auth.HasRole("Admin")))
        {
            await LoadData();
        }
    }

    /// <summary>Re-renders when the light/dark theme toggles (the page's inline &lt;style&gt; block has theme-scoped selectors).</summary>
    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Reloads booking data once login completes (auth state resolves asynchronously after initial render, e.g. from a stored token) or clears/re-renders on logout.</summary>
    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            if (Auth.IsAuthenticated && (Auth.HasRole("PJ") || Auth.HasRole("Admin")))
            {
                await LoadData();
            }
            StateHasChanged();
        });
    }

    /// <summary>Reloads on every parameter change (covers navigating here from elsewhere) and, if the URL carries an ?openVoucher=&lt;id&gt; query param, jumps straight to that booking's voucher modal.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Auth.IsAuthenticated && (Auth.HasRole("PJ") || Auth.HasRole("Admin")))
        {
            await LoadData();
            if (openVoucher.HasValue && openVoucher.Value > 0)
            {
                var target = _bookings.FirstOrDefault(b => b.Id == openVoucher.Value);
                if (target != null)
                {
                    OpenVoucherModal(target);
                }
            }
        }
    }

    /// <summary>
    /// Loads this PJ's bookings and team roster, then derives the PH/VG candidate lists
    /// for the assignment dropdown - including inserting the PJ themself as a candidate
    /// when they also hold the PH/VG role but aren't already on their own team roster.
    /// Known bug: Auth.CurrentUser?.UserId falls back to the hardcoded literal 1 if
    /// somehow null here (mirrors the same "?? 1"/"UserId = 1" placeholder pattern
    /// flagged in UserController.RefreshToken) - in the unlikely event auth state is
    /// inconsistent, this would silently load user 1's bookings instead of failing loudly.
    /// </summary>
    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var myUserId = Auth.CurrentUser?.UserId ?? 0;
            _bookings = await Api.GetBookingsForPjAsync(myUserId);
            _teamMembers = await Api.GetPjTeamMembersAsync(myUserId);
            try { _farms = await Api.GetFarmsAsync(); } catch { }

            // Populate PH candidates
            _phCandidates = _teamMembers.Where(m => string.Equals(m.Role, "PH", StringComparison.OrdinalIgnoreCase)).ToList();

            // If current PJ has PH role, allow choosing himself (Fase 1)
            if (Auth.HasRole("PH") && !_phCandidates.Any(c => c.UserId == myUserId))
            {
                _phCandidates.Insert(0, new TeamMemberResponse
                {
                    Id = 0,
                    UserId = myUserId,
                    Name = Auth.CurrentUser?.FirstName ?? "Ekself",
                    Surname = $"{Auth.CurrentUser?.LastName} (PJ & Geregistreerde PH)",
                    Role = "PH"
                });
            }

            // Populate VG candidates
            _vgCandidates = _teamMembers.Where(m => string.Equals(m.Role, "VG", StringComparison.OrdinalIgnoreCase)).ToList();

            // If current PJ has VG role, allow choosing himself
            if (Auth.HasRole("VG") && !_vgCandidates.Any(c => c.UserId == myUserId))
            {
                _vgCandidates.Insert(0, new TeamMemberResponse
                {
                    Id = 0,
                    UserId = myUserId,
                    Name = Auth.CurrentUser?.FirstName ?? "Ekself",
                    Surname = $"{Auth.CurrentUser?.LastName} (PJ & Geregistreerde VG)",
                    Role = "VG"
                });
            }
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Approved/Paid bookings (excluding currentBookingId) where staffUserId is already assigned as PH or VG on overlapping dates - drives the schedule-conflict warning in the approval modal.</summary>
    private List<BookingModel> GetStaffConflicts(int staffUserId, DateTime start, DateTime end, int currentBookingId)
    {
        if (staffUserId <= 0) return new List<BookingModel>();
        return _bookings.Where(b => b.Id != currentBookingId &&
                                    (b.Status == "Approved" || b.Status == "Paid") &&
                                    ((b.AssignedPhUserId.HasValue && b.AssignedPhUserId.Value == staffUserId) ||
                                     (b.AssignedVgUserId.HasValue && b.AssignedVgUserId.Value == staffUserId)) &&
                                    b.StartDate <= end && b.EndDate >= start).ToList();
    }

    /// <summary>Approved/Paid bookings on the same farm (excluding currentBookingId) with overlapping dates - drives the farm double-booking warning in the approval modal.</summary>
    private List<BookingModel> GetFarmConflicts(int? farmId, DateTime start, DateTime end, int currentBookingId)
    {
        if (!farmId.HasValue || farmId.Value <= 0) return new List<BookingModel>();
        return _bookings.Where(b => b.Id != currentBookingId &&
                                    (b.Status == "Approved" || b.Status == "Paid") &&
                                    b.FarmId.HasValue && b.FarmId.Value == farmId.Value &&
                                    b.StartDate < end && b.EndDate > start).ToList();
    }

