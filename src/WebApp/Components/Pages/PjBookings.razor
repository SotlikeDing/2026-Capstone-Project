    };

    /// <summary>
    /// Opens the approval/reassignment modal and seeds every field of its pricing
    /// worksheet: pre-selects existing PH/VG if already assigned (leaves the slot empty
    /// on a reassignment so the PJ must consciously re-pick rather than silently keeping
    /// a PH who just declined), fetches PH/VG day-rates, looks up the farm's daily
    /// accommodation rates and game inventory, and - if a price breakdown was already
    /// confirmed on a prior approval - restores every one of its values (species prices,
    /// VG package, currency, deposit %) instead of recomputing fresh defaults. Falls back
    /// to a hardcoded default species list when the farm's own inventory isn't available.
    /// </summary>
    private async Task OpenApprovalModal(BookingModel b, bool isReassignment = false)
    {
        _activeBooking = b;
        _isReassigning = isReassignment;
        _approvalError = string.Empty;
        _confirmScheduleOverride = false;
        _scheduleOverrideReason = string.Empty;

        if (b.AssignedPhUserId.HasValue && b.AssignedPhUserId.Value > 0)
            _selectedPhUserId = b.AssignedPhUserId.Value;
        else if (!isReassignment && _phCandidates.Count > 0)
            // Only auto-pick a default on a brand new assignment. On a reassignment
            // (e.g. after a decline) the PH slot is empty precisely because the PJ
            // needs to consciously choose someone else - defaulting to "first in the
            // list" here could silently re-select the very PH who just declined.
            _selectedPhUserId = _phCandidates.First().UserId;
        else
            _selectedPhUserId = 0;

        _selectedVgUserId = b.AssignedVgUserId ?? 0;
        // Reset before FetchVgRates() runs, not just _selectedVgUserId - otherwise its
        // "keep the current package if still valid for this VG" logic (meant for
        // switching VGs within one open modal) would silently carry over whatever
        // package was picked for a *different* booking opened earlier in this same
        // component instance, whenever that booking happened to share the same VG.
        _selectedVgPackageId = 0;

        await FetchPhRates();
        await FetchVgRates();
        // Initialize duration in days
        _expeditionDays = Math.Max(1, (b.EndDate - b.StartDate).Days);
        // FetchVgRates() above ran before _expeditionDays was set to this booking's
        // actual duration - recompute now that it's known so the shown VG total isn't
        // based on a stale value left over from whichever booking the modal last had open.
        ApplySelectedVgPackage();

        // Find farm
        var farm = _farms.FirstOrDefault(f => (b.FarmId.HasValue && f.Id == b.FarmId.Value) || 
                                              (!string.IsNullOrEmpty(b.FarmName) && string.Equals(f.Name, b.FarmName, StringComparison.OrdinalIgnoreCase)));
        if (farm == null && b.FarmId.HasValue && b.FarmId.Value > 0)
        {
            try { farm = await Api.GetFarmByIdAsync(b.FarmId.Value); } catch { }
        }

        // Daily rates for accommodation
        _dailyRateHunter = farm?.DailyRateHunter > 0 ? farm.DailyRateHunter : 850m;
        _dailyRateObserver = farm?.DailyRateObserver > 0 ? farm.DailyRateObserver : 350m;

        _calculatedAccommodation = (_activeBooking.HunterCount * _dailyRateHunter + _activeBooking.ObserverCount * _dailyRateObserver) * _expeditionDays;
        _confirmedAccommodationPrice = _activeBooking.ConfirmedAccommodationPrice ?? _calculatedAccommodation;

        // Populate available species on the farm
        _farmSpeciesPrices = new List<ConfirmedSpeciesPriceItem>();

        // Check if previously confirmed breakdown exists
        var existingBreakdown = _activeBooking.PriceBreakdown;

        // Restore the previously-confirmed VG package choice (if any) rather than
        // leaving whichever default FetchVgRates() picked - only meaningful once the
        // VG's package list has loaded and still contains that package.
        if (existingBreakdown != null && existingBreakdown.VgPackageId > 0
            && _vgPackages.Any(p => p.Id == existingBreakdown.VgPackageId))
        {
            _selectedVgPackageId = existingBreakdown.VgPackageId;
            ApplySelectedVgPackage();
        }

        if (existingBreakdown?.ConfirmedSpecies != null && existingBreakdown.ConfirmedSpecies.Count > 0)
        {
            _farmSpeciesPrices = existingBreakdown.ConfirmedSpecies.Select(s => new ConfirmedSpeciesPriceItem
            {
                SpeciesName = s.SpeciesName,
                PricePerAnimal = s.PricePerAnimal,
                AvailableCount = s.AvailableCount,
                SelectedCount = s.SelectedCount
            }).ToList();
            if (existingBreakdown.DailyRateHunter > 0) _dailyRateHunter = existingBreakdown.DailyRateHunter;
            if (existingBreakdown.DailyRateObserver > 0) _dailyRateObserver = existingBreakdown.DailyRateObserver;
            if (existingBreakdown.AccommodationTotal > 0) _confirmedAccommodationPrice = existingBreakdown.AccommodationTotal;
            if (!string.IsNullOrWhiteSpace(existingBreakdown.Currency)) _selectedCurrency = existingBreakdown.Currency;
            if (existingBreakdown.DepositPercentage > 0) _depositPercentage = existingBreakdown.DepositPercentage;
        }
        else if (farm != null && farm.GameInventory != null && farm.GameInventory.Count > 0)
        {
            foreach (var game in farm.GameInventory)
            {
                decimal initialPrice = game.PriceTrophy > 0 ? game.PriceTrophy : (game.PriceMale > 0 ? game.PriceMale : 5000m);
                int selected = (_activeBooking.BookedSpecies != null && _activeBooking.BookedSpecies.Any(s => string.Equals(s, game.SpeciesName, StringComparison.OrdinalIgnoreCase))) ? 1 : 0;
                _farmSpeciesPrices.Add(new ConfirmedSpeciesPriceItem
                {
                    SpeciesName = game.SpeciesName,
                    PricePerAnimal = initialPrice,
                    AvailableCount = game.AvailableCount,
                    SelectedCount = selected
                });
            }
        }
        else
        {
            // Default farm inventory if farm details not loaded
            var defaultSpecies = new List<(string Name, decimal Price, int Count)>
            {
                ("Koedoe", 8500m, 30),
                ("Rooibok", 1800m, 100),
                ("Vlakvark", 1200m, 50),
                ("Gemsbok", 7500m, 25),
                ("Blouwildebees", 6000m, 35),
                ("Sebra", 5500m, 20)
            };
            foreach (var (spName, spPrice, spCount) in defaultSpecies)
            {
                int selected = (_activeBooking.BookedSpecies != null && _activeBooking.BookedSpecies.Any(s => string.Equals(s, spName, StringComparison.OrdinalIgnoreCase))) ? 1 : 0;
                _farmSpeciesPrices.Add(new ConfirmedSpeciesPriceItem
                {
                    SpeciesName = spName,
                    PricePerAnimal = spPrice,
                    AvailableCount = spCount,
                    SelectedCount = selected
                });
            }
        }

        RecalculatePricing();
        _showApprovalModal = true;
    }

    /// <summary>Recomputes the grand total (accommodation + game + PH + VG), deposit amount and outstanding balance from current worksheet state. Called after any pricing input changes via @bind:after.</summary>
    private void RecalculatePricing()
    {
        if (_activeBooking == null) return;
        _calculatedAccommodation = (_activeBooking.HunterCount * _dailyRateHunter + _activeBooking.ObserverCount * _dailyRateObserver) * _expeditionDays;

        if (_confirmedAccommodationPrice <= 0)
            _confirmedAccommodationPrice = _calculatedAccommodation;

        _gameTotal = _farmSpeciesPrices.Sum(s => s.SelectedCount > 0 ? s.PricePerAnimal * s.SelectedCount : 0);
        _grandTotal = _confirmedAccommodationPrice + _gameTotal + _phTotal + _vgTotal;
        _depositAmount = _grandTotal * (_depositPercentage / 100m);
        _outstandingBalance = _grandTotal - _depositAmount;
    }

    /// <summary>When the per-day hunter/observer rate inputs change, recompute the calculated accommodation total and overwrite the (possibly manually-edited) confirmed price with it, then cascade to the grand total.</summary>
    private void OnDailyRatesChanged()
    {
        if (_activeBooking == null) return;
        _calculatedAccommodation = (_activeBooking.HunterCount * _dailyRateHunter + _activeBooking.ObserverCount * _dailyRateObserver) * _expeditionDays;
        _confirmedAccommodationPrice = _calculatedAccommodation;
        RecalculatePricing();
    }

    private void OnAccommodationChanged()
    {
        RecalculatePricing();
    }

    private void OnGameSelectionChanged()
    {
        RecalculatePricing();
    }

    /// <summary>
    /// Validates the approval worksheet (PH required; any staff schedule conflict needs
    /// an override reason + confirmation checkbox), builds a BookingPriceBreakdown
    /// snapshot of every confirmed figure, JSON-serializes it, and calls
    /// ApproveBookingWithStaffAsync - which server-side moves the booking to
    /// "PendingStaffAcceptance" rather than directly to "Approved" (see Bookings_db's
    /// staff-assignment acceptance workflow) until the assigned PH/VG accept.
    /// </summary>
    private async Task ConfirmApproval()
    {
        if (_activeBooking == null) return;

        if (_selectedPhUserId <= 0)
        {
            _approvalError = "Kies asseblief 'n Professionele Jagter (PH) gids. 'n PH is wetlik verpligtend vir elke ekspedisie.";
            return;
        }

        var phConflicts = GetStaffConflicts(_selectedPhUserId, _activeBooking.StartDate, _activeBooking.EndDate, _activeBooking.Id);
        var vgConflicts = _selectedVgUserId > 0 ? GetStaffConflicts(_selectedVgUserId, _activeBooking.StartDate, _activeBooking.EndDate, _activeBooking.Id) : new List<BookingModel>();

        if ((phConflicts.Any() || vgConflicts.Any()) && (!_confirmScheduleOverride || string.IsNullOrWhiteSpace(_scheduleOverrideReason)))
        {
            _approvalError = "Daar is 'n skedule-oorvleueling met die gekose personeel. Vul asseblief die verpligte oorvleuelingsrede in en merk die gemagtigde bevestigingsblokkie.";
            return;
        }

        var breakdown = new BookingPriceBreakdown
        {
            Days = _expeditionDays,
            HunterCount = _activeBooking.HunterCount,
            ObserverCount = _activeBooking.ObserverCount,
            DailyRateHunter = _dailyRateHunter,
            DailyRateObserver = _dailyRateObserver,
            AccommodationTotal = _confirmedAccommodationPrice,
            ConfirmedSpecies = _farmSpeciesPrices.Where(s => s.PricePerAnimal > 0).ToList(),
            GameTotal = _gameTotal,
            PhTotal = _phTotal,
            VgTotal = _vgTotal,
            VgPackageId = _selectedVgPackageId,
            VgPackageTitle = _vgPackageName,
            GrandTotal = _grandTotal,
            Currency = _selectedCurrency,
            DepositPercentage = _depositPercentage,
            DepositAmount = _depositAmount,
            OutstandingBalance = _outstandingBalance,
            ScheduleOverrideReason = (phConflicts.Any() || vgConflicts.Any()) ? _scheduleOverrideReason : null,
            ConfirmedAt = DateTime.UtcNow
        };
        string breakdownJson = System.Text.Json.JsonSerializer.Serialize(breakdown);

        int? vgId = _selectedVgUserId > 0 ? _selectedVgUserId : null;
        bool ok = await Api.ApproveBookingWithStaffAsync(_activeBooking.Id, _selectedPhUserId, vgId, _grandTotal, _confirmedAccommodationPrice, breakdownJson);

        if (ok)
        {
            var phName = _phCandidates.FirstOrDefault(c => c.UserId == _selectedPhUserId)?.Name ?? "PH Gids";
            var currSymbol = _selectedCurrency == "ZAR" ? "R" : "$";
            if (_isReassigning)
            {
                _notificationMsg = $"Span en kwotasie vir bespreking '{_activeBooking.PackageTitle}' is suksesvol opgedateer na PH ({phName}) teen {currSymbol} {_grandTotal:N2} {_selectedCurrency}.";
            }
            else
            {
                _notificationMsg = $"Span vir bespreking '{_activeBooking.PackageTitle}' is toegewys (PH: {phName}) teen {currSymbol} {_grandTotal:N2} {_selectedCurrency}. Wag nou vir PH{(vgId.HasValue ? "/VG" : "")} se aanvaarding voordat die bespreking goedgekeur en slot(s) afgetrek word.";
            }
            _showApprovalModal = false;
            await LoadData();
        }
        else
        {
            _approvalError = "Fout met goedkeuring van bespreking. Probeer asseblief weer.";
        }
    }

    private void OpenRejectModal(BookingModel b)
    {
        _rejectingBooking = b;
        _selectedRejectReason = "Plaas is reeds vol bespreek op hierdie datums";
        _rejectNotes = string.Empty;
