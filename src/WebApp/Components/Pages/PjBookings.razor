    /// <summary>PH dropdown onchange handler: re-fetches that PH's day rate and recalculates the total.</summary>
    private async Task OnPhSelectedChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int phId))
        {
            _selectedPhUserId = phId;
            await FetchPhRates();
            RecalculatePricing();
        }
    }

    /// <summary>VG dropdown onchange handler: re-fetches that VG's package list and recalculates the total.</summary>
    private async Task OnVgSelectedChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int vgId))
        {
            _selectedVgUserId = vgId;
            await FetchVgRates();
            RecalculatePricing();
        }
    }

    /// <summary>
    /// Looks up the selected PH's configured day rate and picks the dangerous-game rate
    /// over the standard rate when any of the booking's requested species (matched by a
    /// hardcoded Afrikaans keyword list: leeu/buffel/olifant/renoster/luiperd/seekoei/
    /// krokodil - the "Big Five" plus hippo/crocodile) is dangerous game. Sets
    /// _phRatesNotConfigured (surfaced as a warning banner) if the PH hasn't set that
    /// rate at all yet.
    /// </summary>
    private async Task FetchPhRates()
    {
        _phTotal = 0m;
        if (_selectedPhUserId > 0 && _activeBooking != null)
        {
            var phRates = await Api.GetPhDailyRatesAsync(_selectedPhUserId);
            if (phRates != null)
            {
                bool hasDangerousGame = _activeBooking.BookedSpecies?.Any(s => s.ToLowerInvariant().Contains("leeu") || s.ToLowerInvariant().Contains("buffel") || s.ToLowerInvariant().Contains("olifant") || s.ToLowerInvariant().Contains("renoster") || s.ToLowerInvariant().Contains("luiperd") || s.ToLowerInvariant().Contains("seekoei") || s.ToLowerInvariant().Contains("krokodil")) ?? false;
                _phIsDangerousGame = hasDangerousGame;
                decimal? selectedRate = hasDangerousGame ? phRates.DangerousGameDailyRate : phRates.StandardDailyRate;
                _phRatesNotConfigured = selectedRate == null;
                _phTotal = (selectedRate ?? 0m) * _expeditionDays;
            }
        }
    }

    /// <summary>Loads the selected VG's service packages and re-picks a default package selection if the current one no longer belongs to this VG (see ApplySelectedVgPackage).</summary>
    private async Task FetchVgRates()
    {
        _vgPackages = _selectedVgUserId > 0 ? (await Api.GetVgPackagesAsync(_selectedVgUserId) ?? new()) : new();

        // Re-pick a default whenever the current selection no longer belongs to this
        // VG's package list (new VG chosen, or first load) - otherwise keep whatever
        // the PJ (or a pre-fill from an existing breakdown) already chose.
        if (!_vgPackages.Any(p => p.Id == _selectedVgPackageId))
            _selectedVgPackageId = _vgPackages.FirstOrDefault()?.Id ?? 0;

        ApplySelectedVgPackage();
    }

    /// <summary>Sets _vgPackageName/_vgTotal from whichever package _selectedVgPackageId currently points to (or clears both if none selected).</summary>
    private void ApplySelectedVgPackage()
    {
        var pkg = _vgPackages.FirstOrDefault(p => p.Id == _selectedVgPackageId);
        _vgPackageName = pkg?.Title ?? string.Empty;
        _vgTotal = pkg != null ? pkg.DailyRate * _expeditionDays : 0m; // vgPackages.Price is a per-day rate - VgPackages.razor labels it "R X / dag"
    }

    private void OnVgPackageSelectedChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int pkgId))
        {
            _selectedVgPackageId = pkgId;
            ApplySelectedVgPackage();
            RecalculatePricing();
        }
    }

