@* Advertiser (AP) "pay for ad" / renewal page at /ap/pay-ad/{AdId}, the second step
   after CreateAd.razor (or reached from the AP dashboard to renew/extend an ad). Requires
   the "AP" or "Admin" role plus ownership of the ad. The WebAPI prices and signs the
   PayFast form (api/payments/checkout, kind "ad"); the ad is only extended when PayFast's
   notification reaches the WebAPI. In Development the WebAPI also offers a simulator.
   Returning here with ?status=success only re-reads the ad. *@
@page "/ap/betaal-advertensie/{AdId:int}"
@page "/ap/pay-ad/{AdId:int}"
@inject MikpuntApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Betalingsimulasie vir Advertensie | MikPunt</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="mp-card text-center p-5">
        <div class="spinner-border text-gold mb-3" role="status"></div>
        <div class="fs-4 text-gold">Verifieer tans toegang...</div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Teken asseblief eers in</h3>
        <p class="text-muted mb-4">Hierdie betalingsportaal is slegs toeganklik vir geregistreerde en aangemelde lede.</p>
        <a href="/teken-in?returnUrl=/ap/paneelbord" class="mp-btn mp-btn-primary">Teken In &rarr;</a>
    </div>
}
else if (!Auth.HasRole("AP") && !Auth.HasRole("Admin"))
{
    <div class="mp-card text-center p-5">
        <div class="mp-brand-logo mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h3 class="brand-font text-gold mb-2">Toegang Beperk: Adverteerder (AP) Rol Benodig</h3>
        <p class="text-muted mb-4 max-w-700 mx-auto" style="max-width: 600px;">
            Slegs geregistreerde adverteerders kan advertensies aktiveer en bestuur.
        </p>
        <a href="/profiel" class="mp-btn mp-btn-primary">+ Aktiveer AP Rol op Profiel &rarr;</a>
    </div>
}
else if (_isUnauthorized)
{
    <div class="mp-card text-center p-5">
        <div class="mp-brand-logo mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h3 class="brand-font text-gold mb-2">Toegang Geweier: Nie U Advertensie Nie</h3>
        <p class="text-muted mb-4 max-w-700 mx-auto" style="max-width: 600px;">
            Hierdie advertensie is gekoppel aan 'n ander adverteerder. U kan slegs betalings simuleer vir advertensies wat aan u eie AP rekening behoort.
        </p>
        <a href="/ap/paneelbord" class="mp-btn mp-btn-primary">&larr; Terug na My Advertensies</a>
    </div>
}
else if (_isLoading)
{
    <div class="mp-card text-center p-5">
        <div class="spinner-border text-gold mb-3" role="status"></div>
        <div class="fs-4 text-gold">Laai tans advertensiebesonderhede...</div>
    </div>
}
else if (_ad == null)
{
    <div class="mp-card text-center p-5">
        <h3 class="brand-font text-gold mb-2">Advertensie Nie Gevind Nie</h3>
        <p class="text-muted mb-4">Die versoekte advertensie kon nie opgespoor word nie.</p>
        <a href="/ap/paneelbord" class="mp-btn mp-btn-primary">&larr; Terug na Bestuur Advertensies</a>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <!-- Breadcrumbs / Top Navigation -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <a href="/ap/paneelbord" class="text-muted small text-decoration-none">&larr; Terug na Advertensieportaal</a>
                    <h1 class="brand-font text-gold mb-0 mt-1">Advertensie Betaling &amp; Aktivering</h1>
                </div>
                <span class="mp-badge mp-badge-warning py-2 px-3">
                    Tarief: R@_adMonthlyPrice.ToString("N0") / maand
                </span>
            </div>

            @if (_awaitingConfirmation && !_paymentCompleted)
            {
                <div class="mp-card p-4 text-center mb-4">
                    <div style="font-size: 40px;">⏳</div>
                    <h3 class="brand-font text-gold mb-2">Betaling word bevestig</h3>
                    <p class="text-muted mb-2">PayFast het u teruggestuur. Die advertensie word verleng sodra PayFast die betaling direk aan ons bevestig.</p>
                    <p class="mb-3">Huidige status: <strong>@MikpuntApiService.GetValidityText(_ad.EndDate, _ad.IsActive, _ad.PaymentStatus)</strong> (geldig tot @_ad.EndDate.ToString("dd MMM yyyy"))</p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <button class="mp-btn mp-btn-secondary" @onclick="RecheckAsync" disabled="@_isProcessing">Kyk weer</button>
                        <a href="/ap/paneelbord" class="mp-btn mp-btn-primary">Gaan na My Advertensies &rarr;</a>
                    </div>
                </div>
            }
            else @if (_paymentCompleted)
            {
                <!-- SUCCESS RECEIPT / CONFIRMATION -->
                <div class="mp-card p-4 p-md-5 text-center mb-4" style="border: 2px solid var(--accent-gold); background: rgba(217, 119, 6, 0.04);">
                    <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>

                    <h2 class="brand-font text-gold mb-2">Betaling Suksesvol!</h2>
                    <p class="text-muted mb-4 fs-5">
                        U advertensie <strong>"@_ad.Title"</strong> is nou amptelik <span class="text-success fw-bold">Aktief</span> en lewendig op MikPunt.
                    </p>

                    <!-- Receipt Summary -->
                    <div class="p-4 rounded border text-start mx-auto mb-4 mp-payment-summary-box" style="max-width: 550px;">
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-muted">Transaksie Verwysing:</span>
                            <strong class="font-monospace text-gold">@_paymentRef</strong>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-muted">Bygevoegde Tydsduur:</span>
                            <span class="fw-bold">+@_selectedMonths @(_selectedMonths == 1 ? "Maand" : "Maande")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-muted">Totale Tydsduur:</span>
                            <span class="fw-bold">@_ad.DurationMonths @(_ad.DurationMonths == 1 ? "Maand" : "Maande")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-muted">Geldig Vanaf:</span>
                            <span>@_ad.StartDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-muted">Verval Datum:</span>
                            <strong class="text-success">@_ad.EndDate.ToString("dd MMMM yyyy")</strong>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                            <span class="text-muted">Maandelikse Tarief:</span>
                            <span>R @_adMonthlyPrice.ToString("N2") / mnd</span>
                        </div>
                        <div class="d-flex justify-content-between pt-3 align-items-center">
                            <span class="fs-5 fw-bold">Bedrag Betaal:</span>
                            <span class="fs-4 text-success fw-bold">R @PayableAmount.ToString("N2") ZAR</span>
                        </div>
                    </div>

                    <!-- Navigation Action Buttons -->
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="/ap/paneelbord" class="mp-btn mp-btn-primary">
                            Gaan na Bestuur Advertensies &rarr;
                        </a>
                        <a href="/ap/paneelbord" class="mp-btn mp-btn-secondary">
                            AP-portaal Oorsig
                        </a>
                        <a href="/advertensies/@_ad.Id" target="_blank" class="mp-btn mp-btn-secondary">
                            Bekyk Lewendige Advertensie ↗
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- SIMULATION FORM & SELECTION -->
                <div class="row g-4">
                    <!-- Left Column: Ad Details & Duration Selector -->
                    <div class="col-md-7">
                        <!-- Ad Preview Card -->
                        <div class="mp-card p-3 mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="mp-badge mp-badge-warning">@MikpuntApiService.FormatCategory(_ad.Category)</span>
                                <span class="badge @MikpuntApiService.GetValidityBadgeClass(_ad.EndDate, _ad.IsActive, _ad.PaymentStatus)">
                                    @MikpuntApiService.GetValidityText(_ad.EndDate, _ad.IsActive, _ad.PaymentStatus)
                                </span>
                            </div>
                            <h3 class="brand-font text-gold mb-2">@_ad.Title</h3>
                            <p class="text-muted small mb-3">@_ad.Description</p>

                            @if (!string.IsNullOrEmpty(_ad.ImageUrl))
                            {
                                <div style="height: 140px; border-radius: 8px; overflow: hidden;" class="mb-2">
                                    <img src="@_ad.ImageUrl" alt="@_ad.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                            }

                            <div class="d-flex justify-content-between small text-muted pt-2 border-top border-secondary">
                                <span>Borg: <strong>@_ad.AdvertiserName</strong></span>
                                <span>Geldig tot: <strong>@_ad.EndDate.ToString("dd MMM yyyy")</strong></span>
                            </div>
                        </div>

                        <!-- Step 1: Select Duration -->
                        <div class="mp-card p-4 mb-4">
                            <h4 class="brand-font text-gold mb-1" style="font-size: 18px;">
                                @(_ad.IsActive && _ad.EndDate >= DateTime.Today ? "1. Kies Verlenging Tydsduur (Maande)" : "1. Kies Advertering Tydsduur (Maande)")
                            </h4>
                            <p class="text-muted small mb-3">
                                @if (_ad.IsActive && _ad.EndDate >= DateTime.Today)
                                {
                                    <span>Hierdie advertensie is reeds aktief tot <strong>@_ad.EndDate.ToString("dd MMM yyyy")</strong>. Kies hoeveel maande u wil byvoeg teen <strong>R@_adMonthlyPrice.ToString("N0") / maand</strong>.</span>
                                }
                                else
                                {
                                    <span>Kies vir hoeveel maande hierdie advertensie aktief op MikPunt moet bly teen <strong>R@_adMonthlyPrice.ToString("N0") / maand</strong>.</span>
                                }
                            </p>

                            <!-- Duration Selection Buttons / Pills -->
                            <div class="row g-2 mb-3">
                                @foreach (var months in _presetMonths)
                                {
                                    decimal p = GetPriceForMonths(months);
                                    decimal d = months switch { >= 12 => 20m, >= 6 => 10m, >= 3 => 5m, _ => 0m };
                                    <div class="col-6 col-sm-4">
                                        <div class="mp-duration-pill @(_selectedMonths == months ? "active" : "")"
                                             @onclick="() => SelectMonthsAsync(months)">
                                            <div class="fs-5">+@months @(months == 1 ? "Maand" : "Maande")</div>
                                            <div class="small pill-price">
                                                R @p.ToString("N0")
                                                @if (d > 0)
                                                {
                                                    <span class="badge bg-success ms-1" style="font-size: 10px;">-@d%</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Custom Months Input -->
                            <div class="mp-form-group mb-0">
                                <label class="mp-form-label small">Of kies 'n pasgemaakte aantal maande:</label>
                                <div class="input-group">
                                    <input type="number" 
                                           class="mp-form-control" 
                                           min="1" 
                                           max="36" 
                                           value="@_selectedMonths" 
                                           @onchange="HandleCustomMonthsChanged" />
                                    <span class="input-group-text mp-input-group-addon">maande (@TotalAmount.ToString("C0") ZAR)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Simulated Payment Card -->
                    <div class="col-md-5">
                        <div class="mp-card p-4 sticky-top" style="top: 20px; border: 1px solid var(--border-color);">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="brand-font text-gold mb-0" style="font-size: 18px;">2. Betaling</h4>
                                <span class="badge bg-secondary text-light">PayFast</span>
                            </div>

                            <!-- Cost Breakdown -->
                            <div class="mp-payment-summary-box mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Advertering Tarief:</span>
                                    <span>R @_adMonthlyPrice.ToString("N2") / maand</span>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Gekoopte Tydsduur:</span>
                                    <span class="text-gold fw-bold">+@_selectedMonths @(_selectedMonths == 1 ? "maand" : "maande")</span>
                                </div>
                                @if (DiscountPercentage > 0)
                                {
                                    <div class="d-flex justify-content-between small text-success mb-1">
                                        <span>Pakketafslag (@DiscountPercentage%):</span>
                                        <span>- R @DiscountAmount.ToString("N2")</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between small text-muted mb-2">
                                    <span>Nuwe Verval Datum:</span>
                                    <strong class="text-success">@CalculatedNewExpiryDate.ToString("dd MMMM yyyy")</strong>
                                </div>
                                <div class="d-flex justify-content-between pt-2 border-top border-secondary align-items-center">
                                    <strong class="text-gold">Totale Koste:</strong>
                                    <strong class="fs-4 text-success">R @PayableAmount.ToString("N2")</strong>
                                </div>
                            </div>

                            @if (_checkoutError != null)
                            {
                                <div class="alert alert-danger py-2 px-3 small mb-3">@_checkoutError</div>
                            }
                            @if (_checkout == null)
                            {
                                @if (_checkoutError == null)
                                {
                                    <div class="text-center text-muted p-3"><span class="spinner-border spinner-border-sm me-2"></span>Berei betaling voor...</div>
                                }
                            }
                            else
                            {
                                <p class="small text-muted mb-3">U gaan na PayFast om met kaart of EFT te betaal. Die advertensie word verleng sodra PayFast die betaling aan ons bevestig.</p>
                                <!-- PayFast form: every field (amount included) and the signature come from the WebAPI -->
                                <form action="@_checkout.ProcessUrl" method="post">
                                    @foreach (var field in _checkout.Fields)
                                    {
                                        <input type="hidden" name="@field.Name" value="@field.Value" />
                                    }
                                    <button type="submit" class="mp-btn mp-btn-primary w-100 py-3 mb-2" disabled="@_isProcessing">
                                        @if (_ad.IsActive && _ad.EndDate >= DateTime.Today)
                                        {
                                            <span>💳 Verleng &amp; Betaal R @_checkout.Amount.ToString("N2") met PayFast</span>
                                        }
                                        else
                                        {
                                            <span>💳 Betaal &amp; Aktiveer R @_checkout.Amount.ToString("N2") met PayFast</span>
                                        }
                                    </button>
                                </form>

                                @if (_checkout.SimulatorAvailable)
                                {
                                    <!-- Development only: the WebAPI credits the payment itself, at its own price -->
                                    <button type="button" class="mp-btn mp-btn-secondary w-100 py-2 mb-2" disabled="@_isProcessing" @onclick="HandleSimulatePayment">
                                        @if (_isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Besig om betaling te verwerk...</span>
                                        }
                                        else
                                        {
                                            <span>⚡ Simuleer betaling (slegs Development)</span>
                                        }
                                    </button>
                                }
                            }

                            <div class="text-center mt-3">
                                <a href="/ap/paneelbord" class="text-muted small text-decoration-none">Kanselleer en betaal later</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int AdId { get; set; }

    private AdvertisementModel? _ad;
    private bool _isLoading = true;
    private int _selectedMonths = 1;
    private readonly int[] _presetMonths = new[] { 1, 2, 3, 6, 12 };
    private decimal _adMonthlyPrice = 100m; // overwritten from admin-configurable settings in OnInitializedAsync

    // Prepay discount tiers are a promotional structure, not part of the admin-price
    // ask - kept as a literal, but de-duplicated into one place (was written out 3x).
    private static decimal DiscountPercentageForMonths(int months) => months switch
    {
        >= 12 => 20m,
        >= 6 => 10m,
        >= 3 => 5m,
        _ => 0m
    };

    private decimal DiscountPercentage => DiscountPercentageForMonths(_selectedMonths);
    private decimal BaseAmount => _selectedMonths * _adMonthlyPrice;
    private decimal DiscountAmount => BaseAmount * (DiscountPercentage / 100m);
    private decimal TotalAmount => BaseAmount - DiscountAmount;

    /// <summary>Discounted total price for a preset duration pill, independent of the currently-selected months.</summary>
    private decimal GetPriceForMonths(int months)
    {
        decimal disc = DiscountPercentageForMonths(months);
        decimal baseAmt = months * _adMonthlyPrice;
        return baseAmt - (baseAmt * (disc / 100m));
    }

    /// <summary>New expiry date after this payment: extends from the ad's current EndDate if it's still active/unexpired, otherwise starts fresh from today (covers both "renew early" and "reactivate after lapse").</summary>
    private DateTime CalculatedNewExpiryDate
    {
        get
        {
            if (_ad != null && _ad.IsActive && _ad.EndDate >= DateTime.Today)
            {
                return _ad.EndDate.AddMonths(_selectedMonths);
            }
            return DateTime.Today.AddMonths(_selectedMonths);
        }
    }

    private bool _isProcessing = false;
    private bool _paymentCompleted = false;
    private string _paymentRef = string.Empty;

    private bool _isUnauthorized = false;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += HandleAuthChanged;
        _adMonthlyPrice = (await Api.GetPublicSettingsAsync()).AdMonthlyPrice;
        await LoadDataAsync();
    }

    /// <summary>Re-loads the ad when auth state changes (e.g. login completes after this page already rendered its "please sign in" state).</summary>
    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= HandleAuthChanged;
    }

    /// <summary>
    /// Fetches the ad, enforces ownership (non-Admins may only pay for their own ad),
    /// and pre-selects a duration: 1 month if renewing an already-active ad, or the
    /// ad's last DurationMonths if reactivating a lapsed/never-activated one.
    /// </summary>
    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _ad = await Api.GetAdByIdAsync(AdId);
        if (_ad != null)
        {
            if (!Auth.HasRole("Admin") && (_ad.AdvertiserUserId <= 0 || _ad.AdvertiserUserId != Auth.CurrentUser?.UserId))
            {
                _isUnauthorized = true;
                _isLoading = false;
                return;
            }
            _isUnauthorized = false;

            if (_ad.IsActive && _ad.EndDate >= DateTime.Today)
            {
                _selectedMonths = 1;
            }
            else if (_ad.DurationMonths > 0)
            {
                _selectedMonths = Math.Clamp(_ad.DurationMonths, 1, 36);
            }
        }
        _isLoading = false;
        await LoadCheckoutAsync();
    }

    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }

    private PaymentCheckoutModel? _checkout;
    private string? _checkoutError;
    private bool _awaitingConfirmation;

    /// <summary>What will actually be charged: the server's price once loaded, the published tier price until then.</summary>
    private decimal PayableAmount => _checkout?.Amount ?? TotalAmount;

    /// <summary>Loads the server-priced, signed PayFast form for the selected months (or, after a PayFast return, re-reads the ad instead).</summary>
    private async Task LoadCheckoutAsync()
    {
        if (_ad == null || _isUnauthorized) return;
        if (string.Equals(Status, "success", StringComparison.OrdinalIgnoreCase) && !_paymentCompleted)
        {
            _awaitingConfirmation = true;
            return;
        }
        _checkout = null;
        _checkoutError = null;
        var baseUri = Nav.BaseUri.TrimEnd('/');
        var (checkout, error, _) = await Api.CreatePaymentCheckoutAsync("ad", _ad.Id, null, _selectedMonths,
            $"{baseUri}/ap/betaal-advertensie/{_ad.Id}?status=success", $"{baseUri}/ap/paneelbord");
        _checkout = checkout;
        _checkoutError = checkout == null ? error : null;
    }

    /// <summary>Re-reads the ad after a PayFast return.</summary>
    private async Task RecheckAsync()
    {
        _isProcessing = true;
        Api.InvalidateAdsCache();
        _ad = await Api.GetAdByIdAsync(AdId);
        _isProcessing = false;
    }

    /// <summary>Selects a preset duration pill and fetches that term's price.</summary>
    private async Task SelectMonthsAsync(int months)
    {
        _selectedMonths = Math.Clamp(months, 1, 36);
        await LoadCheckoutAsync();
    }

    /// <summary>Handles the custom-months number input, clamped to [1, 36] (falls back to 1 on invalid/empty input).</summary>
    private async Task HandleCustomMonthsChanged(ChangeEventArgs e)
    {
        _selectedMonths = int.TryParse(e.Value?.ToString(), out int val) && val >= 1 ? Math.Min(36, val) : 1;
        await LoadCheckoutAsync();
    }

    /// <summary>Development only (shown only when the WebAPI offers it): the WebAPI credits the payment at its own price, then the ad is re-read for the receipt.</summary>
    private async Task HandleSimulatePayment()
    {
        if (_ad == null) return;
        _isProcessing = true;
        _checkoutError = null;

        var (success, _, reference, error) = await Api.SimulatePaymentAsync("ad", _ad.Id, null, _selectedMonths);
        if (success)
        {
            _paymentRef = reference ?? string.Empty;
            _ad = await Api.GetAdByIdAsync(AdId);
            _paymentCompleted = true;
        }
        else
        {
            _checkoutError = error;
        }
        _isProcessing = false;
    }
}
