<!DOCTYPE html>
<html lang="af">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>MikPunt | Suid-Afrikaanse Jag, Plaas & Ekotoerisme Bestuursplatform</title>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="WebApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <HeadOutlet @rendermode="InteractiveServer" />
    <script>
        window.themeCookie = {
            set: function (name, value, days) {
                var expires = "";
                if (days) {
                    var date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = "; expires=" + date.toUTCString();
                }
                document.cookie = name + "=" + (value || "") + expires + "; path=/; SameSite=Lax";
            },
            get: function (name) {
                var nameEQ = name + "=";
                var ca = document.cookie.split(';');
                for (var i = 0; i < ca.length; i++) {
                    var c = ca[i];
                    while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                    if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                }
                return null;
            }
        };

        window.mikpuntAuthStorage = {
            // remember = true ("Onthou my"): localStorage + 7-day cookies, survives closing the
            // browser. remember = false: sessionStorage + session cookies, gone when it closes.
            saveUser: function (userJson, userId, token, remember) {
                if (remember === undefined || remember === null) remember = true;
                try {
                    var keep = remember ? localStorage : sessionStorage;
                    var drop = remember ? sessionStorage : localStorage;
                    keep.setItem('mikpunt_auth_session', userJson);
                    drop.removeItem('mikpunt_auth_session');
                } catch (e) { console.error('session storage save error', e); }
                try {
                    if (userId) {
                        var expires = "";
                        if (remember) {
                            var date = new Date();
                            date.setTime(date.getTime() + (7 * 24 * 60 * 60 * 1000));
                            expires = "; expires=" + date.toUTCString();
                        }
                        document.cookie = "mikpunt_uid=" + userId + expires + "; path=/; SameSite=Lax";
                        document.cookie = "mikpunt_token=" + encodeURIComponent(token || "") + expires + "; path=/; SameSite=Lax";
                    }
                } catch (e) {}
            },
            getUser: function () {
                try {
                    var val = localStorage.getItem('mikpunt_auth_session') || sessionStorage.getItem('mikpunt_auth_session');
                    if (val && val.length > 5) return val;
                } catch (e) { console.error('session storage get error', e); }
                return null;
            },
            isRemembered: function () {
                try { return !!localStorage.getItem('mikpunt_auth_session'); } catch (e) { return true; }
            },
            clearUser: function () {
                try {
                    localStorage.removeItem('mikpunt_auth_session');
                    sessionStorage.removeItem('mikpunt_auth_session');
                } catch (e) {}
                try {
                    document.cookie = "mikpunt_uid=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=Lax";
                    document.cookie = "mikpunt_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=Lax";
                } catch (e) {}
            }
        };

        window.mikpuntPrintHtml = function(htmlContent) {
            var printWin = window.open('', '_blank', 'width=850,height=1100');
            printWin.document.write(htmlContent);
            printWin.document.close();
            printWin.focus();
            setTimeout(function() {
                printWin.print();
            }, 500);
        };

        window.mikpuntChat = {
            scrollToBottom: function(selector) {
                setTimeout(function() {
                    var el = document.querySelector(selector || '.chat-scroll-area');
                    if (el) {
                        el.scrollTop = el.scrollHeight;
                    }
                }, 50);
            }
        };
    </script>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.mikpuntDownloadPdf = function(filename, base64) {
            var link = document.createElement('a');
            link.download = filename;
            link.href = 'data:application/pdf;base64,' + base64;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.mikpuntViewFile = function(dataUrl) {
            // Browsers block top-level navigation to data: URLs triggered by a link
            // click (anti-phishing measure) - convert to a blob: URL first, which
            // is allowed, so "view in new tab" actually opens something.
            fetch(dataUrl)
                .then(function (res) { return res.blob(); })
                .then(function (blob) {
                    var url = URL.createObjectURL(blob);
                    var win = window.open(url, '_blank');
                    if (!win) {
                        window.location.href = url;
                    }
                    setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
                })
                .catch(function (err) {
                    console.error('Kon nie dokument oopmaak nie', err);
                    alert('Kon nie dokument oopmaak nie.');
                });
        };

        // Turns a private file streamed from the server (DotNetStreamReference) into a
        // blob: URL the page can show in an <img>/<video> without exposing any API token.
        window.mikpuntBlobUrl = async function(streamRef, mimeType) {
            var buffer = await streamRef.arrayBuffer();
            return URL.createObjectURL(new Blob([buffer], { type: mimeType }));
        };

        // A data: URL (stored documents) as a blob: URL the page may show in an <iframe>/<img>.
        window.mikpuntDataUrlToBlobUrl = async function(dataUrl) {
            var res = await fetch(dataUrl);
            return URL.createObjectURL(await res.blob());
        };

        window.mikpuntRevokeBlobUrl = function(url) {
            if (url) { URL.revokeObjectURL(url); }
        };

        window.mikpuntDownloadFile = function(filename, mimeType, base64) {
            var link = document.createElement('a');
            link.download = filename;
            link.href = 'data:' + mimeType + ';base64,' + base64;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };
    </script>
</body>

</html>
